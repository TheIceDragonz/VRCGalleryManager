@using VRCGalleryManager.Core
@inject NotificationService NotifService
@implements IDisposable

<div class="notification-container">
    @foreach (var notification in NotifService.Notifications)
    {
        var borderClass = GetBorderClass(notification.Type);
        var exitClass = notification.IsLeaving ? "slide-out" : "slide-in";
        
        <div class="notification-panel @borderClass @exitClass" @key="notification.Id" @onclick="() => NotifService.BeginDismiss(notification)">
            <h4 class="notification-title">@notification.Title</h4>
            <p class="notification-message">@notification.Message</p>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        NotifService.OnChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotifService.OnChanged -= OnNotificationsChanged;
    }

    private string GetBorderClass(NotificationType type)
    {
        return type switch
        {
            NotificationType.Success => "notification-success",
            NotificationType.Info => "notification-info",
            NotificationType.Error => "notification-error",
            _ => "notification-error"
        };
    }
}
