@inherits LayoutComponentBase
@using VRCGalleryManager.Core
@implements IDisposable

<div class="page main-page-container @(Microsoft.Maui.Devices.DeviceInfo.Current.Platform == Microsoft.Maui.Devices.DevicePlatform.Android ? "android-layout" : "")">
    <div class="sidebar main-sidebar-container">
        <NavMenu />
    </div>

    <main class="main-content-container d-flex flex-column">
        @if (!IsOnline)
        {
            <div class="offline-banner d-flex align-items-center justify-content-between px-3 py-2 bg-danger text-white shadow-sm" style="z-index: 1050; font-size: 0.9rem; animation: slideDown 0.3s ease;">
                <div class="d-flex align-items-center gap-2">
                    <img src="/svg/wifi-off-svgrepo-com.svg" class="icon-white" style="width: 18px; height: 18px;" alt="Offline" />
                    <span><strong>You are offline</strong> &mdash; No internet connection. Some features may not be available.</span>
                </div>
                <button class="btn btn-sm btn-outline-light d-flex align-items-center gap-1 py-0 px-2" @onclick="CheckConnectivity" disabled="@isCheckingConnection">
                    @if (isCheckingConnection)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="icon-white" style="width: 14px; height: 14px;" />
                    }
                    <span>Retry</span>
                </button>
            </div>
        }

        <article class="content w-100 flex-grow-1 p-0 m-0 main-article overflow-hidden">
            @Body
        </article>
    </main>

    <NotificationDisplay />
    <DialogDisplay />
</div>

@code {
    [Inject] private UpdateManager Updater { get; set; } = default!;
    [Inject] private NotificationService Notifications { get; set; } = default!;
    [Inject] private DialogService Dialogs { get; set; } = default!;
    [Inject] private NetworkStatusService NetworkStatus { get; set; } = default!;

    private bool IsOnline => NetworkStatus.IsOnline;
    private bool isCheckingConnection = false;

    protected override void OnInitialized()
    {
        NetworkStatus.OnNetworkStatusChanged += HandleNetworkStatusChanged;
    }

    private void HandleNetworkStatusChanged(bool isOnline)
    {
        InvokeAsync(() =>
        {
            if (isOnline)
            {
                Notifications.Show("Internet connection restored.", "Online", NotificationType.Success, 3500);
            }
            StateHasChanged();
        });
    }

    private async Task CheckConnectivity()
    {
        isCheckingConnection = true;
        StateHasChanged();
        await Task.Delay(300);
        bool online = await NetworkStatus.CheckConnectionAsync();
        isCheckingConnection = false;
        if (!online)
        {
            Notifications.Show("Still offline. Please check your network connection.", "No Connection", NotificationType.Error, 3000);
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (OperatingSystem.IsWindows())
                {
                    var updateCheck = await Updater.IsUpdateAvailableAsync();
                    if (updateCheck.isAvailable)
                    {
                        Notifications.Show("A new update is available! You can download it from Settings.", "Update Available", VRCGalleryManager.Core.NotificationType.Info, 8000);
                    }
                }
            }
            catch (Exception) { }
        }
    }

    public void Dispose()
    {
        NetworkStatus.OnNetworkStatusChanged -= HandleNetworkStatusChanged;
    }
}