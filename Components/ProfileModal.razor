@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.Api.Models
@inject VRCAuth Auth
@inject ProfileBackgroundService BackgroundService
@inject NotificationService Notifications
@inject IJSRuntime JS
@implements IDisposable

@if (IsOpen && CurrentUser != null)
{
    var bannerUrl = !string.IsNullOrEmpty(CurrentUser.ProfilePicOverrideThumbnail)
        ? CurrentUser.ProfilePicOverrideThumbnail
        : (!string.IsNullOrEmpty(CurrentUser.BannerUrl)
            ? CurrentUser.BannerUrl
            : (!string.IsNullOrEmpty(CurrentUser.ProfilePicOverride)
                ? CurrentUser.ProfilePicOverride
                : CurrentUser.CurrentAvatarThumbnailImageUrl));

    var avatarUrl = !string.IsNullOrEmpty(CurrentUser.UserIcon)
        ? CurrentUser.UserIcon
        : (!string.IsNullOrEmpty(CurrentUser.IconUrl)
            ? CurrentUser.IconUrl
            : CurrentUser.CurrentAvatarThumbnailImageUrl);

    var pronouns = !string.IsNullOrWhiteSpace(CurrentUser.Pronouns)
        ? CurrentUser.Pronouns
        : PublicProfile?.Pronouns;

    var bio = !string.IsNullOrWhiteSpace(CurrentUser.Bio)
        ? CurrentUser.Bio
        : PublicProfile?.Bio;

    var bioLinks = (CurrentUser.BioLinks != null && CurrentUser.BioLinks.Count > 0)
        ? CurrentUser.BioLinks
        : PublicProfile?.BioLinks;

    var badges = (CurrentUser.Badges != null && CurrentUser.Badges.Count > 0)
        ? CurrentUser.Badges
        : (PublicProfile?.Badges != null ? PublicProfile.Badges : new List<Badge>());

    bool hasVrcPlus = VRCAuth.CheckHasVRCPlus(CurrentUser) || (PublicProfile?.HasVrcPlus == true);
    string statusColor = GetStatusColor(CurrentUser.Status);
    string statusText = GetStatusLabel(CurrentUser.Status);

    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center profile-modal-overlay"
         style="z-index: 10005;"
         @onclick="Close"
         @onkeydown="HandleKeyDown"
         tabindex="0"
         @ref="overlayRef">
        
        <div class="dialog-panel d-flex flex-column profile-dialog-panel"
             @onclick:stopPropagation="true">
            
            <!-- Banner / Cover Area -->
            <div class="profile-modal-banner-container position-relative">
                @if (!string.IsNullOrEmpty(bannerUrl))
                {
                    <img src="@bannerUrl" class="profile-modal-banner-img" alt="Profile Banner" />
                }
                else
                {
                    <div class="profile-modal-banner-placeholder"></div>
                }

                @if (BackgroundService.DisplayVRCCosmetics && !string.IsNullOrEmpty(ProfileEffectUrl))
                {
                    <img src="@ProfileEffectUrl" class="profile-modal-banner-effect" alt="Profile Effect" />
                }

                <div class="profile-modal-banner-gradient"></div>

                <!-- Sole Close Button on Banner -->
                <div class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <button class="btn-viewer-info-close profile-modal-close-btn" @onclick="Close" title="Close">
                        <img src="/svg/close-bold-svgrepo-com.svg" class="icon-white" style="width: 12px; height: 12px;" />
                    </button>
                </div>
            </div>

            <!-- Profile Info Header (Avatar & Identity) -->
            <div class="profile-modal-header px-4 pb-2 position-relative">
                <div class="d-flex align-items-end justify-content-between profile-modal-avatar-row">
                    <!-- Avatar with Icon Frame & Status Dot -->
                    <div class="position-relative profile-modal-avatar-wrapper flex-shrink-0">
                        <img src="@(string.IsNullOrEmpty(avatarUrl) ? "/svg/profile-user-svgrepo-com.svg" : avatarUrl)"
                             class="profile-modal-avatar"
                             alt="@CurrentUser.DisplayName" />

                        @if (BackgroundService.DisplayVRCCosmetics && !string.IsNullOrEmpty(IconFrameUrl))
                        {
                            <img src="@IconFrameUrl" class="profile-modal-icon-frame" alt="Icon Frame" />
                        }

                        <div class="profile-modal-status-dot" style="background-color: @statusColor;" title="Status: @statusText"></div>
                    </div>

                    <!-- Actions in Header: Copy Link & Open in Browser -->
                    <div class="d-flex align-items-center gap-2 profile-modal-top-actions">
                        <button class="btn btn-sm profile-action-btn d-flex align-items-center gap-2"
                                @onclick="CopyProfileLink"
                                title="Copy Profile Link">
                            <img src="/svg/link-svgrepo-com.svg" class="icon-white" style="width: 13px; height: 13px; opacity: 0.85;" />
                            <span>Copy Link</span>
                        </button>
                        <button class="btn btn-sm profile-action-btn d-flex align-items-center gap-2"
                                @onclick="OpenProfileInBrowser"
                                title="Open in Browser">
                            <img src="/svg/world-svgrepo-com.svg" class="icon-white" style="width: 13px; height: 13px; opacity: 0.85;" />
                            <span>Open in Browser</span>
                        </button>
                    </div>
                </div>

                <div class="mt-3 min-w-0">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h4 class="fw-bold text-white mb-0 profile-modal-display-name text-truncate">@CurrentUser.DisplayName</h4>
                        
                        @if (CurrentUser.IsEconomyCreator || PublicProfile?.IsEconomyCreator == true)
                        {
                            <img src="/svg/verify-svgrepo-com.svg"
                                 class="settings-account-verified-badge"
                                 title="Economy Creator"
                                 alt="Economy Creator" />
                        }

                        @if (!string.IsNullOrWhiteSpace(pronouns))
                        {
                            <span class="settings-account-pronouns profile-modal-pronouns text-truncate">@pronouns</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(CurrentUser.Username) && !string.Equals(CurrentUser.Username, CurrentUser.DisplayName, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="text-muted small profile-modal-username text-truncate">@@@CurrentUser.Username</div>
                    }

                    <!-- Pills / Badges row -->
                    <div class="d-flex align-items-center gap-1 flex-wrap mt-2">
                        <div class="settings-pill @CurrentUser.TrustClass" title="Trust Rank: @CurrentUser.TrustLevel">
                            <span>@CurrentUser.TrustLevel</span>
                        </div>

                        @if (hasVrcPlus)
                        {
                            <div class="settings-pill pill-vrcplus" title="VRChat Plus Subscriber">
                                <span>VRChat Plus</span>
                            </div>
                        }

                        @if (CurrentUser.AgeVerified || CurrentUser.AgeVerificationStatus == "18+")
                        {
                            <div class="settings-pill pill-age-verified" title="Age Verified (@(CurrentUser.AgeVerificationStatus ?? "18+"))">
                                <span>@(CurrentUser.AgeVerificationStatus ?? "18+") Verified</span>
                            </div>
                        }

                        @if (CurrentUser.Languages != null && CurrentUser.Languages.Any())
                        {
                            @foreach (var lang in CurrentUser.Languages)
                            {
                                <div class="settings-pill pill-language" title="Language: @lang.DisplayName">
                                    <span>@lang.Code</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Scrollable Body Details -->
            <div class="profile-modal-body px-4 pt-2 pb-4 flex-grow-1 overflow-y-auto d-flex flex-column gap-3">
                
                <!-- Status Description / Message -->
                @if (!string.IsNullOrWhiteSpace(CurrentUser.StatusDescription) || !string.IsNullOrWhiteSpace(PublicProfile?.StatusDescription))
                {
                    var statusDesc = !string.IsNullOrWhiteSpace(CurrentUser.StatusDescription) ? CurrentUser.StatusDescription : PublicProfile?.StatusDescription;
                    <div class="profile-modal-status-card p-3 d-flex align-items-start gap-2">
                        <img src="/svg/write-f-svgrepo-com.svg" class="icon-accent flex-shrink-0 mt-1" style="width: 14px; height: 14px;" />
                        <div class="profile-modal-status-text min-w-0">
                            <em>"@statusDesc"</em>
                        </div>
                    </div>
                }

                <!-- Biography Section -->
                @if (!string.IsNullOrWhiteSpace(bio))
                {
                    <div class="profile-modal-section">
                        <div class="profile-modal-section-title d-flex align-items-center gap-2 mb-2">
                            <img src="/svg/info-circle-svgrepo-com.svg" class="icon-muted" style="width: 13px; height: 13px;" />
                            <span>Biography</span>
                        </div>
                        <div class="profile-modal-bio-content p-3">
                            <p class="mb-0 text-light profile-modal-bio-text">@bio</p>
                        </div>
                    </div>
                }

                <!-- Links Section (Friendly Names) -->
                @if (bioLinks != null && bioLinks.Count > 0)
                {
                    <div class="profile-modal-section">
                        <div class="profile-modal-section-title d-flex align-items-center gap-2 mb-2">
                            <img src="/svg/link-svgrepo-com.svg" class="icon-muted" style="width: 13px; height: 13px;" />
                            <span>Links</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var link in bioLinks.Where(l => !string.IsNullOrWhiteSpace(l)))
                            {
                                var cleanUrl = link.Trim();
                                var friendlyTitle = FormatLinkTitle(cleanUrl);
                                <button class="btn btn-sm profile-bio-link-pill d-flex align-items-center gap-2"
                                        @onclick="() => OpenExternalUrl(cleanUrl)"
                                        title="@cleanUrl">
                                    <img src="/svg/link-svgrepo-com.svg" class="icon-white profile-link-icon" style="width: 12px; height: 12px;" />
                                    <span class="text-truncate">@friendlyTitle</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- VRChat Badges Section -->
                @if (badges != null && badges.Count > 0)
                {
                    <div class="profile-modal-section">
                        <div class="profile-modal-section-title d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <img src="/svg/verify-svgrepo-com.svg" class="icon-muted" style="width: 13px; height: 13px;" />
                                <span>VRChat Badges</span>
                            </div>
                            <span class="viewer-count-badge profile-counter-capsule">@badges.Count</span>
                        </div>
                        <div class="profile-modal-badges-grid p-2">
                            @foreach (var badge in badges)
                            {
                                <div class="profile-modal-badge-card d-flex align-items-center gap-2 p-2 @(badge.Showcased ? "is-showcased" : "")"
                                     title="@(!string.IsNullOrEmpty(badge.BadgeDescription) ? $"{badge.BadgeName}: {badge.BadgeDescription}" : badge.BadgeName)">
                                    <img src="@badge.BadgeImageUrl" class="profile-modal-badge-icon flex-shrink-0" alt="@badge.BadgeName" />
                                    <div class="min-w-0 flex-grow-1 overflow-hidden">
                                        <div class="fw-bold text-white small text-truncate">@badge.BadgeName</div>
                                        @if (!string.IsNullOrEmpty(badge.BadgeDescription))
                                        {
                                            <div class="text-muted profile-badge-desc" title="@badge.BadgeDescription">@badge.BadgeDescription</div>
                                        }
                                    </div>
                                    @if (badge.Showcased)
                                    {
                                        <span class="profile-badge-star flex-shrink-0" title="Showcased Badge">★</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Active Avatar Preview -->
                @if (!string.IsNullOrEmpty(PublicProfile?.CurrentAvatarName))
                {
                    <div class="profile-modal-section">
                        <div class="profile-modal-section-title d-flex align-items-center gap-2 mb-2">
                            <img src="/svg/camera-svgrepo-com.svg" class="icon-muted" style="width: 13px; height: 13px;" />
                            <span>Active Avatar</span>
                        </div>
                        <div class="profile-modal-avatar-card p-3 d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(PublicProfile.CurrentAvatarThumbnailImageUrl))
                            {
                                <img src="@PublicProfile.CurrentAvatarThumbnailImageUrl" class="profile-modal-active-avatar-img flex-shrink-0" alt="Avatar" />
                            }
                            <div class="min-w-0 flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-white text-truncate">@PublicProfile.CurrentAvatarName</div>
                                @if (!string.IsNullOrEmpty(PublicProfile.CurrentAvatarAuthorName))
                                {
                                    <div class="text-muted small text-truncate">Created by: @PublicProfile.CurrentAvatarAuthorName</div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
}

@code {
    private bool IsOpen = false;
    private CurrentUser? CurrentUser;
    private VRChatPublicProfile? PublicProfile;
    private string? ProfileEffectUrl;
    private string? IconFrameUrl;
    private ElementReference overlayRef;

    protected override void OnInitialized()
    {
        AppEvents.RequestOpenProfileModal += HandleOpenProfileModal;
    }

    private async void HandleOpenProfileModal()
    {
        CurrentUser = Auth.CurrentUser;
        if (CurrentUser == null || string.IsNullOrEmpty(CurrentUser.Id))
        {
            Notifications.Show("Please log in to view your profile.", "Profile", NotificationType.Info);
            return;
        }

        IsOpen = true;
        ProfileEffectUrl = BackgroundService.CachedProfileEffectUrl;
        IconFrameUrl = BackgroundService.CachedIconFrameUrl;

        await InvokeAsync(StateHasChanged);

        try
        {
            PublicProfile = await BackgroundService.GetPublicProfileAsync(CurrentUser.Id);
            ProfileEffectUrl = BackgroundService.CachedProfileEffectUrl;
            IconFrameUrl = BackgroundService.CachedIconFrameUrl;

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private async Task CopyProfileLink()
    {
        if (CurrentUser == null || string.IsNullOrEmpty(CurrentUser.Id)) return;
        var url = $"https://vrchat.com/home/user/{CurrentUser.Id}";
        await CopyTextToClipboard(url, "Profile link copied to clipboard!");
    }

    private async Task OpenProfileInBrowser()
    {
        if (CurrentUser == null || string.IsNullOrEmpty(CurrentUser.Id)) return;
        var url = $"https://vrchat.com/home/user/{CurrentUser.Id}";
        await OpenExternalUrl(url);
    }

    private async Task CopyTextToClipboard(string text, string successMessage)
    {
        try
        {
            bool success = await JS.InvokeAsync<bool>("clipboardInterop.writeText", text);
            if (!success)
            {
                await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
            }
            Notifications.Show(successMessage, "Copied", NotificationType.Success, 2500);
        }
        catch
        {
            try
            {
                await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
                Notifications.Show(successMessage, "Copied", NotificationType.Success, 2500);
            }
            catch (Exception ex)
            {
                Notifications.Show($"Copy failed: {ex.Message}", "Error", NotificationType.Error);
            }
        }
    }

    private async Task OpenExternalUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        try
        {
            if (!url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
                !url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                url = "https://" + url;
            }

            await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri(url));
        }
        catch
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = url,
                    UseShellExecute = true
                });
            }
            catch (Exception ex)
            {
                Notifications.Show($"Could not open URL: {ex.Message}", "Browser Error", NotificationType.Error);
            }
        }
    }

    private static string FormatLinkTitle(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "Link";
        try
        {
            var raw = url.Trim();
            if (!raw.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
                !raw.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                raw = "https://" + raw;
            }

            var uri = new Uri(raw);
            var host = uri.Host.ToLowerInvariant();
            if (host.StartsWith("www.")) host = host.Substring(4);

            if (host.Contains("gumroad.com")) return "Gumroad";
            if (host.Contains("instagram.com")) return "Instagram";
            if (host.Contains("twitter.com") || host == "x.com") return "X (Twitter)";
            if (host.Contains("youtube.com") || host == "youtu.be") return "YouTube";
            if (host.Contains("twitch.tv")) return "Twitch";
            if (host.Contains("discord.gg") || host.Contains("discord.com")) return "Discord";
            if (host.Contains("booth.pm")) return "Booth";
            if (host.Contains("github.com")) return "GitHub";
            if (host.Contains("patreon.com")) return "Patreon";
            if (host.Contains("ko-fi.com")) return "Ko-fi";
            if (host.Contains("vrcmods.com")) return "VRCMods";
            if (host.Contains("vrchat.com")) return "VRChat";
            if (host.Contains("tiktok.com")) return "TikTok";
            if (host.Contains("reddit.com")) return "Reddit";
            if (host.Contains("spotify.com")) return "Spotify";
            if (host.Contains("soundcloud.com")) return "SoundCloud";
            if (host.Contains("steamcommunity.com") || host.Contains("steampowered.com")) return "Steam";
            if (host.Contains("artstation.com")) return "ArtStation";
            if (host.Contains("deviantart.com")) return "DeviantArt";
            if (host.Contains("pixiv.net")) return "Pixiv";
            if (host.Contains("carrd.co")) return "Carrd";
            if (host.Contains("linktr.ee")) return "Linktree";
            if (host.Contains("facebook.com")) return "Facebook";
            if (host.Contains("threads.net")) return "Threads";
            if (host.Contains("bsky.app") || host.Contains("bluesky")) return "Bluesky";
            if (host.Contains("gitlab.com")) return "GitLab";
            if (host.Contains("bilibili.com")) return "Bilibili";

            var parts = host.Split('.');
            if (parts.Length >= 2)
            {
                var name = parts[0];
                if (parts.Length > 2 && (parts[0] == "shop" || parts[0] == "store" || parts[0] == "app"))
                {
                    name = parts[1];
                }
                if (!string.IsNullOrEmpty(name))
                {
                    return char.ToUpper(name[0]) + name.Substring(1);
                }
            }

            return host;
        }
        catch
        {
            return url;
        }
    }

    private static string GetStatusColor(string? status)
    {
        return (status ?? "").ToLowerInvariant() switch
        {
            "join me" => "#43b581",
            "active" or "online" => "#51e57c",
            "ask me" => "#faa61a",
            "busy" => "#f04747",
            _ => "#747f8d"
        };
    }

    private static string GetStatusLabel(string? status)
    {
        return (status ?? "").ToLowerInvariant() switch
        {
            "join me" => "Join Me",
            "active" or "online" => "Online",
            "ask me" => "Ask Me",
            "busy" => "Busy / DND",
            _ => "Offline"
        };
    }

    public void Dispose()
    {
        AppEvents.RequestOpenProfileModal -= HandleOpenProfileModal;
    }
}
