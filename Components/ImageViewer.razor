    private async Task ScanQrInBackgroundAsync(string source, CancellationToken token)
    {
        try
        {
            var results = await QrService.ScanAsync(source, token);
            if (!token.IsCancellationRequested && results != null && results.Count > 0)
            {
                detectedQrCodes = results;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

