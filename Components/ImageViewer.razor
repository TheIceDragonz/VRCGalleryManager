    private async Task CopyTextToClipboard(string? text, string message = "Copied to clipboard")
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            bool success = false;
            try
            {
                success = await JS.InvokeAsync<bool>("clipboardInterop.writeText", text);
            }
            catch { }

            if (!success)
            {
                await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
                success = true;
            }

            if (success)
            {
                NotificationService.Show(message, "Copied", VRCGalleryManager.Core.NotificationType.Success);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Failed to copy: {ex.Message}", "Error", VRCGalleryManager.Core.NotificationType.Error);
        }
    }

