@using System.IO
@using System.Threading.Tasks
@inject IJSRuntime JS
@inject VRCGalleryManager.Core.NotificationService NotificationService
@inject VRCGalleryManager.Core.VRCAuth Auth

@if (IsVisible)
{
    <div class="image-viewer-overlay" @onclick="Close" tabindex="0" @onkeydown="HandleKeyDown" @ref="overlayRef" style="outline: none;">
        
        <div class="image-viewer-top-bar" @onclick:stopPropagation="true">
            <div class="image-viewer-title" title="@(CurrentItem?.Title)">
                @(CurrentItem?.Title)
            </div>
            <button class="btn btn-icon-only btn-viewer-close" @onclick="Close" title="Close">
                <img src="/svg/close-bold-svgrepo-com.svg" style="filter: invert(1);" />
            </button>
        </div>

        @if (Items != null && Items.Count > 1)
        {
            <button class="btn btn-icon-only btn-nav left" @onclick="Prev" @onclick:stopPropagation="true" disabled="@(CurrentIndex == 0)">
                <img src="/svg/back-arrow-svgrepo-com.svg" style="filter: invert(1);" />
            </button>
        }

        <div class="image-container" @ref="imageContainerRef">
            @if (!isHighResLoaded)
            {
                <div class="spinner-border text-accent position-absolute" style="width: 3rem; height: 3rem; border-width: 0.25em; z-index: 10;"></div>
                @if (!string.IsNullOrEmpty(CurrentItem?.LowResSource))
                {
                    <img src="@CurrentItem.LowResSource" class="viewer-img opacity-50" style="transform: scale(1.05);" @onclick:stopPropagation="true" draggable="false" />
                }
            }
            
            @if (!string.IsNullOrEmpty(CurrentHighResSource))
            {
                <img src="@CurrentHighResSource" class="viewer-img @(isHighResLoaded ? "opacity-100" : "opacity-0 position-absolute")" @onload="OnHighResLoaded" @onclick:stopPropagation="true" draggable="false" />
            }
        </div>

        <div class="image-viewer-bottom-bar" @onclick:stopPropagation="true">
            @if (CurrentItem?.HighResSource?.StartsWith("http") == false)
            {
                <button class="btn btn-icon-only btn-viewer-action" title="Open Location" @onclick="OpenLocationCurrent">
                    <img src="/svg/folder-open-svgrepo-com.svg" style="filter: invert(1);" />
                </button>
            }
            <button class="btn btn-icon-only btn-viewer-action" title="Copy Image" @onclick="CopyCurrent">
                <img src="/svg/copy-svgrepo-com.svg" style="filter: invert(1);" />
            </button>
            @if (ShowDownloadButton)
            {
                <button class="btn btn-icon-only btn-viewer-action" title="Download" @onclick="DownloadCurrent">
                    <img src="/svg/download-svgrepo-com.svg" style="filter: invert(1);" />
                </button>
            }
            @if (CurrentItem?.HighResSource?.StartsWith("http") == true)
            {
                <button class="btn btn-icon-only btn-viewer-action" title="Copy Link" @onclick="CopyLinkCurrent">
                    <img src="/svg/link-svgrepo-com.svg" style="filter: invert(1);" />
                </button>
            }

            @if (OnDeleteRequested.HasDelegate)
            {
                <button class="btn btn-icon-only btn-viewer-action" title="Delete" @onclick="DeleteCurrent">
                    <img src="/svg/trash-bin-trash-svgrepo-com.svg" style="filter: invert(27%) sepia(91%) saturate(2361%) hue-rotate(339deg) brightness(101%) contrast(106%);" />
                </button>
            }
            @if (OnUploadRequested.HasDelegate)
            {
                <button class="btn btn-icon-only btn-viewer-action" title="Upload" @onclick="UploadCurrent">
                    <img src="/svg/add-circle-svgrepo-com.svg" style="filter: invert(47%) sepia(87%) saturate(464%) hue-rotate(97deg) brightness(96%) contrast(87%);" />
                </button>
            }
            @if (CurrentVrcxData != null && (CurrentVrcxData.World != null || (CurrentVrcxData.Players != null && CurrentVrcxData.Players.Count > 0)))
            {
                <button class="btn btn-icon-only btn-viewer-action @(ShowInfoPanel ? "active" : "")" title="Toggle Info Panel" @onclick="ToggleInfoPanel">
                    <img src="/svg/info-circle-svgrepo-com.svg" style="filter: invert(1);" />
                </button>
            }
        </div>

        @if (ShowInfoPanel && CurrentVrcxData != null && (CurrentVrcxData.World != null || (CurrentVrcxData.Players != null && CurrentVrcxData.Players.Count > 0)))
        {
            <div class="image-viewer-info-panel" @onclick:stopPropagation="true">
                @if (CurrentVrcxData.World != null)
                {
                    <div class="world-info-viewer mb-3">
                        @if (!string.IsNullOrEmpty(CurrentVrcxData.World.ImageUrl))
                        {
                            <img src="@CurrentVrcxData.World.ImageUrl" class="world-img mb-2" />
                        }
                        <div class="world-name mt-0" style="cursor: pointer;" @onclick="() => OpenWorld(CurrentVrcxData.World.Id)" title="Open world page">
                            @CurrentVrcxData.World.Name
                        </div>

                    </div>
                }

                @if (CurrentVrcxData.Players != null && CurrentVrcxData.Players.Count > 0)
                {
                    <div class="d-flex flex-column flex-grow-1" style="min-height: 0;">
                        <div class="text-white-50 small fw-bold text-uppercase mb-2 d-flex align-items-center gap-2 flex-shrink-0">
                            <img src="/svg/profile-user-svgrepo-com.svg" style="width: 14px; height: 14px; filter: invert(80%) sepia(48%) saturate(1454%) hue-rotate(159deg) brightness(101%) contrast(97%);" />
                            Players (@CurrentVrcxData.Players.Count)
                        </div>
                        <div class="overflow-auto flex-grow-1 pe-1">
                            <div class="d-flex flex-column gap-1">
                                @foreach (var player in CurrentVrcxData.Players
                                    .OrderByDescending(p => p.Id == Auth.CurrentUser?.Id)
                                    .ThenByDescending(p => Auth.CurrentUser?.Friends?.Contains(p.Id) == true)
                                    .ThenBy(p => p.DisplayName))
                                {
                                    bool isAuthor = CurrentVrcxData.Author?.Id == player.Id;
                                    <div class="bg-secondary bg-opacity-25 rounded p-1 px-2 d-flex align-items-center gap-2 @(isAuthor ? "border border-primary border-opacity-50" : "")">
                                        <div class="rounded-circle @(isAuthor ? "bg-primary" : "bg-secondary")" style="width: 8px; height: 8px;"></div>
                                        <div class="@(player.Id == Auth.CurrentUser?.Id ? "text-accent" : (Auth.CurrentUser?.Friends?.Contains(player.Id) == true ? "text-warning" : "text-white")) small text-truncate flex-grow-1 fw-bold" style="cursor: pointer;" @onclick="() => OpenUserInBrowser(player.Id)" title="Open Profile in Browser">@player.DisplayName</div>
                                        @if (isAuthor)
                                        {
                                            <img src="/svg/camera-svgrepo-com.svg" style="width: 14px; height: 14px; filter: invert(80%) sepia(48%) saturate(1454%) hue-rotate(159deg) brightness(101%) contrast(97%);" title="Author" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Items != null && Items.Count > 1)
        {
            <button class="btn btn-icon-only btn-nav right" @onclick="Next" @onclick:stopPropagation="true" disabled="@(CurrentIndex == Items.Count - 1)">
                <img src="/svg/back-arrow-svgrepo-com.svg" style="transform: scaleX(-1); filter: invert(1);" />
            </button>
        }
        
        @if (Items != null && Items.Count > 1)
        {
            <div class="image-viewer-counter" @onclick:stopPropagation="true">
                @(CurrentIndex + 1) / @Items.Count
            </div>
        }
    </div>
}

@code {
    public class ViewerItem
    {
        public string HighResSource { get; set; }
        public string LowResSource { get; set; }
        public string Title { get; set; }
    }
    
    private VRCGalleryManager.Core.ApiRequest ApiReq;

    protected override void OnInitialized()
    {
        ApiReq = new VRCGalleryManager.Core.ApiRequest(Auth);
    }
    
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback<int> OnDeleteRequested { get; set; }
    [Parameter] public EventCallback<int> OnUploadRequested { get; set; }
    [Parameter] public bool ShowDownloadButton { get; set; } = true;

    public bool IsVisible { get; private set; }
    public IReadOnlyList<ViewerItem> Items { get; private set; }
    public int CurrentIndex { get; private set; }
    
    private ElementReference overlayRef;
    private bool _hasFocused = false;
    private ElementReference imageContainerRef;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Items == null || Items.Count <= 1)
        {
            if (e.Key == "Escape") Close();
            return;
        }

        if (e.Key == "ArrowLeft" || e.Key == "ArrowUp")
        {
            Prev();
        }
        else if (e.Key == "ArrowRight" || e.Key == "ArrowDown")
        {
            Next();
        }
        else if (e.Key == "Escape")
        {
            Close();
        }
    }
    private ViewerItem CurrentItem => Items != null && Items.Count > 0 && CurrentIndex >= 0 && CurrentIndex < Items.Count ? Items[CurrentIndex] : null;
    private string CurrentHighResSource = null;
    private bool isHighResLoaded = false;
    private CancellationTokenSource _cts;
    private VRCGalleryManager.Core.MetaDataImageReader.VrcxData CurrentVrcxData;
    private bool ShowInfoPanel = false;
    
    private void ToggleInfoPanel() => ShowInfoPanel = !ShowInfoPanel;

    public void Open(IReadOnlyList<ViewerItem> items, int startIndex)
    {
        Items = items;
        CurrentIndex = startIndex;
        IsVisible = true;
        _hasFocused = false;
        _ = LoadCurrentImageAsync();
        StateHasChanged();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible)
        {
            if (!_hasFocused)
            {
                _hasFocused = true;
                try { await overlayRef.FocusAsync(); } catch { }
            }
            if (!firstRender)
            {
                try {
                    await JS.InvokeVoidAsync("imageViewerZoom.init", imageContainerRef);
                } catch { }
            }
        }
    }
    
    public void Close()
    {
        IsVisible = false;
        CurrentHighResSource = null;
        Items = null;
        _cts?.Cancel();
        StateHasChanged();
        OnClosed.InvokeAsync();
        try { JS.InvokeVoidAsync("imageViewerZoom.reset", imageContainerRef); } catch { }
    }
    
    private void Prev()
    {
        if (CurrentIndex > 0)
        {
            CurrentIndex--;
            _ = LoadCurrentImageAsync();
            StateHasChanged();
            try { JS.InvokeVoidAsync("imageViewerZoom.reset", imageContainerRef); } catch { }
        }
    }
    
    private void Next()
    {
        if (CurrentIndex < Items.Count - 1)
        {
            CurrentIndex++;
            _ = LoadCurrentImageAsync();
            StateHasChanged();
            try { JS.InvokeVoidAsync("imageViewerZoom.reset", imageContainerRef); } catch { }
        }
    }

    private void OnHighResLoaded()
    {
        isHighResLoaded = true;
        StateHasChanged();
    }
    
    private async Task LoadCurrentImageAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        var item = CurrentItem;
        if (item == null || string.IsNullOrEmpty(item.HighResSource)) return;
        
        isHighResLoaded = false;
        CurrentHighResSource = null;
        CurrentVrcxData = null;
        StateHasChanged();
        
        try
        {
            if (item.HighResSource.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
                item.HighResSource.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                // For web URLs, just pass the URL to the img src
                CurrentHighResSource = item.HighResSource;
            }
            else
            {
                // For local files, read to Base64 to bypass browser local file restrictions
                var path = item.HighResSource;
                var base64 = await Task.Run(() => {
                    var bytes = File.ReadAllBytes(path);
                    var ext = Path.GetExtension(path).ToLowerInvariant();
                    var mime = ext == ".png" ? "image/png" : "image/jpeg";
                    return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
                }, token);
                
                if (!token.IsCancellationRequested)
                {
                    CurrentHighResSource = base64;
                    CurrentVrcxData = VRCGalleryManager.Core.MetaDataImageReader.ExtractVrcxData(path);
                    
                    if (CurrentVrcxData?.World != null && string.IsNullOrEmpty(CurrentVrcxData.World.ImageUrl) && !string.IsNullOrEmpty(CurrentVrcxData.World.Id))
                    {
                        _ = FetchWorldImageAsync(CurrentVrcxData.World.Id);
                    }

                    if (CurrentVrcxData != null && (CurrentVrcxData.World != null || (CurrentVrcxData.Players != null && CurrentVrcxData.Players.Count > 0)))
                    {
                        ShowInfoPanel = true;
                    }
                    else
                    {
                        ShowInfoPanel = false;
                    }
                }
            }
        }
        catch 
        {
            if (!token.IsCancellationRequested)
            {
                CurrentHighResSource = null;
                isHighResLoaded = true; // Stop spinner if failed
            }
        }
        
        if (!token.IsCancellationRequested)
            StateHasChanged();
    }
    
    private async Task FetchWorldImageAsync(string worldId)
    {
        try
        {
            var worldInfo = await ApiReq.GetWorldInfo(worldId);
            if (worldInfo != null && !string.IsNullOrEmpty(worldInfo.ImageUrl))
            {
                if (CurrentVrcxData != null && CurrentVrcxData.World != null && CurrentVrcxData.World.Id == worldId)
                {
                    CurrentVrcxData.World.ImageUrl = worldInfo.ThumbnailUrl ?? worldInfo.ImageUrl;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }
    
    private async Task DownloadCurrent()
    {
        var src = CurrentItem?.HighResSource;
        if (string.IsNullOrEmpty(src)) return;
        
        try 
        {
            string fileName = CurrentItem?.Title ?? "download";
            foreach (char c in System.IO.Path.GetInvalidFileNameChars())
            {
                fileName = fileName.Replace(c, '_');
            }
            
            if (src.StartsWith("http"))
            {
                string tempFile = await VRCGalleryManager.Core.ClipboardHandler.SaveImageFromUrlAsync(src, false);
                if (string.IsNullOrEmpty(tempFile)) 
                {
                    return;
                }
                
                string ext = System.IO.Path.GetExtension(tempFile);
                if (string.IsNullOrEmpty(ext)) ext = ".png";
                
                using var stream = new System.IO.MemoryStream(System.IO.File.ReadAllBytes(tempFile));
                var result = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync(fileName + ext, stream, default);
                if (result.IsSuccessful) {
                    NotificationService.Show("Image saved successfully.", "Saved", VRCGalleryManager.Core.NotificationType.Success);
                }
            }
            else
            {
                string ext = System.IO.Path.GetExtension(src);
                using var stream = new System.IO.MemoryStream(System.IO.File.ReadAllBytes(src));
                var result = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync(fileName + ext, stream, default);
                if (result.IsSuccessful) {
                    NotificationService.Show("Image saved successfully.", "Saved", VRCGalleryManager.Core.NotificationType.Success);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Download failed: {ex.Message}", "Error", VRCGalleryManager.Core.NotificationType.Error);
        }
    }

    private void OpenLocationCurrent()
    {
        var src = CurrentItem?.HighResSource;
        if (!string.IsNullOrEmpty(src) && !src.StartsWith("http"))
        {
            try
            {
                if (System.IO.File.Exists(src))
                {
                    System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{src}\"");
                }
            }
            catch { }
        }
    }

    private async Task CopyCurrent()
    {
        var src = CurrentItem?.HighResSource;
        if (string.IsNullOrEmpty(src)) return;
        
        try {
            bool success = false;
            if (src.StartsWith("http"))
            {
                string tempPath = await VRCGalleryManager.Core.ClipboardHandler.SaveImageFromUrlAsync(src, false);
                if (!string.IsNullOrEmpty(tempPath)) {
                    success = await VRCGalleryManager.Core.ClipboardHandler.CopyImageToClipboardAsync(tempPath);
                }
            }
            else
            {
                success = await VRCGalleryManager.Core.ClipboardHandler.CopyImageToClipboardAsync(src);
            }
            
            if (success) {
                NotificationService.Show("Image copied to clipboard.", "Copied", VRCGalleryManager.Core.NotificationType.Success);
            } else {
                NotificationService.Show("Failed to copy image.", "Error", VRCGalleryManager.Core.NotificationType.Error);
            }
        } catch (Exception ex) {
            NotificationService.Show($"Failed to copy image: {ex.Message}", "Error", VRCGalleryManager.Core.NotificationType.Error);
        }
    }
    
    private async Task CopyLinkCurrent()
    {
        var src = CurrentItem?.HighResSource;
        if (!string.IsNullOrEmpty(src) && src.StartsWith("http"))
        {
            try {
                bool success = await JS.InvokeAsync<bool>("clipboardInterop.writeText", src);
                if (success) {
                    NotificationService.Show("Link copied to clipboard", "Copied", VRCGalleryManager.Core.NotificationType.Success);
                }
            } catch { }
        }
    }
    
    private async Task DeleteCurrent()
    {
        if (OnDeleteRequested.HasDelegate)
        {
            await OnDeleteRequested.InvokeAsync(CurrentIndex);
        }
    }
    
    private async Task UploadCurrent()
    {
        if (OnUploadRequested.HasDelegate)
        {
            await OnUploadRequested.InvokeAsync(CurrentIndex);
        }
    }

    private void OpenWorld(string worldId)
    {
        if (!string.IsNullOrEmpty(worldId))
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = $"https://vrchat.com/home/world/{worldId}",
                    UseShellExecute = true
                });
            }
            catch { }
        }
    }

    private void OpenUserInBrowser(string userId)
    {
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = $"https://vrchat.com/home/user/{userId}",
                    UseShellExecute = true
                });
            }
            catch { }
        }
    }
}

