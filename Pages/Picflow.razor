@page "/picflow"
@using System.Text.RegularExpressions
@using System.IO
@using VRCGalleryManager.Core
@inject VRCAuth Auth
@inject NotificationService NotificationService
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject DialogService dialogService



<div class="h-100 d-flex flex-column p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
        <div>
            <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                <img src="/svg/gallery-wide-svgrepo-com.svg" class="media-page-icon" /> Picflow <span class="fs-6 text-muted ms-2">@LogStatus</span>
            </h3>
        </div>
        
        <div class="d-flex align-items-center gap-2">
            <span class="text-white-50">@Images.Count Items</span>

            <div class="form-check form-switch d-flex align-items-center mb-0 ms-2 me-2">
                <input class="form-check-input mt-0 me-2 cursor-pointer" type="checkbox" id="streamSwitch" @bind="IsStreaming" @bind:after="OnStreamingChanged">
                <label class="form-check-label text-white cursor-pointer" for="streamSwitch">Stream</label>
            </div>
            
            <div class="form-check form-switch d-flex align-items-center mb-0 ms-2 me-2" title="Automatically remove white borders from Prints when uploading">
                <input class="form-check-input mt-0 me-2 cursor-pointer" type="checkbox" id="cropBorderSwitch" checked="@CropPrints" @onchange="OnCropPrintsChanged">
                <label class="form-check-label text-white cursor-pointer" for="cropBorderSwitch">Crop Prints</label>
            </div>
            
            <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@IsStreaming" title="Refresh">
                <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
            </button>
            <button class="btn btn-outline-danger btn-sm" @onclick="ClearItems" title="Clear">
                <img src="/svg/broom-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
            </button>
            <button class="btn btn-info btn-sm" @onclick="ToggleInfo">
                <img src="/svg/info-circle-svgrepo-com.svg" class="btn-icon" /> Info
            </button>
        </div>
    </div>

    @if (ShowInfo)
    {
        <div class="alert alert-info cursor-pointer" role="alert" @onclick="CopyInfoText">
            <strong>Tip:</strong> Click here to copy <code>--enable-sdk-log-levels</code>. You need to add this to your VRChat launch options for Picflow to read stickers, emojis and prints!
        </div>
    }

    <div class="mb-3 d-flex gap-1 p-1 rounded-pill shadow-sm mx-auto" style="width: fit-content; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255,255,255,0.1);">
        <button class="btn btn-sm rounded-pill px-3 @GetCategoryBtnClass(null)" @onclick="() => SetCategory(null)">All</button>
        <button class="btn btn-sm rounded-pill px-3 @GetCategoryBtnClass(ItemCategory.Sticker)" @onclick="() => SetCategory(ItemCategory.Sticker)">Stickers</button>
        <button class="btn btn-sm rounded-pill px-3 @GetCategoryBtnClass(ItemCategory.Emoji)" @onclick="() => SetCategory(ItemCategory.Emoji)">Emojis</button>
        <button class="btn btn-sm rounded-pill px-3 @GetCategoryBtnClass(ItemCategory.Print)" @onclick="() => SetCategory(ItemCategory.Print)">Prints</button>
    </div>

    <style>
        .btn-hover-light { opacity: 0.25; transition: all 0.2s; }
        .btn-hover-light:hover { opacity: 1 !important; background: rgba(255,255,255,0.1); }
        .print-card-ratio { aspect-ratio: 2048 / 1440; }
        .photo-card-ratio { aspect-ratio: 16 / 9; }
    </style>

    <div class="flex-grow-1 overflow-auto">
        <div class="media-grid gap-3 align-items-center">
            @foreach (var img in FilteredImages)
            {
                <div class="position-relative media-card-container overflow-hidden @(img.Category == ItemCategory.Print ? (CropPrints ? "photo-card-ratio" : "print-card-ratio") : "picflow-card")">
                    @if (string.IsNullOrEmpty(img.Url))
                    {
                        <div class="w-100 h-100 d-flex justify-content-center align-items-center">
                            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                        </div>
                    }
                    else
                    {
                        if (img.Category == ItemCategory.Print && CropPrints)
                        {
                            <img src="@img.Url" style="width: 106.66%; height: 133.33%; object-fit: fill; position: absolute; top: -6.38%; left: -3.33%;" loading="lazy" />
                        }
                        else
                        {
                            <img src="@img.Url" class="w-100 h-100 object-fit-cover" loading="lazy" />
                        }
                    }
                    <div class="position-absolute w-100 text-center media-card-label picflow-label">
                        @img.Username
                    </div>

                    @if (!string.IsNullOrEmpty(img.Url))
                    {
                        <button class="btn btn-success btn-sm rounded-circle position-absolute btn-action media-btn-upload" style="right: 40px;" @onclick="() => ToggleUploadMenu(img)" title="Add (upload)">
                            <img src="/svg/add-circle-svgrepo-com.svg" class="btn-icon" style="margin: 0; filter: invert(1);" />
                        </button>

                        <button class="btn btn-dark btn-sm rounded-circle position-absolute btn-action media-btn-open" style="right: 5px;" @onclick="() => OpenImage(img)" title="View Image">
                            <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (UploadMenuImage != null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center dialog-overlay" style="z-index: 10000;" @onclick="CloseUploadMenu">
        <div class="dialog-panel d-flex flex-column" @onclick:stopPropagation="true" style="min-width: 300px;">
            <div class="p-4 flex-grow-1 border-bottom border-secondary text-center">
                <h5 class="fw-bold text-white mb-2">Upload to...</h5>
                <p class="text-light mb-3 small">Select the category where you want to upload this image.</p>
                
                @if (UploadMenuImage.Category == ItemCategory.Print && CropPrints)
                {
                    <div class="overflow-hidden position-relative d-inline-block rounded shadow-sm mx-auto" style="height: 200px; aspect-ratio: 16/9;">
                        <img src="@UploadMenuImage.Url" style="width: 106.66%; height: 133.33%; object-fit: fill; position: absolute; top: -6.38%; left: -3.33%;" />
                    </div>
                }
                else
                {
                    <img src="@UploadMenuImage.Url" class="rounded shadow-sm" style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                }
            </div>
            <div class="p-3 d-flex flex-column gap-2 dialog-footer">
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory(UploadMenuImage, "icons")'><img src="/svg/profile-user-svgrepo-com.svg" style="width:20px;height:20px; filter: invert(0.8);" /> Icons</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory(UploadMenuImage, "photos")'><img src="/svg/camera-svgrepo-com.svg" style="width:20px;height:20px; filter: invert(0.8);" /> Photos</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory(UploadMenuImage, "emoji")'><img src="/svg/emoji-funny-circle-svgrepo-com.svg" style="width:20px;height:20px; filter: invert(0.8);" /> Emoji</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory(UploadMenuImage, "sticker")'><img src="/svg/sticker-smile-square-svgrepo-com.svg" style="width:20px;height:20px; filter: invert(0.8);" /> Sticker</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory(UploadMenuImage, "prints")'><img src="/svg/gallery-minimalistic-svgrepo-com.svg" style="width:20px;height:20px; filter: invert(0.8);" /> Prints</button>
                
                <button class="btn btn-danger mt-2 fw-bold" @onclick="CloseUploadMenu">Cancel</button>
            </div>
        </div>
    </div>
}

<VRCGalleryManager.Components.ImageViewer @ref="imageViewer" OnUploadRequested="HandleViewerUpload" />

@code {
    private ApiRequest ApiReq;
    private List<ImageModel> Images = new();
    private bool IsStreaming = false;
    private bool ShowInfo = false;
    private string LogStatus = "";
    private CancellationTokenSource? _cts;
    private HashSet<string> _allItems = new();
    private ItemCategory? SelectedCategory = null;

    private IEnumerable<ImageModel> FilteredImages => SelectedCategory.HasValue 
        ? Images.Where(i => i.Category == SelectedCategory.Value) 
        : Images;

    private static List<ImageModel> cachedImages = null;
    private static HashSet<string> cachedAllItems = null;
    private static string cachedLogStatus = null;

    private static readonly Regex StickerRegex = new Regex(
        @"User\s+(?<userId>usr_[a-f0-9\-]+)\s+\((?<username>[^)]+)\).*?sticker\s+(?<sticker>inv_[a-f0-9\-]+)",
        RegexOptions.Compiled | RegexOptions.IgnoreCase
    );

    private static readonly Regex EmojiRegex = new Regex(
        @"https://api\.vrchat\.cloud/api/1/user/(?<userId>usr_[a-f0-9\-]+)/inventory/(?<emoji>inv_[a-f0-9\-]+)",
        RegexOptions.Compiled | RegexOptions.IgnoreCase
    );

    private static readonly Regex PrintRegex = new Regex(
        @"https://api\.vrchat\.cloud/api/1/prints/(?<print>prnt?_[a-f0-9\-]+)",
        RegexOptions.Compiled | RegexOptions.IgnoreCase
    );

    public enum ItemCategory { Sticker, Emoji, Print }

    public class ImageModel
    {
        public string Username { get; set; } = "Unknown";
        public string UserId { get; set; } = "";
        public string ItemId { get; set; }
        public string Url { get; set; }
        public ItemCategory Category { get; set; }
    }

    private bool CropPrints = true;
    private VRCGalleryManager.Components.ImageViewer imageViewer;

    protected override async Task OnInitializedAsync()
    {
        CropPrints = Config.Get("CropWhiteBorder", "true") == "true";
        ApiReq = new ApiRequest(Auth);
        
        if (cachedImages != null)
        {
            Images = cachedImages;
            _allItems = cachedAllItems;
            LogStatus = cachedLogStatus ?? "";
        }
        else
        {
            cachedImages = Images;
            cachedAllItems = _allItems;
            await LoadFromLogs();
        }
    }

    private async Task Refresh()
    {
        cachedImages = null;
        cachedAllItems = null;
        ClearItems();
        await LoadFromLogs();
    }

    private void ClearItems()
    {
        Images.Clear();
        _allItems.Clear();
        LogStatus = "";
        StateHasChanged();
    }

    private string GetCategoryBtnClass(ItemCategory? cat)
    {
        if (SelectedCategory == cat)
            return "btn-primary fw-bold";
        
        if (SelectedCategory == null)
            return "text-white border-0"; // Normal brightness if "All" is active

        return "text-white border-0 btn-hover-light"; // Darkened if another category is active
    }

    private void SetCategory(ItemCategory? category)
    {
        if (SelectedCategory == category && category != null)
        {
            SelectedCategory = null;
        }
        else
        {
            SelectedCategory = category;
        }
        StateHasChanged();
    }

    private void ToggleInfo()
    {
        ShowInfo = !ShowInfo;
    }

    private async Task CopyInfoText()
    {
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync("--enable-sdk-log-levels");
        ShowInfo = false;
    }

    private void OnCropPrintsChanged(ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            CropPrints = val;
            Config.Set("CropWhiteBorder", val ? "true" : "false");
        }
    }

    private void OnStreamingChanged()
    {
        if (IsStreaming)
        {
            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            _ = StreamLogsAsync(_cts.Token);
        }
        else
        {
            _cts?.Cancel();
        }
    }

    private async Task LoadFromLogs()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        string userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        string vrchatLogPath = Path.Combine(userProfile, "AppData", "LocalLow", "VRChat", "VRChat");

        if (!Directory.Exists(vrchatLogPath))
        {
            LogStatus = "| No data found";
            return;
        }

        var logFiles = Directory.EnumerateFiles(vrchatLogPath, "output_log_*.txt")
                                .OrderByDescending(f => File.GetLastWriteTimeUtc(f));

        if (!logFiles.Any())
        {
            LogStatus = "| No data found";
            return;
        }

        LogStatus = "| Processing...";
        cachedLogStatus = LogStatus;
        StateHasChanged();

        foreach (var logFile in logFiles)
        {
            token.ThrowIfCancellationRequested();

            try
            {
                using var fileStream = new FileStream(logFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                using var reader = new StreamReader(fileStream);

                string? line;
                while ((line = await reader.ReadLineAsync()) != null)
                {
                    token.ThrowIfCancellationRequested();
                    ProcessLogLine(line);
                }
            }
            catch (IOException) { }
        }

        LogStatus = "";
        cachedLogStatus = LogStatus;
        StateHasChanged();
    }

    private async Task StreamLogsAsync(CancellationToken token)
    {
        string userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        string vrchatLogPath = Path.Combine(userProfile, "AppData", "LocalLow", "VRChat", "VRChat");

        string[] logFiles = Directory.GetFiles(vrchatLogPath, "output_log_*.txt");

        if (logFiles.Length == 0) return;

        string lastLogFile = logFiles.OrderByDescending(f => File.GetLastWriteTime(f)).First();

        try
        {
            using FileStream fileStream = new(lastLogFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            using StreamReader reader = new(fileStream);

            fileStream.Seek(0, SeekOrigin.End);

            while (!token.IsCancellationRequested)
            {
                string? line = await reader.ReadLineAsync();

                if (line != null)
                {
                    ProcessLogLine(line);
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await Task.Delay(500, token);
                }
            }
        }
        catch (IOException) { }
    }

    private void ProcessLogLine(string line)
    {
        var stickerMatch = StickerRegex.Match(line);
        if (stickerMatch.Success)
        {
            string userId = stickerMatch.Groups["userId"].Value;
            string username = stickerMatch.Groups["username"].Value;
            string itemId = stickerMatch.Groups["sticker"].Value;
            TryAddItem(itemId, userId, username, ItemCategory.Sticker);
            return;
        }

        var emojiMatch = EmojiRegex.Match(line);
        if (emojiMatch.Success)
        {
            string userId = emojiMatch.Groups["userId"].Value;
            string itemId = emojiMatch.Groups["emoji"].Value;
            TryAddItem(itemId, userId, "Emoji User", ItemCategory.Emoji);
            return;
        }

        var printMatch = PrintRegex.Match(line);
        if (printMatch.Success)
        {
            string itemId = printMatch.Groups["print"].Value;
            TryAddItem(itemId, "", "Print Author", ItemCategory.Print);
            return;
        }
    }

    private void TryAddItem(string itemId, string userId, string username, ItemCategory category)
    {
        if (_allItems.Add(itemId))
        {
            var imgModel = new ImageModel
            {
                Username = username,
                UserId = userId,
                ItemId = itemId,
                Url = "", // Will fetch asynchronously
                Category = category
            };
            Images.Insert(0, imgModel);
            
            // Fetch the actual image URL asynchronously
            _ = FetchImageUrl(imgModel);
        }
    }
    
    private async Task FetchImageUrl(ImageModel imgModel)
    {
        try
        {
            if (imgModel.Category == ItemCategory.Sticker || imgModel.Category == ItemCategory.Emoji)
            {
                var invInfo = await ApiReq.GetInventoryInfo(imgModel.UserId, imgModel.ItemId);
                if (invInfo != null)
                {
                    if (imgModel.Category == ItemCategory.Emoji && (invInfo.Tags == null || !invInfo.Tags.Contains("Custom Emoji")))
                    {
                        Images.Remove(imgModel);
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                    
                    if (imgModel.Category == ItemCategory.Emoji)
                    {
                        imgModel.Username = await ApiReq.GetUserName(imgModel.UserId);
                    }

                    string fileId = invInfo.Metadata?.FileId;
                    if (!string.IsNullOrEmpty(fileId))
                    {
                        imgModel.Url = $"https://api.vrchat.cloud/api/1/image/{fileId}/1/256";
                    }
                    else if (!string.IsNullOrEmpty(invInfo.ImageUrl))
                    {
                        string url = invInfo.ImageUrl;
                        if (url.Contains("/file/"))
                        {
                            url = url.Replace("/file/", "/image/").Replace("/file", "/256");
                        }
                        imgModel.Url = url;
                    }
                }
                else
                {
                    Images.Remove(imgModel);
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
            else if (imgModel.Category == ItemCategory.Print)
            {
                var printInfo = await ApiReq.GetPrintInfo(imgModel.ItemId);
                if (printInfo != null && !string.IsNullOrEmpty(printInfo.FileId))
                {
                    if (!string.IsNullOrEmpty(printInfo.AuthorName))
                    {
                        imgModel.Username = printInfo.AuthorName;
                    }
                    imgModel.Url = $"https://api.vrchat.cloud/api/1/image/{printInfo.FileId}/1/256";
                }
                else
                {
                    Images.Remove(imgModel);
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }

            if (!string.IsNullOrEmpty(imgModel.Url))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Ignore fetch errors
        }
    }

    private ImageModel UploadMenuImage;

    private void ToggleUploadMenu(ImageModel img)
    {
        if (UploadMenuImage == img)
            UploadMenuImage = null;
        else
            UploadMenuImage = img;
    }

    private void CloseUploadMenu()
    {
        if (UploadMenuImage != null)
        {
            UploadMenuImage = null;
            StateHasChanged();
        }
    }

    private void UploadForCategory(ImageModel img, string route)
    {
        UploadMenuImage = null;
        if (img == null || string.IsNullOrEmpty(img.Url)) return;
        
        _ = ProcessUploadRoute(img, route);
    }

    private async Task ProcessUploadRoute(ImageModel img, string route)
    {
        string highResUrl = img.Url.Replace("/image/", "/file/").Replace("/256", "/file");
        bool cropBorder = img.Category == ItemCategory.Print && CropPrints;
        string localPath = await ClipboardHandler.SaveImageFromUrlAsync(highResUrl, cropBorder);
        if (!string.IsNullOrEmpty(localPath))
        {
            var encoded = Uri.EscapeDataString(localPath);
            NavManager.NavigateTo($"/{route}?uploadPath={encoded}");
        }
        else
        {
            NotificationService.Show("Failed to download image.", "Download Error", NotificationType.Error);
        }
    }

    private async Task DeleteImage(ImageModel img)
    {
        bool confirm = await dialogService.ShowConfirmAsync("Delete Image", "Are you sure you want to delete this image?", "Delete", "Cancel");
        if (confirm)
        {
            DeleteItem(img);
        }
    }

    private void OpenImage(ImageModel img)
    {
        var viewerItems = Images.Select(i => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = i.Url.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = i.Url,
            Title = $"{i.Username} - {i.Category}"
        }).ToList();
        
        var currentUrl = img.Url.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        imageViewer.Open(viewerItems, index);
    }

    private void DeleteItem(ImageModel img)
    {
        Images.Remove(img);
        _allItems.Remove(img.ItemId);
    }

    public void Dispose()
    {
        _cts?.Cancel();
    }
    private void HandleViewerUpload(int index)
    {
        var targetList = Images;
        if (index >= 0 && index < targetList.Count)
        {
            var item = targetList[index];
            ToggleUploadMenu(item);
        }
    }
}


