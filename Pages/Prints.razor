@page "/prints"
@implements IDisposable
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using Newtonsoft.Json.Linq
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject VRCAuth Auth
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject DialogService dialogService
@inject FileDropService FileDropService

<div class="h-100 d-flex flex-column p-3 position-relative">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.ImageEditor Base64Image="@editingBase64Image" TargetWidth="1920" TargetHeight="1080" OnSave="OnEditorSave" OnCancel="OnEditorCancel">
                <EditorBottomContent>
                    @if (OperatingSystem.IsWindows())
                    {
                        <div class="rounded-pill d-flex align-items-center mx-auto" style="background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.12); width: 100%; max-width: 400px; padding: 0.5rem 1.2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.4);">
                            <img src="/svg/write-f-svgrepo-com.svg" style="width: 16px; height: 16px; filter: invert(0.6);" class="me-2 flex-shrink-0" />
                            <input type="text" class="form-control text-white border-0 bg-transparent shadow-none p-0 m-0 w-100" @bind="printNote" placeholder="Add a custom note..." style="outline: none; font-size: 0.95rem;" />
                        </div>
                    }
                </EditorBottomContent>
                <EditorExtraContent>
                    @if (!OperatingSystem.IsWindows())
                    {
                        <label class="form-label small text-muted mb-1">Print Note</label>
                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary" @bind="printNote" placeholder="Custom print note..." />
                    }
                </EditorExtraContent>
            </VRCGalleryManager.Components.ImageEditor>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/camera-svgrepo-com.svg" class="media-page-icon" /> Prints
                    <span class="@(imageCount >= 64 ? "badge bg-danger fs-6 ms-2" : "text-white-50 fs-6 ms-2")">@imageCount/64</span>
                </h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                </button>

                <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 64 ? "disabled" : "")">
                    <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 64)" accept="image/png, image/jpeg, image/gif, image/webp" />
                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                </label>
                
                <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard">
                    <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid grid-medium gap-3">
                    @foreach (var print in prints)
                    {
                        <div class="position-relative print-card media-card-container">
                            <img src="@print.ImageUrl" class="w-100 h-100 object-fit-cover" />
                            
                            <button class="btn btn-dark btn-sm rounded-circle position-absolute btn-action media-btn-open" @onclick="() => OpenImage(print)" title="View Image">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                            
                            <button class="btn btn-danger btn-sm rounded-circle position-absolute btn-action media-btn-delete" @onclick="() => DeletePrint(print)" title="Delete">
                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                            
                            @if (!string.IsNullOrEmpty(print.AuthorName))
                            {
                                <div class="position-absolute w-100 text-center media-card-label picflow-label fw-bold @(!string.IsNullOrEmpty(print.AuthorId) ? "cursor-pointer" : "") @(!string.IsNullOrEmpty(print.AuthorId) && print.AuthorId == Auth.CurrentUser?.Id ? "text-accent" : (!string.IsNullOrEmpty(print.AuthorId) && Auth.CurrentUser?.Friends?.Contains(print.AuthorId) == true ? "text-warning" : ""))" @onclick="() => OpenUserInBrowser(print.AuthorId)" title="@(!string.IsNullOrEmpty(print.AuthorId) ? "Open Profile in Browser" : "")">
                                    @print.AuthorName
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<VRCGalleryManager.Components.ImageViewer @ref="imageViewer" OnDeleteRequested="HandleViewerDelete" />

@code {
    private ApiRequest apiRequest;
    private bool isLoading = true;
    private bool isRefreshing = false;
    private int imageCount = 0;
    private List<PrintItem> prints = new();
    private VRCGalleryManager.Components.ImageViewer imageViewer;
    
    private static List<PrintItem> cachedPrints = null;
    private static int cachedImageCount = 0;

    private string editingBase64Image = null;
    private bool isDragging = false;
    private string printNote = "";

    private static string PRINTS_TAG = "print";

    public class PrintItem
    {
        public string Id { get; set; }
        public string ImageUrl { get; set; }
        public string AuthorName { get; set; }
        public string AuthorId { get; set; }
    }

    [SupplyParameterFromQuery]
    public string uploadPath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        FileDropService.OnDragEnter += HandleDragEnter;
        FileDropService.OnDragLeave += HandleDragLeave;
        FileDropService.OnFileDropped += HandleFileDropped;
        apiRequest = new ApiRequest(Auth);
        if (cachedPrints != null)
        {
            prints = new List<PrintItem>(cachedPrints);
            imageCount = cachedImageCount;
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }

        if (!string.IsNullOrEmpty(uploadPath) && File.Exists(uploadPath))
        {
            await LoadLocalFileForEditing(uploadPath);
        }
    }

    private async Task RefreshList()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        isLoading = true;
        prints.Clear();
        cachedPrints = null;
        StateHasChanged();

        try
        {
            var data = await apiRequest.GetApiData(PRINTS_TAG);
            
            if (data?.JsonImage != null)
            {
                imageCount = data.JsonImage.Count;
                
                foreach (string json in data.JsonImage)
                {
                    JObject jsonObject = JObject.Parse(json);
                    string id = jsonObject["id"]?.ToString();
                    string fileId = jsonObject["files"]?["fileId"]?.ToString();
                    string authorName = jsonObject["authorName"]?.ToString();
                    string authorId = jsonObject["authorId"]?.ToString();
                    
                    if (!string.IsNullOrEmpty(id) && !string.IsNullOrEmpty(fileId))
                    {
                        prints.Add(new PrintItem
                        {
                            Id = id,
                            ImageUrl = $"https://api.vrchat.cloud/api/1/image/{fileId}/1/256",
                            AuthorName = authorName,
                            AuthorId = authorId
                        });
                    }
                }
            }
            
            cachedPrints = new List<PrintItem>(prints);
            cachedImageCount = imageCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading prints: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void OpenImage(PrintItem item)
    {
        var viewerItems = prints.Select(p => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = p.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = p.ImageUrl,
            Title = "Print"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        imageViewer.Open(viewerItems, index);
    }

    private async Task DeletePrint(PrintItem item)
    {
        bool confirm = await dialogService.ShowConfirmAsync("Delete Print", "Are you sure you want to delete this print?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                await apiRequest.DeleteApiDataPrint(item.Id);
                prints.Remove(item);
                imageCount--;
                cachedPrints = new List<PrintItem>(prints);
                cachedImageCount = imageCount;
                StateHasChanged();
                NotificationService.Show("Print deleted successfully.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show(ex.Message, "Delete Failed", NotificationType.Error);
            }
        }
    }

    private async Task OnDropFile(InputFileChangeEventArgs e)
    {
        isDragging = false;
        await OnInputFileChange(e);
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && file.ContentType.StartsWith("image/"))
        {
            await LoadFileForEditing(file);
        }
    }

    private async Task PasteFromClipboard()
    {
        try
        {
            string savedPath = await ClipboardHandler.ClipboardDataImageOrLink();
            if (!string.IsNullOrEmpty(savedPath) && File.Exists(savedPath))
            {
                await LoadLocalFileForEditing(savedPath);
            }
            else
            {
                NotificationService.Show("No image found or invalid link in clipboard.", "Clipboard Empty", NotificationType.Info);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show(ex.Message, "Paste Error", NotificationType.Error);
        }
    }

    private async Task LoadFileForEditing(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            
            if (file.ContentType.Contains("gif", StringComparison.OrdinalIgnoreCase))
            {
                NotificationService.Show("Le GIF sono supportate solo per le Emoji. L'immagine è stata convertita in formato statico.", "Formato GIF convertito", NotificationType.Info);
            }
            byte[] bytes = memoryStream.ToArray();
            string base64String = Convert.ToBase64String(bytes);
            editingBase64Image = $"data:{file.ContentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading file: {ex.Message}");
        }
    }

    private async Task LoadLocalFileForEditing(string filePath)
    {
        try
        {
            byte[] bytes = await File.ReadAllBytesAsync(filePath);
            string contentType = GetContentType(filePath);

            if (contentType.Contains("gif", StringComparison.OrdinalIgnoreCase))
            {
                NotificationService.Show("Le GIF sono supportate solo per le Emoji. L'immagine è stata convertita in formato statico.", "Formato GIF convertito", NotificationType.Info);
            }

            string base64String = Convert.ToBase64String(bytes);
            editingBase64Image = $"data:{contentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading local file: {ex.Message}");
        }
    }
    
    private string GetContentType(string filePath)
    {
        string ext = Path.GetExtension(filePath).ToLower();
        return ext switch
        {
            ".png" => "image/png",
            ".jpg" => "image/jpeg",
            ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            _ => "image/png"
        };
    }

    private async Task OnEditorSave(string base64Result)
    {
        try
        {
            string mimeType = "image/png";
            int semiColonIndex = base64Result.IndexOf(";");
            if (base64Result.StartsWith("data:") && semiColonIndex > 5)
            {
                mimeType = base64Result.Substring(5, semiColonIndex - 5);
            }
            string ext = mimeType == "image/jpeg" ? ".jpg" : ".png";

            var headerParts = base64Result.Split(',');
            var base64Data = headerParts.Length > 1 ? headerParts[1] : headerParts[0];
            byte[] bytes = Convert.FromBase64String(base64Data);
            
            string tempFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
            Directory.CreateDirectory(tempFolder);
            string tempPath = Path.Combine(tempFolder, $"upload_print_{Guid.NewGuid()}{ext}");
            
            await File.WriteAllBytesAsync(tempPath, bytes);

            await apiRequest.UploadPrint(tempPath, printNote);

            try { File.Delete(tempPath); } catch { }

            await RefreshList();
            editingBase64Image = null;
            printNote = "";
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private void OnEditorCancel()
    {
        editingBase64Image = null;
        printNote = "";
    }

    public void Dispose()
    {
        FileDropService.OnDragEnter -= HandleDragEnter;
        FileDropService.OnDragLeave -= HandleDragLeave;
        FileDropService.OnFileDropped -= HandleFileDropped;
    }

    private void HandleDragEnter()
    {
        InvokeAsync(() =>
        {
            isDragging = true;
            StateHasChanged();
        });
    }

    private void HandleDragLeave()
    {
        InvokeAsync(() =>
        {
            isDragging = false;
            StateHasChanged();
        });
    }

    private void HandleFileDropped(string[] files)
    {
        InvokeAsync(async () =>
        {
            isDragging = false;
            if (files != null && files.Length > 0)
            {
                var filePath = files[0];
                string ext = System.IO.Path.GetExtension(filePath).ToLower();
                if (ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".webp" || ext == ".gif")
                {
                    await LoadLocalFileForEditing(filePath);
                }
            }
            StateHasChanged();
        });
    }

    private async Task HandleViewerDelete(int index)
    {
        if (index >= 0 && index < prints.Count)
        {
            var item = prints[index];
            await DeletePrint(item);
            if (!prints.Contains(item))
            {
                imageViewer.Close();
            }
        }
    }

    private void OpenUserInBrowser(string userId)
    {
        if (!string.IsNullOrEmpty(userId))
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = $"https://vrchat.com/home/user/{userId}",
                    UseShellExecute = true
                });
            }
            catch { }
        }
    }
}
