@page "/photos"
@inherits VRCGalleryManager.Core.Components.MediaPageBase
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<div class="h-100 d-flex flex-column p-3 position-relative @(isMultiSelectMode ? "gallery-multiselect-active" : "")" @onmouseup="HandleMouseUp" @onkeydown="HandleKeyDown" tabindex="0">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.ImageEditor Base64Image="@editingBase64Image" TargetWidth="1920" TargetHeight="1080" OnSave="OnEditorSave" OnCancel="OnEditorCancel" />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/gallery-minimalistic-svgrepo-com.svg" class="media-page-icon" /> Photos
                    <span class="@(imageCount >= 64 ? "badge bg-danger fs-6 ms-2" : "text-white-50 fs-6 ms-2")">@imageCount/64</span>
                </h3>
            </div>
            @if (isMultiSelectMode)
            {
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <span class="gallery-multiselect-badge text-nowrap me-1">
                        <span class="badge-count-accent">@selectedIds.Count</span>
                        <span class="badge-count-sep">/</span>
                        <span class="badge-count-total">@photos.Count</span>
                        <span class="badge-label">selected</span>
                    </span>

                    <button type="button"
                            class="gallery-tb-circle-btn checked"
                            @onclick="() => SelectAll(photos.Select(x => x.Id))"
                            title="Select all">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#12161c" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>

                    <button type="button"
                            class="gallery-tb-circle-btn"
                            @onclick="DeselectAll"
                            title="Deselect all">
                    </button>

                    <button class="btn btn-danger btn-sm"
                            disabled="@(selectedIds.Count == 0 || isDeleting)"
                            @onclick="DeleteSelectedPhotos"
                            title="@(selectedIds.Count > 0 ? $"Delete {selectedIds.Count} selected" : "Delete selected")">
                        @if (isDeleting)
                        {
                            <div class="spinner-border spinner-border-sm text-white" style="width: 14px; height: 14px; margin: 0;" role="status"></div>
                        }
                        else
                        {
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                        }
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            id="gallery-cancel-multiselect-btn"
                            @onclick="CancelMultiSelect"
                            title="Cancel multi-selection">
                        <img src="/svg/close-bold-svgrepo-com.svg" class="btn-icon" /> Cancel
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                    </button>

                    <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 64 ? "disabled" : "")">
                        <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 64)" accept="image/png, image/jpeg, image/gif, image/webp" />
                        <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                    </label>
                    
                    <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard" disabled="@(imageCount >= 64)">
                        <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                    </button>
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (hasNetworkError)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/wifi-off-svgrepo-com.svg" class="icon-danger" style="width: 32px; height: 32px;" alt="Connection Error" />
                </div>
                <h5 class="text-white fw-bold mb-1">Connection Error</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">@errorMessage</p>
                <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2" @onclick="RetryLoadAsync" disabled="@isRefreshing">
                    @if (isRefreshing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                    }
                    <span>Retry</span>
                </button>
            </div>
        }
        else if (photos.Count == 0)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/image-svgrepo-com.svg" style="width: 32px; height: 32px; opacity: 0.6;" />
                </div>
                <h5 class="text-white fw-bold mb-1">No Photos Found</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">You haven't uploaded any gallery photos to VRChat yet. Upload a new photo to get started!</p>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(activeExpandedCardId))
            {
                <div class="card-action-backdrop" @onclick="CloseExpandedCard" @oncontextmenu="CloseExpandedCard" @oncontextmenu:preventDefault="true"></div>
            }

            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid grid-wide gap-3 @(!string.IsNullOrEmpty(activeExpandedCardId) ? "has-card-expanded" : "")" @onmouseup="HandleMouseUp">
                    @foreach (var photo in photos)
                    {
                        <div @key="photo.Id"
                             class="position-relative photo-card media-card-container @(IsSelected(photo) ? "border-selected" : "") @(activeExpandedCardId == photo.Id ? "card-expanded-active" : "") @(isMultiSelectMode && selectedIds.Contains(photo.Id) ? "is-selected" : "")"
                             style="cursor: pointer;"
                             @onmousedown="() => HandleMouseDown(photo.Id)"
                             @onmouseenter="() => HandleMouseEnter(photo.Id)"
                             @onclick="() => HandleCardClick(photo)"
                             @oncontextmenu="() => { if (!isMultiSelectMode) HandleCardContextMenu(photo.Id); }"
                             @oncontextmenu:preventDefault="true"
                             @onmouseleave="() => { if (!isMultiSelectMode) HandleCardMouseLeave(photo.Id); }">
                            <img src="@photo.ImageUrl" class="w-100 h-100 object-fit-cover" draggable="false" title="View Image" />

                            @* Multi-select trigger button (appears on right-click in top-right of the card as an unselected circle) *@
                            @if (!isMultiSelectMode && activeExpandedCardId == photo.Id)
                            {
                                <div class="gallery-multiselect-checkbox media-btn-multiselect-trigger"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => StartMultiSelect(photo.Id)"
                                     title="Select">
                                </div>
                            }

                            @* Multi-select mode checkbox indicator on each image card *@
                            @if (isMultiSelectMode)
                            {
                                <div class="gallery-multiselect-checkbox @(selectedIds.Contains(photo.Id) ? "checked" : "")"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => ToggleSelection(photo.Id)"
                                     title="@(selectedIds.Contains(photo.Id) ? "Deselect" : "Select")">
                                    @if (selectedIds.Contains(photo.Id))
                                    {
                                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="#12161c" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </div>
                            }

                            @* Standard card actions (hidden during multi-selection mode) *@
                            @if (!isMultiSelectMode)
                            {
                                <div class="media-card-actions">
                                    <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete" @onclick:stopPropagation="true" @onclick="() => DeletePhoto(photo)" title="Delete">
                                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                    </button>

                                    <button class="btn btn-sm rounded-circle btn-action media-btn-select @(IsSelected(photo) ? "selected" : "")" disabled="@IsSelected(photo)" @onclick:stopPropagation="true" @onclick="() => SetAsProfilePicture(photo)" title="@(IsSelected(photo) ? "Currently Active Profile Picture" : "Set as Profile Picture")">
                                        <img src="/svg/archive-minimalistic-svgrepo-com.svg" class="btn-icon icon-accent" style="margin: 0;" />
                                    </button>

                                    @if (activeExpandedCardId == photo.Id)
                                    {
                                        var highResUrl = photo.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-copy media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyImageToClipboardAsync(highResUrl)" title="Copy Image">
                                            <img src="/svg/copy-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-download media-btn-extra" @onclick:stopPropagation="true" @onclick='() => DownloadImageFileAsync(highResUrl, "photo_" + photo.Id)' title="Download">
                                            <img src="/svg/download-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-link media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyLinkToClipboardAsync(highResUrl)" title="Copy Link">
                                            <img src="/svg/link-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PhotoItem> photos = new();
    
    private static string PHOTOS_TAG = "gallery";
    private static string PHOTOS_MASK_TYPE = "square";

    public class PhotoItem
    {
        public string Id { get; set; }
        public string ImageUrl { get; set; }
    }

    private string selectedImageUrl;

    protected override int MaxImageCount => 64;

    protected override async Task LoadInitialDataAsync()
    {
        if (Auth.CurrentUser != null && string.IsNullOrEmpty(Auth.CurrentUser.ProfilePicOverride) && string.IsNullOrEmpty(Auth.CurrentUser.BannerUrl))
        {
            await Auth.HydrateUserProfileAsync(Auth.CurrentUser);
        }

        selectedImageUrl = !string.IsNullOrEmpty(Auth.CurrentUser?.ProfilePicOverride) 
            ? Auth.CurrentUser.ProfilePicOverride 
            : (!string.IsNullOrEmpty(Auth.CurrentUser?.BannerUrl) ? Auth.CurrentUser.BannerUrl : Auth.CurrentUser?.BannerCustomUrl);
        var cached = CacheService.Get<List<PhotoItem>>("Photos");
        if (cached != null)
        {
            photos = new List<PhotoItem>(cached);
            imageCount = CacheService.Get<int>("PhotosCount");
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }
    }

    protected override async Task RefreshList()
    {
        if (isRefreshing) return;
        
        isRefreshing = true;
        isLoading = true;
        hasNetworkError = false;
        errorMessage = "";
        photos.Clear();
        CacheService.Set("Photos", (List<PhotoItem>)null);
        StateHasChanged();

        try
        {
            var fileList = await apiRequest.GetFilesAsync(PHOTOS_TAG);
            imageCount = fileList.Count;
            CacheService.Set("PhotosCount", imageCount);

            foreach (var file in fileList)
            {
                photos.Add(new PhotoItem
                {
                    Id = file.Id,
                    ImageUrl = ApiRequest.ImageThumbnailUrl(file.Id)
                });
            }
            
            CacheService.Set("Photos", new List<PhotoItem>(photos));
            CacheService.Set("PhotosCount", imageCount);
        }
        catch (Exception ex)
        {
            hasNetworkError = true;
            errorMessage = !NetworkStatus.IsOnline 
                ? "No internet connection. Please check your network and try again." 
                : "Unable to reach VRChat servers. Please try again later.";
            Console.WriteLine($"Error loading photos: {ex.Message}");
            NotificationService.Show(errorMessage, "Connection Error", NotificationType.Error);
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void HandleCardClick(PhotoItem photo)
    {
        if (isMultiSelectMode)
        {
            if (!hasDragged)
            {
                ToggleSelection(photo.Id);
            }
            hasDragged = false;
        }
        else
        {
            OpenImage(photo);
        }
    }

    private async Task DeleteSelectedPhotos()
    {
        await DeleteSelectedItemsAsync(photos, p => p.Id, "Photo", "Photos", "PhotosCount", id => apiRequest.DeleteApiData(id));
    }

    private void OpenImage(PhotoItem item)
    {
        var viewerItems = photos.Select(p => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = p.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = p.ImageUrl,
            Title = "Photo"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        ViewerService.Open(new ImageViewerOptions
        {
            Items = viewerItems,
            StartIndex = index,
            ShowDownloadButton = true,
            ShowInfoButton = false,
            ShowUploadButton = false,
            ShowSelectButton = true,
            SelectButtonTitle = "Set as Profile Picture",
            IsItemSelected = (idx) => idx >= 0 && idx < photos.Count && IsSelected(photos[idx]),
            OnSelectRequested = async (idx) => {
                if (idx >= 0 && idx < photos.Count)
                {
                    await SetAsProfilePicture(photos[idx]);
                    StateHasChanged();
                }
            },
            OnDeleteRequested = async (idx) => await HandleViewerDelete(idx)
        });
    }

    private async Task DeletePhoto(PhotoItem item)
    {
        await ConfirmAndDeleteItemAsync(item, item.Id, "Photo", photos, "Photos", "PhotosCount", id => apiRequest.DeleteApiData(id));
    }

    private async Task OnEditorSave(string base64Result)
    {
        try
        {
            string tempPath = await SaveBase64ToTempFileAsync(base64Result, "upload_photo");
            await apiRequest.UploadImage(tempPath, PHOTOS_MASK_TYPE, TagType.Gallery, "");
            try { File.Delete(tempPath); } catch { }

            await RefreshList();
            editingBase64Image = null;
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private bool IsSelected(PhotoItem photo)
    {
        if (!string.IsNullOrEmpty(selectedImageUrl) && (selectedImageUrl == photo.ImageUrl || selectedImageUrl.Contains(photo.Id))) return true;
        if (!string.IsNullOrEmpty(Auth.CurrentUser?.ProfilePicOverride) && Auth.CurrentUser.ProfilePicOverride.Contains(photo.Id)) return true;
        if (!string.IsNullOrEmpty(Auth.CurrentUser?.BannerUrl) && Auth.CurrentUser.BannerUrl.Contains(photo.Id)) return true;
        if (!string.IsNullOrEmpty(Auth.CurrentUser?.BannerCustomUrl) && Auth.CurrentUser.BannerCustomUrl.Contains(photo.Id)) return true;
        return false;
    }

    private async Task SetAsProfilePicture(PhotoItem item)
    {
        if (IsSelected(item)) return;
        try
        {
            selectedImageUrl = item.ImageUrl; // Update UI immediately
            await apiRequest.SetProfilePicture(item.ImageUrl);
            if (Auth.CurrentUser != null) 
            {
                Auth.CurrentUser.ProfilePicOverride = item.ImageUrl;
                Auth.CurrentUser.ProfilePicOverrideThumbnail = item.ImageUrl;
                Auth.CurrentUser.BannerUrl = item.ImageUrl;
                Auth.CurrentUser.BannerCustomUrl = item.ImageUrl;
                Auth.CurrentUser.BannerType = "customImage";
            }
            Auth.NotifyAuthStateChanged();
            NotificationService.Show("Profile picture updated successfully!", "Success", NotificationType.Success);
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Error setting profile picture: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private async Task HandleViewerDelete(int index)
    {
        await HandleViewerDeleteAsync(index, photos, DeletePhoto);
    }
}
