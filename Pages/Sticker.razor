@page "/sticker"
@implements IDisposable
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using Newtonsoft.Json.Linq
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject VRCAuth Auth
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject DialogService dialogService
@inject FileDropService FileDropService

<div class="h-100 d-flex flex-column p-3 position-relative">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.ImageEditor Base64Image="@editingBase64Image" OnSave="OnEditorSave" OnCancel="OnEditorCancel" />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/sticker-smile-square-svgrepo-com.svg" class="media-page-icon" /> Sticker
                </h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (imageCount >= 18)
                {
                    <span class="badge bg-danger">Limit Reached (@imageCount/18)</span>
                }
                else
                {
                    <span class="text-white-50">@imageCount/18 Sticker</span>
                }
                
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                </button>

                <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 18 ? "disabled" : "")">
                    <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 18)" accept="image/png, image/jpeg, image/gif, image/webp" />
                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                </label>
                
                <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard" disabled="@(imageCount >= 18)">
                    <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid gap-3">
                    @foreach (var sticker in stickers)
                    {
                        <div class="position-relative sticker-card media-card-container">
                            <img src="@sticker.ImageUrl" class="w-100 h-100 object-fit-cover" />
                            
                            <button class="btn btn-dark btn-sm rounded-circle position-absolute btn-action media-btn-open" @onclick="() => OpenImage(sticker)" title="View Image">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                            
                            <button class="btn btn-danger btn-sm rounded-circle position-absolute btn-action media-btn-delete" @onclick="() => DeleteSticker(sticker)" title="Delete">
                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<VRCGalleryManager.Components.ImageViewer @ref="imageViewer" OnDeleteRequested="HandleViewerDelete" />

@code {
    private ApiRequest apiRequest;
    private bool isLoading = true;
    private bool isRefreshing = false;
    private int imageCount = 0;
    private List<StickerItem> stickers = new();
    private VRCGalleryManager.Components.ImageViewer imageViewer;
    
    private static List<StickerItem> cachedStickers = null;
    private static int cachedImageCount = 0;

    private string editingBase64Image = null;
    private bool isDragging = false;

    private static string STICKER_TAG = "sticker";
    private static string STICKER_MASK_TYPE = "square";

    public class StickerItem
    {
        public string Id { get; set; }
        public string ImageUrl { get; set; }
        public string FileUrl { get; set; }
    }

    [SupplyParameterFromQuery]
    public string uploadPath { get; set; }

    protected override async Task OnInitializedAsync()
    {
        FileDropService.OnDragEnter += HandleDragEnter;
        FileDropService.OnDragLeave += HandleDragLeave;
        FileDropService.OnFileDropped += HandleFileDropped;
        apiRequest = new ApiRequest(Auth);
        if (cachedStickers != null)
        {
            stickers = new List<StickerItem>(cachedStickers);
            imageCount = cachedImageCount;
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }

        if (!string.IsNullOrEmpty(uploadPath) && File.Exists(uploadPath))
        {
            await LoadLocalFileForEditing(uploadPath);
        }
    }

    private async Task RefreshList()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        isLoading = true;
        stickers.Clear();
        cachedStickers = null;
        StateHasChanged();

        try
        {
            var data = await apiRequest.GetApiData(STICKER_TAG);
            
            if (data?.JsonImage != null)
            {
                imageCount = data.JsonImage.Count;
                
                foreach (string json in data.JsonImage)
                {
                    JObject jsonObject = JObject.Parse(json);
                    string id = jsonObject["id"]?.ToString();
                    string fileId = jsonObject["metadata"]?["fileId"]?.ToString() ?? id; // Fallback to id
                    
                    stickers.Add(new StickerItem
                    {
                        Id = id,
                        ImageUrl = $"https://api.vrchat.cloud/api/1/image/{fileId}/1/256",
                        FileUrl = $"https://api.vrchat.cloud/api/1/file/{fileId}/1/file"
                    });
                }
            }
            
            cachedStickers = new List<StickerItem>(stickers);
            cachedImageCount = imageCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stickers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void OpenImage(StickerItem item)
    {
        var viewerItems = stickers.Select(s => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = s.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = s.ImageUrl,
            Title = "Sticker"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        imageViewer.Open(viewerItems, index);
    }

    private async Task DeleteSticker(StickerItem item)
    {
        bool confirm = await dialogService.ShowConfirmAsync("Delete Sticker", "Are you sure you want to delete this sticker?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                await apiRequest.DeleteApiData(item.Id);
                stickers.Remove(item);
                imageCount--;
                cachedStickers = new List<StickerItem>(stickers);
                cachedImageCount = imageCount;
                StateHasChanged();
                NotificationService.Show("Sticker deleted successfully.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show(ex.Message, "Delete Failed", NotificationType.Error);
            }
        }
    }

    private async Task OnDropFile(InputFileChangeEventArgs e)
    {
        isDragging = false;
        await OnInputFileChange(e);
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        if (imageCount >= 18) return;
        
        var file = e.File;
        if (file != null && file.ContentType.StartsWith("image/"))
        {
            await LoadFileForEditing(file);
        }
    }

    private async Task PasteFromClipboard()
    {
        if (imageCount >= 18) return;
        
        try
        {
            string savedPath = await ClipboardHandler.ClipboardDataImageOrLink();
            if (!string.IsNullOrEmpty(savedPath) && File.Exists(savedPath))
            {
                await LoadLocalFileForEditing(savedPath);
            }
            else
            {
                NotificationService.Show("No image found or invalid link in clipboard.", "Clipboard Empty", NotificationType.Info);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show(ex.Message, "Paste Error", NotificationType.Error);
        }
    }

    private async Task LoadFileForEditing(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            
            if (file.ContentType.Contains("gif", StringComparison.OrdinalIgnoreCase))
            {
                NotificationService.Show("Le GIF sono supportate solo per le Emoji. L'immagine è stata convertita in formato statico.", "Formato GIF convertito", NotificationType.Info);
            }
            byte[] bytes = memoryStream.ToArray();
            string base64String = Convert.ToBase64String(bytes);
            editingBase64Image = $"data:{file.ContentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading file: {ex.Message}");
        }
    }

    private async Task LoadLocalFileForEditing(string filePath)
    {
        try
        {
            byte[] bytes = await File.ReadAllBytesAsync(filePath);
            string contentType = GetContentType(filePath);

            if (contentType.Contains("gif", StringComparison.OrdinalIgnoreCase))
            {
                NotificationService.Show("Le GIF sono supportate solo per le Emoji. L'immagine è stata convertita in formato statico.", "Formato GIF convertito", NotificationType.Info);
            }

            string base64String = Convert.ToBase64String(bytes);
            editingBase64Image = $"data:{contentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading local file: {ex.Message}");
        }
    }
    
    private string GetContentType(string filePath)
    {
        string ext = Path.GetExtension(filePath).ToLower();
        return ext switch
        {
            ".png" => "image/png",
            ".jpg" => "image/jpeg",
            ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            _ => "image/png"
        };
    }

    private async Task OnEditorSave(string editedBase64)
    {
        try
        {
            string mimeType = "image/png";
            int semiColonIndex = editedBase64.IndexOf(";");
            if (editedBase64.StartsWith("data:") && semiColonIndex > 5)
            {
                mimeType = editedBase64.Substring(5, semiColonIndex - 5);
            }
            string ext = mimeType == "image/jpeg" ? ".jpg" : ".png";

            string base64Data = editedBase64.Substring(editedBase64.IndexOf(",") + 1);
            byte[] bytes = Convert.FromBase64String(base64Data);
            
            string tempFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
            Directory.CreateDirectory(tempFolder);
            string tempPath = Path.Combine(tempFolder, $"upload_sticker_{Guid.NewGuid()}{ext}");
            
            await File.WriteAllBytesAsync(tempPath, bytes);

            await apiRequest.UploadImage(tempPath, STICKER_MASK_TYPE, TagType.Sticker, null, 0, 0);

            try { File.Delete(tempPath); } catch { }

            await RefreshList();
            editingBase64Image = null;
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private void OnEditorCancel()
    {
        editingBase64Image = null;
    }

    public void Dispose()
    {
        FileDropService.OnDragEnter -= HandleDragEnter;
        FileDropService.OnDragLeave -= HandleDragLeave;
        FileDropService.OnFileDropped -= HandleFileDropped;
    }

    private void HandleDragEnter()
    {
        InvokeAsync(() =>
        {
            isDragging = true;
            StateHasChanged();
        });
    }

    private void HandleDragLeave()
    {
        InvokeAsync(() =>
        {
            isDragging = false;
            StateHasChanged();
        });
    }

    private void HandleFileDropped(string[] files)
    {
        InvokeAsync(async () =>
        {
            isDragging = false;
            if (files != null && files.Length > 0)
            {
                var filePath = files[0];
                string ext = System.IO.Path.GetExtension(filePath).ToLower();
                if (ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".webp" || ext == ".gif")
                {
                    await LoadLocalFileForEditing(filePath);
                }
            }
            StateHasChanged();
        });
    }
    private async Task HandleViewerDelete(int index)
    {
        var targetList = stickers;
        if (index >= 0 && index < targetList.Count)
        {
            var item = targetList[index];
            await DeleteSticker(item);
            if (!targetList.Contains(item))
            {
                imageViewer.Close();
            }
        }
    }
}


