@page "/sticker"
@inherits VRCGalleryManager.Core.Components.MediaPageBase
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<div class="h-100 d-flex flex-column p-3 position-relative">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.ImageEditor Base64Image="@editingBase64Image" OnSave="OnEditorSave" OnCancel="OnEditorCancel" />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/sticker-smile-square-svgrepo-com.svg" class="media-page-icon" /> Sticker
                    <span class="@(imageCount >= 18 ? "badge bg-danger fs-6 ms-2" : "text-white-50 fs-6 ms-2")">@imageCount/18</span>
                </h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                </button>

                <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 18 ? "disabled" : "")">
                    <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 18)" accept="image/png, image/jpeg, image/gif, image/webp" />
                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                </label>
                
                <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard" disabled="@(imageCount >= 18)">
                    <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (hasNetworkError)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/wifi-off-svgrepo-com.svg" class="icon-danger" style="width: 32px; height: 32px;" alt="Connection Error" />
                </div>
                <h5 class="text-white fw-bold mb-1">Connection Error</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">@errorMessage</p>
                <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2" @onclick="RetryLoadAsync" disabled="@isRefreshing">
                    @if (isRefreshing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                    }
                    <span>Retry</span>
                </button>
            </div>
        }
        else if (stickers.Count == 0)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/stars-svgrepo-com.svg" style="width: 32px; height: 32px; opacity: 0.6;" />
                </div>
                <h5 class="text-white fw-bold mb-1">No Stickers Found</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">You haven't uploaded any custom stickers to VRChat yet. Upload a new sticker to get started!</p>
            </div>
        }
        else
        {
            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid gap-3">
                    @foreach (var sticker in stickers)
                    {
                        <div class="position-relative sticker-card media-card-container">
                            <img src="@sticker.ImageUrl" class="w-100 h-100 object-fit-cover" />
                            
                            <button class="btn btn-dark btn-sm rounded-circle position-absolute btn-action media-btn-open" @onclick="() => OpenImage(sticker)" title="View Image">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                            
                            <button class="btn btn-danger btn-sm rounded-circle position-absolute btn-action media-btn-delete" @onclick="() => DeleteSticker(sticker)" title="Delete">
                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<StickerItem> stickers = new();
    
    private static string STICKER_TAG = "sticker";
    private static string STICKER_MASK_TYPE = "square";

    public class StickerItem
    {
        public string Id { get; set; }
        public string ImageUrl { get; set; }
        public string FileUrl { get; set; }
    }

    protected override int MaxImageCount => 18;

    protected override async Task LoadInitialDataAsync()
    {
        var cached = CacheService.Get<List<StickerItem>>("Stickers");
        if (cached != null)
        {
            stickers = new List<StickerItem>(cached);
            imageCount = CacheService.Get<int>("StickersCount");
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }
    }

    protected override async Task RefreshList()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        isLoading = true;
        hasNetworkError = false;
        errorMessage = "";
        stickers.Clear();
        CacheService.Set("Stickers", (List<StickerItem>)null);
        StateHasChanged();

        try
        {
            var stickerList = await apiRequest.GetStickersAsync();
            imageCount = stickerList.Count;
            CacheService.Set("StickersCount", imageCount);

            foreach (var item in stickerList)
            {
                string fileId = item.Metadata?.FileId ?? item.Id;
                string imgUrl = !string.IsNullOrEmpty(item.Metadata?.FileId)
                    ? ApiRequest.ImageThumbnailUrl(item.Metadata.FileId)
                    : item.ImageUrl;
                
                stickers.Add(new StickerItem
                {
                    Id = item.Id,
                    ImageUrl = imgUrl,
                    FileUrl = $"https://api.vrchat.cloud/api/1/file/{fileId}/1/file"
                });
            }
            
            CacheService.Set("Stickers", new List<StickerItem>(stickers));
            CacheService.Set("StickersCount", imageCount);
        }
        catch (Exception ex)
        {
            hasNetworkError = true;
            errorMessage = !NetworkStatus.IsOnline 
                ? "No internet connection. Please check your network and try again." 
                : "Unable to reach VRChat servers. Please try again later.";
            Console.WriteLine($"Error loading stickers: {ex.Message}");
            NotificationService.Show(errorMessage, "Connection Error", NotificationType.Error);
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void OpenImage(StickerItem item)
    {
        var viewerItems = stickers.Select(s => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = s.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = s.ImageUrl,
            Title = "Sticker"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        ViewerService.Open(new ImageViewerOptions
        {
            Items = viewerItems,
            StartIndex = index,
            ShowDownloadButton = true,
            ShowInfoButton = false,
            OnDeleteRequested = async (idx) => await HandleViewerDelete(idx)
        });
    }

    private async Task DeleteSticker(StickerItem item)
    {
        await ConfirmAndDeleteItemAsync(item, item.Id, "Sticker", stickers, "Stickers", "StickersCount", id => apiRequest.DeleteApiData(id));
    }

    private async Task OnEditorSave(string editedBase64)
    {
        try
        {
            string tempPath = await SaveBase64ToTempFileAsync(editedBase64, "upload_sticker");
            await apiRequest.UploadImage(tempPath, STICKER_MASK_TYPE, TagType.Sticker, null, 0, 0);
            try { File.Delete(tempPath); } catch { }

            await RefreshList();
            editingBase64Image = null;
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private async Task HandleViewerDelete(int index)
    {
        await HandleViewerDeleteAsync(index, stickers, DeleteSticker);
    }
}


