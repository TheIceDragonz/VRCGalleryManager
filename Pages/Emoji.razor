@page "/emoji"
@inherits VRCGalleryManager.Core.Components.MediaPageBase
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using Newtonsoft.Json.Linq
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<div class="h-100 d-flex flex-column p-3 position-relative">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.EmojiEditor Base64Image="@editingBase64Image" 
                OnSave="OnEditorSave" OnCancel="OnEditorCancel" />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/emoji-funny-circle-svgrepo-com.svg" class="media-page-icon" /> Emoji
                    <span class="@(imageCount >= 18 ? "badge bg-danger fs-6 ms-2" : "text-white-50 fs-6 ms-2")">@imageCount/18</span>
                </h3>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                </button>

                <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 18 ? "disabled" : "")">
                    <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 18)" accept="image/png, image/jpeg, image/gif, image/webp" />
                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                </label>
                
                <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard" disabled="@(imageCount >= 18)">
                    <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid gap-3">
                    @foreach (var emoji in emojis)
                    {
                        <div class="position-relative emoji-card media-card-container">
                            @if (emoji.IsAnimated)
                            {
                                <div class="spritesheet-animator w-100 h-100" 
                                     style="background-image: url('@emoji.FileUrl');"
                                     data-animated="true"
                                     data-frames="@emoji.Frames"
                                     data-fps="@emoji.FramesOverTime">
                                </div>
                            }
                            else
                            {
                                <img src="@emoji.ImageUrl" class="w-100 h-100 object-fit-cover" />
                            }
                            
                            <button class="btn btn-dark btn-sm rounded-circle position-absolute btn-action media-btn-open" @onclick="() => OpenImage(emoji)" title="View Image">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                            
                            <button class="btn btn-danger btn-sm rounded-circle position-absolute btn-action media-btn-delete" @onclick="() => DeleteEmoji(emoji)" title="Delete">
                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<VRCGalleryManager.Components.ImageViewer @ref="imageViewer" OnDeleteRequested="HandleViewerDelete" />

@code {
    private List<EmojiItem> emojis = new();
    private VRCGalleryManager.Components.ImageViewer imageViewer;
    


    private static string EMOJI_MASK_TAG = "square";

    public class EmojiItem
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string ImageUrl { get; set; }
        public string FileUrl { get; set; }
        public bool IsAnimated { get; set; }
        public int Frames { get; set; }
        public int FramesOverTime { get; set; }
    }

    protected override int MaxImageCount => 18;

    protected override async Task LoadInitialDataAsync()
    {
        var cached = CacheService.Get<List<EmojiItem>>("Emojis");
        if (cached != null)
        {
            emojis = new List<EmojiItem>(cached);
            imageCount = CacheService.Get<int>("EmojisCount");
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("spritesheetAnimator.initAll");
    }

    protected override async Task RefreshList()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        isLoading = true;
        emojis.Clear();
        CacheService.Set("Emojis", (List<EmojiItem>)null);
        StateHasChanged();

        try
        {
            var data = await apiRequest.GetApiData(TagType.Emoji.ToString().ToLower());
            
            if (data?.JsonImage != null)
            {
                imageCount = data.JsonImage.Count;
                CacheService.Set("EmojisCount", imageCount);
                
                foreach (string json in data.JsonImage)
                {
                    JObject jsonObject = JObject.Parse(json);
                    string id = jsonObject["id"]?.ToString();
                    string tags = jsonObject["tags"]?.ToString() ?? "";
                    bool isAnimated = tags.Contains("animated");
                    
                    int.TryParse(jsonObject["frames"]?.ToString(), out int frames);
                    int.TryParse(jsonObject["framesOverTime"]?.ToString(), out int framesOverTime);
                    if (frames <= 0) frames = 1;
                    if (framesOverTime <= 0) framesOverTime = 15;
                    
                    emojis.Add(new EmojiItem
                    {
                        Id = id,
                        Name = jsonObject["name"]?.ToString(),
                        IsAnimated = isAnimated,
                        Frames = frames,
                        FramesOverTime = framesOverTime,
                        ImageUrl = ApiRequest.ImageThumbnailUrl(id),
                        FileUrl = $"https://api.vrchat.cloud/api/1/file/{id}/1/file"
                    });
                }
            }
            
            CacheService.Set("Emojis", new List<EmojiItem>(emojis));
            CacheService.Set("EmojisCount", imageCount);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading emojis: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void OpenImage(EmojiItem item)
    {
        var viewerItems = emojis.Select(e => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = e.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = e.ImageUrl,
            Title = "Emoji"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        imageViewer.Open(viewerItems, index);
    }

    private async Task DeleteEmoji(EmojiItem item)
    {
        bool confirm = await dialogService.ShowConfirmAsync("Delete Emoji", "Are you sure you want to delete this emoji?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                await apiRequest.DeleteApiData(item.Id);
                emojis.Remove(item);
                imageCount--;
                CacheService.Set("Emojis", new List<EmojiItem>(emojis));
                CacheService.Set("EmojisCount", imageCount);
                StateHasChanged();
                NotificationService.Show("Emoji deleted successfully.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show(ex.Message, "Delete Failed", NotificationType.Error);
            }
        }
    }

    private async Task OnEditorSave((string Base64, bool IsAnimated, string AnimStyle, int Frames, int FramesOverTime) result)
    {
        try
        {
            string mimeType = "image/png";
            int semiColonIndex = result.Base64.IndexOf(";");
            if (result.Base64.StartsWith("data:") && semiColonIndex > 5)
            {
                mimeType = result.Base64.Substring(5, semiColonIndex - 5);
            }
            string ext = mimeType == "image/jpeg" ? ".jpg" : ".png";

            string base64Data = result.Base64.Substring(result.Base64.IndexOf(",") + 1);
            byte[] bytes = Convert.FromBase64String(base64Data);
            
            string tempFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
            Directory.CreateDirectory(tempFolder);
            string tempPath = Path.Combine(tempFolder, $"upload_emoji_{Guid.NewGuid()}{ext}");
            
            await File.WriteAllBytesAsync(tempPath, bytes);

            ApiRequest.ApiData emoji;
            if (result.IsAnimated)
            {
                emoji = await apiRequest.UploadImage(tempPath, EMOJI_MASK_TAG, TagType.EmojiAnimated, result.AnimStyle.ToLower(), result.Frames, result.FramesOverTime);
            }
            else
            {
                emoji = await apiRequest.UploadImage(tempPath, EMOJI_MASK_TAG, TagType.Emoji, result.AnimStyle?.ToLower() ?? "");
            }

            try { File.Delete(tempPath); } catch { }

            await Task.Delay(2000);
            await RefreshList();
            editingBase64Image = null;
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private async Task HandleViewerDelete(int index)
    {
        var targetList = emojis;
        if (index >= 0 && index < targetList.Count)
        {
            var item = targetList[index];
            await DeleteEmoji(item);
            if (!targetList.Contains(item))
            {
                imageViewer.Close();
            }
        }
    }
}


