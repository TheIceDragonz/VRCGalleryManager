@page "/emoji"
@inherits VRCGalleryManager.Core.Components.MediaPageBase
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.DTO
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<div class="h-100 d-flex flex-column p-3 position-relative @(isMultiSelectMode ? "gallery-multiselect-active" : "")" @onmouseup="HandleMouseUp" @onkeydown="HandleKeyDown" tabindex="0">
    
    @if (isDragging)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" 
             style="z-index: 999; background: rgba(106, 227, 249, 0.15); border: 3px dashed var(--accent); border-radius: var(--radius-lg); pointer-events: none;">
            <div class="text-accent fw-bold fs-3">
                Drop image here to upload
            </div>
        </div>
        
    }

    @if (editingBase64Image != null)
    {
        <div class="flex-grow-1 media-page-container">
            <VRCGalleryManager.Components.EmojiEditor Base64Image="@editingBase64Image" FileName="@editingFileName"
                OnSave="OnEditorSave" OnCancel="OnEditorCancel" />
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
            <div>
                <h3 class="mb-0 text-accent d-flex align-items-center gap-2">
                    <img src="/svg/emoji-funny-circle-svgrepo-com.svg" class="media-page-icon" /> Emoji
                    <span class="@(imageCount >= 18 ? "badge bg-danger fs-6 ms-2" : "text-white-50 fs-6 ms-2")">@imageCount/18</span>
                </h3>
            </div>
            @if (isMultiSelectMode)
            {
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <span class="gallery-multiselect-badge text-nowrap me-1">
                        <span class="badge-count-accent">@selectedIds.Count</span>
                        <span class="badge-count-sep">/</span>
                        <span class="badge-count-total">@emojis.Count</span>
                        <span class="badge-label">selected</span>
                    </span>

                    <button type="button"
                            class="gallery-tb-circle-btn checked"
                            @onclick="() => SelectAll(emojis.Select(x => x.Id))"
                            title="Select all">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#12161c" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>

                    <button type="button"
                            class="gallery-tb-circle-btn"
                            @onclick="DeselectAll"
                            title="Deselect all">
                    </button>

                    <button class="btn btn-danger btn-sm"
                            disabled="@(selectedIds.Count == 0 || isDeleting)"
                            @onclick="DeleteSelectedEmojis"
                            title="@(selectedIds.Count > 0 ? $"Delete {selectedIds.Count} selected" : "Delete selected")">
                        @if (isDeleting)
                        {
                            <div class="spinner-border spinner-border-sm text-white" style="width: 14px; height: 14px; margin: 0;" role="status"></div>
                        }
                        else
                        {
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                        }
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            id="gallery-cancel-multiselect-btn"
                            @onclick="CancelMultiSelect"
                            title="Cancel multi-selection">
                        <img src="/svg/close-bold-svgrepo-com.svg" class="btn-icon" /> Cancel
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshList" disabled="@isRefreshing" title="Refresh">
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isRefreshing ? "spin" : "")" style="margin: 0;" />
                    </button>

                    <label class="btn btn-secondary btn-sm m-0 @(imageCount >= 18 ? "disabled" : "")">
                        <InputFile OnChange="OnInputFileChange" class="d-none" disabled="@(imageCount >= 18)" accept="image/png, image/jpeg, image/gif, image/webp" />
                        <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Upload
                    </label>
                    
                    <button class="btn btn-secondary btn-sm" @onclick="PasteFromClipboard" disabled="@(imageCount >= 18)">
                        <img src="/svg/paste-svgrepo-com.svg" class="btn-icon" /> Paste
                    </button>
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="flex-grow-1 d-flex justify-content-center align-items-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (hasNetworkError)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/wifi-off-svgrepo-com.svg" class="icon-danger" style="width: 32px; height: 32px;" alt="Connection Error" />
                </div>
                <h5 class="text-white fw-bold mb-1">Connection Error</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">@errorMessage</p>
                <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2" @onclick="RetryLoadAsync" disabled="@isRefreshing">
                    @if (isRefreshing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                    }
                    <span>Retry</span>
                </button>
            </div>
        }
        else if (emojis.Count == 0)
        {
            <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
                <div class="p-3 mb-3 rounded-circle" style="background-color: var(--bg-active); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                    <img src="/svg/smile-svgrepo-com.svg" style="width: 32px; height: 32px; opacity: 0.6;" />
                </div>
                <h5 class="text-white fw-bold mb-1">No Emojis Found</h5>
                <p class="text-muted mb-3" style="max-width: 400px; font-size: 0.9rem;">You haven't uploaded any custom emojis or stickers to VRChat yet. Upload a new emoji to get started!</p>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(activeExpandedCardId))
            {
                <div class="card-action-backdrop" @onclick="CloseExpandedCard" @oncontextmenu="CloseExpandedCard" @oncontextmenu:preventDefault="true"></div>
            }

            <div class="flex-grow-1 overflow-auto">
                <div class="media-grid gap-3 @(!string.IsNullOrEmpty(activeExpandedCardId) ? "has-card-expanded" : "")" @onmouseup="HandleMouseUp">
                    @foreach (var emoji in emojis)
                    {
                        <div @key="emoji.Id"
                             class="position-relative emoji-card media-card-container @(activeExpandedCardId == emoji.Id ? "card-expanded-active" : "") @(isMultiSelectMode && selectedIds.Contains(emoji.Id) ? "is-selected" : "")"
                             style="cursor: pointer;"
                             @onmousedown="() => HandleMouseDown(emoji.Id)"
                             @onmouseenter="() => HandleMouseEnter(emoji.Id)"
                             @onclick="() => HandleCardClick(emoji)"
                             @oncontextmenu="() => { if (!isMultiSelectMode) HandleCardContextMenu(emoji.Id); }"
                             @oncontextmenu:preventDefault="true"
                             @onmouseleave="() => { if (!isMultiSelectMode) HandleCardMouseLeave(emoji.Id); }">
                            @if (emoji.IsAnimated)
                            {
                                <div class="spritesheet-animator w-100 h-100" 
                                     style="background-image: url('@emoji.FileUrl'); background-size: @(emoji.Frames <= 4 ? "200% 200%" : (emoji.Frames <= 16 ? "400% 400%" : "800% 800%"));"
                                     data-animated="true"
                                     data-frames="@emoji.Frames"
                                     data-fps="@emoji.FramesOverTime"
                                     data-cols="@(emoji.Frames <= 4 ? 2 : (emoji.Frames <= 16 ? 4 : 8))"
                                     title="View Image">
                                </div>
                            }
                            else
                            {
                                <img src="@emoji.ImageUrl" class="w-100 h-100 object-fit-cover" loading="lazy" draggable="false" title="View Image" />
                            }

                            @* Multi-select trigger button (appears on right-click in top-right of the card as an unselected circle) *@
                            @if (!isMultiSelectMode && activeExpandedCardId == emoji.Id)
                            {
                                <div class="gallery-multiselect-checkbox media-btn-multiselect-trigger"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => StartMultiSelect(emoji.Id)"
                                     title="Select">
                                </div>
                            }

                            @* Multi-select mode checkbox indicator on each image card *@
                            @if (isMultiSelectMode)
                            {
                                <div class="gallery-multiselect-checkbox @(selectedIds.Contains(emoji.Id) ? "checked" : "")"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => ToggleSelection(emoji.Id)"
                                     title="@(selectedIds.Contains(emoji.Id) ? "Deselect" : "Select")">
                                    @if (selectedIds.Contains(emoji.Id))
                                    {
                                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="#12161c" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </div>
                            }

                            @* Standard card actions (hidden during multi-selection mode) *@
                            @if (!isMultiSelectMode)
                            {
                                <div class="media-card-actions">
                                    <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete" @onclick:stopPropagation="true" @onclick="() => DeleteEmoji(emoji)" title="Delete">
                                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                    </button>

                                    @if (activeExpandedCardId == emoji.Id)
                                    {
                                        var targetUrl = !string.IsNullOrEmpty(emoji.FileUrl) ? emoji.FileUrl : emoji.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-copy media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyImageToClipboardAsync(targetUrl)" title="Copy Image">
                                            <img src="/svg/copy-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-download media-btn-extra" @onclick:stopPropagation="true" @onclick='() => DownloadImageFileAsync(targetUrl, emoji.IsAnimated ? $"emoji_{emoji.Id}_{emoji.Frames}frames_{emoji.FramesOverTime}fps" : "emoji_" + emoji.Id)' title="Download">
                                            <img src="/svg/download-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-link media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyLinkToClipboardAsync(targetUrl)" title="Copy Link">
                                            <img src="/svg/link-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<EmojiItem> emojis = new();
    
    private static string EMOJI_MASK_TAG = "square";

    public class EmojiItem
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string ImageUrl { get; set; }
        public string FileUrl { get; set; }
        public bool IsAnimated { get; set; }
        public int Frames { get; set; }
        public int FramesOverTime { get; set; }
    }

    protected override int MaxImageCount => 18;
    protected override bool SupportsAnimatedGif => true;

    protected override async Task LoadInitialDataAsync()
    {
        var cached = CacheService.Get<List<EmojiItem>>("Emojis");
        if (cached != null)
        {
            emojis = new List<EmojiItem>(cached);
            imageCount = CacheService.Get<int>("EmojisCount");
            isLoading = false;
        }
        else
        {
            await RefreshList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("spritesheetAnimator.initAll");
    }

    protected override async Task RefreshList()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        isLoading = true;
        hasNetworkError = false;
        errorMessage = "";
        emojis.Clear();
        CacheService.Set("Emojis", (List<EmojiItem>)null);
        StateHasChanged();

        try
        {
            var fileList = await apiRequest.GetFilesAsync("emoji");
            imageCount = fileList.Count;
            CacheService.Set("EmojisCount", imageCount);
            
            foreach (var file in fileList)
            {
                bool isAnimated = file.Tags != null && file.Tags.Contains("animated");
                int frames = file.Frames > 0 ? file.Frames : 1;
                int framesOverTime = file.FramesOverTime > 0 ? file.FramesOverTime : 15;
                
                emojis.Add(new EmojiItem
                {
                    Id = file.Id,
                    Name = file.Name,
                    IsAnimated = isAnimated,
                    Frames = frames,
                    FramesOverTime = framesOverTime,
                    ImageUrl = ApiRequest.ImageThumbnailUrl(file.Id),
                    FileUrl = $"https://api.vrchat.cloud/api/1/file/{file.Id}/1/file"
                });
            }
            
            CacheService.Set("Emojis", new List<EmojiItem>(emojis));
            CacheService.Set("EmojisCount", imageCount);
        }
        catch (Exception ex)
        {
            hasNetworkError = true;
            errorMessage = !NetworkStatus.IsOnline 
                ? "No internet connection. Please check your network and try again." 
                : "Unable to reach VRChat servers. Please try again later.";
            Console.WriteLine($"Error loading emojis: {ex.Message}");
            NotificationService.Show(errorMessage, "Connection Error", NotificationType.Error);
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void HandleCardClick(EmojiItem emoji)
    {
        if (isMultiSelectMode)
        {
            if (!hasDragged)
            {
                ToggleSelection(emoji.Id);
            }
            hasDragged = false;
        }
        else
        {
            OpenImage(emoji);
        }
    }

    private async Task DeleteSelectedEmojis()
    {
        await DeleteSelectedItemsAsync(emojis, e => e.Id, "Emoji", "Emojis", "EmojisCount", id => apiRequest.DeleteApiData(id));
    }

    private void OpenImage(EmojiItem item)
    {
        var viewerItems = emojis.Select(e => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
            HighResSource = e.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file"),
            LowResSource = e.ImageUrl,
            Title = e.IsAnimated ? $"emoji_{e.Id}_{e.Frames}frames_{e.FramesOverTime}fps" : $"emoji_{e.Id}"
        }).ToList();
        
        var currentUrl = item.ImageUrl.Replace("/image/", "/file/").Replace("/256", "/file");
        var index = viewerItems.FindIndex(i => i.HighResSource == currentUrl);
        if (index == -1) index = 0;
        
        ViewerService.Open(new ImageViewerOptions
        {
            Items = viewerItems,
            StartIndex = index,
            ShowDownloadButton = true,
            ShowInfoButton = false,
            ShowUploadButton = false,
            OnDeleteRequested = async (idx) => await HandleViewerDelete(idx)
        });
    }

    private async Task DeleteEmoji(EmojiItem item)
    {
        await ConfirmAndDeleteItemAsync(item, item.Id, "Emoji", emojis, "Emojis", "EmojisCount", id => apiRequest.DeleteApiData(id));
    }

    private async Task OnEditorSave((string Base64, bool IsAnimated, string AnimStyle, int Frames, int FramesOverTime) result)
    {
        try
        {
            string prefix = result.IsAnimated
                ? $"SpriteSheet_{result.Frames}frames_{result.FramesOverTime}fps"
                : "upload_emoji";
            string tempPath = await SaveBase64ToTempFileAsync(result.Base64, prefix);

            if (result.IsAnimated)
            {
                await apiRequest.UploadImage(tempPath, EMOJI_MASK_TAG, TagType.EmojiAnimated, result.AnimStyle.ToLower(), result.Frames, result.FramesOverTime);
            }
            else
            {
                await apiRequest.UploadImage(tempPath, EMOJI_MASK_TAG, TagType.Emoji, result.AnimStyle?.ToLower() ?? "");
            }

            try { File.Delete(tempPath); } catch { }

            await Task.Delay(2000);
            await RefreshList();
            editingBase64Image = null;
            editingFileName = null;
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Upload failed: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    private async Task HandleViewerDelete(int index)
    {
        await HandleViewerDeleteAsync(index, emojis, DeleteEmoji);
    }
}


