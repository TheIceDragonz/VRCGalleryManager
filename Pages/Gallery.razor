    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Config.Set("GalleryCurrentView", null);
            Config.Set("GallerySelectedWorldId", null);
            Config.Set("GallerySelectedWorldName", null);
        }
        catch { }

        var savedPhotoSort = Config.Get("GalleryPhotoSortBy", null);
        if (!string.IsNullOrEmpty(savedPhotoSort))
        {
            cachedPhotoSortBy = savedPhotoSort;
        }

        var path = Config.GetPath("PathGallery");
        if (string.IsNullOrEmpty(path) || !Directory.Exists(path))
        {
            var defaultVrc = FolderPickerHelper.GetDefaultVRChatPhotoPath();
            if (!string.IsNullOrEmpty(defaultVrc) && Directory.Exists(defaultVrc))
            {
                path = defaultVrc;
                Config.Set("PathGallery", path);
            }
        }

        if (!string.IsNullOrEmpty(path) && Directory.Exists(path))
        {
            if (cachedItems != null && cachedRootFolder == path)
            {
                RootFolder = cachedRootFolder;
                CurrentFolder = cachedCurrentFolder ?? cachedRootFolder;
                Items = cachedItems;
                _shouldRestoreScroll = true;
            }
            else
            {
                cachedItems = null;
                cachedWorldGroups = null;
                selectedWorld = null;
                RootFolder = path;
                CurrentFolder = path;
                await LoadFolderAsync();
            }

            if (currentView == GalleryView.Worlds)
            {
                if (cachedWorldGroups != null && cachedWorldGroups.Count > 0)
                {
                    worldGroups = cachedWorldGroups;
                }
                else
                {
                    var cachedList = BuildWorldGroupsFromMetadataCache(path);
                    if (cachedList.Count > 0)
                    {
                        worldGroups = cachedList;
                        cachedWorldGroups = worldGroups;
                        _ = LoadWorldDetailsAndCoversAsync();
                    }
                    _ = ScanWorldsAsync();
                }

                RestoreSelectedWorld();
            }

            PhotoWatcher.OnPhotoCaptured -= HandleLivePhotoCaptured;
            PhotoWatcher.OnPhotoCaptured += HandleLivePhotoCaptured;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRestoreScroll && !IsLoading)
        {
            _shouldRestoreScroll = false;
            string? keyToRestore = _pendingScrollKey;
            _pendingScrollKey = null;

            if (string.IsNullOrEmpty(keyToRestore))
            {
                if (currentView == GalleryView.Photos)
                {
                    keyToRestore = CurrentFolder;
                }
                else if (currentView == GalleryView.Worlds)
                {
                    keyToRestore = selectedWorld != null ? GetWorldScrollKey(selectedWorld) : WorldsScrollKey;
                }
            }

            if (!string.IsNullOrEmpty(keyToRestore))
            {
                try
                {
                    await JS.InvokeVoidAsync("restoreGalleryScroll", keyToRestore);
                }
                catch { }
            }
        }
    }

    // ── Navigation ────────────────────────────────────────────────────────
    private async Task GoBack()
    {
        if (currentView == GalleryView.Worlds)
        {
            if (selectedWorld != null)
            {
                await ExitSelectedWorld();
            }
            return;
        }

        if (!CanGoBack) return;
        SelectedImage = null;
        photoSearchQuery = string.Empty;
        if (!string.IsNullOrEmpty(CurrentFolder))
        {
            try { await JS.InvokeVoidAsync("saveGalleryScroll", CurrentFolder); } catch { }
        }
        var parent = Directory.GetParent(CurrentFolder);
        if (parent != null)
        {
            CurrentFolder = parent.FullName;
            await LoadFolderAsync();
        }
    }

    private async Task NavigateToFolder(string folderPath)
    {
        if (string.IsNullOrEmpty(folderPath) || !Directory.Exists(folderPath)) return;
        if (string.Equals(Path.GetFullPath(CurrentFolder).TrimEnd(Path.DirectorySeparatorChar),
                          Path.GetFullPath(folderPath).TrimEnd(Path.DirectorySeparatorChar),
                          StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        SelectedImage = null;
        photoSearchQuery = string.Empty;
        if (!string.IsNullOrEmpty(CurrentFolder))
        {
            try { await JS.InvokeVoidAsync("saveGalleryScroll", CurrentFolder); } catch { }
        }

        CurrentFolder = folderPath;
        await LoadFolderAsync();
    }

    private List<BreadcrumbItem> GetBreadcrumbs()
    {
        var result = new List<BreadcrumbItem>();
        if (string.IsNullOrEmpty(CurrentFolder)) return result;

        try
        {
            var currentFull = Path.GetFullPath(CurrentFolder).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            var rootFull = !string.IsNullOrEmpty(RootFolder)
                ? Path.GetFullPath(RootFolder).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                : null;

            if (rootFull != null && currentFull.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase))
            {
                var rootName = Path.GetFileName(rootFull);
                if (string.IsNullOrEmpty(rootName)) rootName = rootFull;

                result.Add(new BreadcrumbItem
                {
                    Name = rootName,
                    Path = rootFull,
                    IsCurrent = string.Equals(currentFull, rootFull, StringComparison.OrdinalIgnoreCase)
                });

                if (currentFull.Length > rootFull.Length)
                {
                    var relative = currentFull.Substring(rootFull.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                    var parts = relative.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);

                    var accumPath = rootFull;
                    for (int i = 0; i < parts.Length; i++)
                    {
                        accumPath = Path.Combine(accumPath, parts[i]);
                        result.Add(new BreadcrumbItem
                        {
                            Name = parts[i],
                            Path = accumPath,
                            IsCurrent = (i == parts.Length - 1)
                        });
                    }
                }
            }
            else
            {
                var parts = currentFull.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
                var rootDrive = Path.GetPathRoot(currentFull) ?? "";

                int vrcIndex = -1;
                for (int i = 0; i < parts.Length; i++)
                {
                    if (string.Equals(parts[i], "VRChat", StringComparison.OrdinalIgnoreCase))
                    {
                        vrcIndex = i;
                        break;
                    }
                }

                int startIndex = (vrcIndex >= 0) ? vrcIndex : Math.Max(0, parts.Length - 4);
                var accumPath = rootDrive.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                for (int i = 0; i < startIndex; i++)
                {
                    accumPath = string.IsNullOrEmpty(accumPath) ? parts[i] : Path.Combine(accumPath, parts[i]);
                }

                for (int i = startIndex; i < parts.Length; i++)
                {
                    accumPath = string.IsNullOrEmpty(accumPath) ? parts[i] : Path.Combine(accumPath, parts[i]);
                    result.Add(new BreadcrumbItem
                    {
                        Name = parts[i],
                        Path = accumPath,
                        IsCurrent = (i == parts.Length - 1)
                    });
                }
            }
        }
        catch
        {
            result.Clear();
            result.Add(new BreadcrumbItem
            {
                Name = Path.GetFileName(CurrentFolder) ?? CurrentFolder,
                Path = CurrentFolder,
                IsCurrent = true
            });
        }

        return result;
    }

    private async Task Refresh()
    {
        if (currentView == GalleryView.Photos)
        {
            await LoadFolderAsync();
        }
        else
        {
            await ScanWorldsAsync(forceRefresh: true);
        }
    }

    private async Task ChangeFolder()
    {
        try
        {
            string? startPath = !string.IsNullOrEmpty(CurrentFolder) && Directory.Exists(CurrentFolder)
                ? CurrentFolder
                : (!string.IsNullOrEmpty(RootFolder) && Directory.Exists(RootFolder) ? RootFolder : FolderPickerHelper.GetDefaultVRChatPhotoPath());

            var picked = await FolderPickerHelper.PickFolderAsync(startPath, "Select VRChat Screenshots Folder");
            if (!string.IsNullOrEmpty(picked) && Directory.Exists(picked))
            {
                try { await JS.InvokeVoidAsync("clearGalleryScroll"); } catch { }
                Config.Set("PathGallery", picked);
                RootFolder = picked;
                CurrentFolder = picked;
                cachedItems = null;
                cachedRootFolder = picked;
                cachedCurrentFolder = picked;
                SelectedImage = null;
                worldGroups.Clear();
                cachedWorldGroups = null;
                selectedWorld = null;
                var cachedList = BuildWorldGroupsFromMetadataCache(picked);
                if (cachedList.Count > 0)
                {
                    worldGroups = cachedList;
                    cachedWorldGroups = worldGroups;
                    _ = LoadWorldDetailsAndCoversAsync();
                }
                await LoadFolderAsync();
                _ = ScanWorldsAsync(forceRefresh: false);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Error selecting folder: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    // ── Folder Loading ─────────────────────────────────────────────────────
    private async Task LoadFolderAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        IsLoading = true;
        isMultiSelectMode = false;
        selectedPaths.Clear();
        _isMouseDown = false;
        _hasDragged = false;
        _dragStartPath = null;
        Items = new List<GalleryItem>();
        SelectedImage = null;
        StateHasChanged();

        if (string.IsNullOrEmpty(CurrentFolder) || !Directory.Exists(CurrentFolder))
        {
            IsLoading = false;
            StateHasChanged();
            return;
        }

        var dirs = Directory.GetDirectories(CurrentFolder);
        foreach (var dir in dirs)
        {
            if (token.IsCancellationRequested) break;
            int? count = null;
            try
            {
                count = Directory.EnumerateFiles(dir).Count(IsImageFile);
            }
            catch { }

            DateTime? dirDate = GetFolderDate(dir);

            Items.Add(new GalleryItem
            {
                IsFolder = true,
                Path = dir,
                Name = Path.GetFileName(dir),
                PhotoCount = count,
                FileDate = dirDate,
                IsThumbLoading = true
            });
        }

        try
        {
            var files = Directory.EnumerateFiles(CurrentFolder).Where(IsImageFile).ToList();
            foreach (var file in files)
            {
                if (token.IsCancellationRequested) break;
                DateTime? fileDate = null;
                string? worldName = null;
                string? worldId = null;

                if (MetadataScanCache.TryGet(file, out var meta) && meta != null)
                {
                    fileDate = meta.TakenAtUtc ?? meta.LastModifiedUtc;
                    worldName = meta.WorldName;
                    worldId = meta.WorldId;
                }

                if (!fileDate.HasValue)
                {
                    try { fileDate = File.GetCreationTime(file); } catch { }
                }

                Items.Add(new GalleryItem
                {
                    IsFolder = false,
                    Path = file,
                    Name = Path.GetFileName(file),
                    FileDate = fileDate,
                    WorldName = worldName,
                    WorldId = worldId,
                    IsThumbLoading = true
                });
            }
        }
        catch (Exception ex)
        {
            Items.Add(new GalleryItem
            {
                IsFolder = false,
                Path = "",
                Name = "Error: " + ex.Message,
                IsThumbLoading = false
            });
        }

        cachedItems = Items;
        cachedRootFolder = RootFolder;
        cachedCurrentFolder = CurrentFolder;

        IsLoading = false;
        _shouldRestoreScroll = true;
        StateHasChanged();

        _ = LoadThumbnailsAsync(token);
    }

    private async Task LoadThumbnailsAsync(CancellationToken token)
    {
        var snapshot = Items.ToList();
        if (snapshot.Count == 0) return;

        int degreeOfParallelism = Math.Clamp(Environment.ProcessorCount, 2, 6);
        var parallelOptions = new ParallelOptions
        {
            MaxDegreeOfParallelism = degreeOfParallelism,
            CancellationToken = token
        };

        long lastUpdateTicks = DateTime.UtcNow.Ticks;
        int completedCount = 0;

        try
        {
            await Parallel.ForEachAsync(snapshot, parallelOptions, async (item, ct) =>
            {
                try
                {
                    if (item.IsFolder)
                    {
                        var enumOptions = new EnumerationOptions
                        {
                            IgnoreInaccessible = true,
                            RecurseSubdirectories = true,
                            MaxRecursionDepth = 2
                        };
                        var imageFiles = Directory.EnumerateFiles(item.Path, "*", enumOptions)
                                                  .Where(IsImageFile)
                                                  .ToList();
                        item.PhotoCount = imageFiles.Count;
                        var firstImg = imageFiles.LastOrDefault();
                        if (!string.IsNullOrEmpty(firstImg))
                        {
                            item.ThumbnailBase64 = await MakeThumbnailBase64Async(firstImg, 256, ct);
                            if (!item.FileDate.HasValue)
                            {
                                try { item.FileDate = File.GetLastWriteTime(firstImg); } catch { }
                            }
                        }
                        item.IsThumbLoading = false;
                    }
                    else
                    {
                        item.ThumbnailBase64 = await MakeThumbnailBase64Async(item.Path, 256, ct);
                        item.IsThumbLoading = false;
                    }
                }
                catch
                {
                    item.IsThumbLoading = false;
                }

                int count = Interlocked.Increment(ref completedCount);
                long nowTicks = DateTime.UtcNow.Ticks;
                long prevTicks = Interlocked.Read(ref lastUpdateTicks);

                // Throttle StateHasChanged to at most once per 100ms or every 10 items
                if (count == snapshot.Count || count % 10 == 0 || (nowTicks - prevTicks) > TimeSpan.TicksPerMillisecond * 100)
                {
                    Interlocked.Exchange(ref lastUpdateTicks, nowTicks);
                    if (!ct.IsCancellationRequested)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            });
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static async Task<string> MakeThumbnailBase64Async(string path, int maxSize, CancellationToken token)
    {
        if (token.IsCancellationRequested) return null;
        try
        {
#if WINDOWS
            return await Task.Run(() =>
            {
#pragma warning disable CA1416
                using var image = SixLabors.ImageSharp.Image.Load<SixLabors.ImageSharp.PixelFormats.Rgba32>(path);
                if (image.Width <= maxSize && image.Height <= maxSize)
                {
                    using var ms = new MemoryStream();
                    image.SaveAsJpeg(ms);
                    return $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
                }
                
                var ratio = (double)maxSize / Math.Max(image.Width, image.Height);
                var width = (int)(image.Width * ratio);
                var height = (int)(image.Height * ratio);
                
                using var thumb = image.Clone(x => x.Resize(width, height, SixLabors.ImageSharp.Processing.KnownResamplers.Bicubic));
                
                using var ms2 = new MemoryStream();
                thumb.SaveAsJpeg(ms2);
                return $"data:image/jpeg;base64,{Convert.ToBase64String(ms2.ToArray())}";
#pragma warning restore CA1416
            }, token);
#else
            using var stream = File.OpenRead(path);
            var image = Microsoft.Maui.Graphics.Platform.PlatformImage.FromStream(stream);
            if (image != null)
            {
                if (image.Width <= maxSize && image.Height <= maxSize)
                {
                    using var ms = new MemoryStream();
                    image.Save(ms);
                    return $"data:image/png;base64,{Convert.ToBase64String(ms.ToArray())}";
                }

                var ratio = (double)maxSize / Math.Max(image.Width, image.Height);
                var width = (int)(image.Width * ratio);
                var height = (int)(image.Height * ratio);
                
                using var resized = image.Downsize((float)width, (float)height, true);
                using var ms2 = new MemoryStream();
                resized.Save(ms2);
                return $"data:image/png;base64,{Convert.ToBase64String(ms2.ToArray())}";
            }
            return null;
#endif
        }
        catch { return null; }
    }

