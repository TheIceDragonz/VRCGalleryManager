    private async Task SwitchGalleryView(GalleryView newView)
    {
        try
        {
            if (currentView == newView)
            {
                return;
            }

            try
            {
                if (currentView == GalleryView.Photos && !string.IsNullOrEmpty(CurrentFolder))
                {
                    await JS.InvokeVoidAsync("saveGalleryScroll", CurrentFolder);
                }
                else if (currentView == GalleryView.Worlds)
                {
                    string key = selectedWorld != null ? GetWorldScrollKey(selectedWorld) : WorldsScrollKey;
                    await JS.InvokeVoidAsync("saveGalleryScroll", key);
                }
            }
            catch { }

            currentView = newView;
            activeExpandedPath = null;

            if (newView == GalleryView.Worlds)
            {
                if (isMultiSelectMode) CancelMultiSelect();
                if (worldGroups.Count == 0 && !isScanningWorlds)
                {
                    var cachedList = BuildWorldGroupsFromMetadataCache(RootFolder);
                    if (cachedList.Count > 0)
                    {
                        worldGroups = cachedList;
                        cachedWorldGroups = worldGroups;
                        _ = LoadWorldDetailsAndCoversAsync();
                    }
                    _ = ScanWorldsAsync();
                }
                RestoreSelectedWorld();
                _pendingScrollKey = selectedWorld != null ? GetWorldScrollKey(selectedWorld) : WorldsScrollKey;
                _shouldRestoreScroll = true;
            }
            else if (newView == GalleryView.Photos)
            {
                _pendingScrollKey = CurrentFolder;
                _shouldRestoreScroll = true;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Gallery] Error in SwitchGalleryView: {ex.Message}");
        }
    }

    private List<WorldGroupItem> BuildWorldGroupsFromMetadataCache(string? rootFolder)
    {
        try
        {
            if (string.IsNullOrEmpty(rootFolder)) return new List<WorldGroupItem>();
            var cachedPhotos = MetadataScanCache.GetPhotosWithMetadata(rootFolder);
            if (cachedPhotos.Count == 0) return new List<WorldGroupItem>();

            var groupsDict = new Dictionary<string, WorldGroupItem>(StringComparer.OrdinalIgnoreCase);

            foreach (var p in cachedPhotos)
            {
                if (!File.Exists(p.Path)) continue;

                string worldId = p.WorldId?.Trim() ?? "";
                string worldName = p.WorldName?.Trim() ?? "";
                if (string.IsNullOrEmpty(worldName))
                {
                    worldName = !string.IsNullOrEmpty(worldId) ? worldId : "Unknown World";
                }

                string groupKey = !string.IsNullOrEmpty(worldId) ? worldId : $"name:{worldName}";
                if (!groupsDict.TryGetValue(groupKey, out var group))
                {
                    group = new WorldGroupItem
                    {
                        Name = worldName,
                        WorldId = !string.IsNullOrEmpty(worldId) ? worldId : null,
                        AuthorName = p.AuthorName
                    };
                    if (!string.IsNullOrEmpty(worldId))
                    {
                        var cachedInfo = WorldCacheHelper.Get(worldId);
                        if (cachedInfo != null)
                        {
                            if (!string.IsNullOrEmpty(cachedInfo.Name)) group.Name = cachedInfo.Name;
                            group.AuthorName = cachedInfo.AuthorName;
                            group.WorldImageUrl = cachedInfo.ImageUrl;
                        }
                    }
                    groupsDict[groupKey] = group;
                }

                DateTime? fileDate = p.TakenAtUtc ?? p.LastModifiedUtc;
                group.Photos.Add(new GalleryItem
                {
                    IsFolder = false,
                    Path = p.Path,
                    Name = Path.GetFileName(p.Path),
                    WorldName = worldName,
                    WorldId = worldId,
                    FileDate = fileDate
                });

                if (fileDate.HasValue && (!group.LastVisited.HasValue || fileDate.Value > group.LastVisited.Value))
                {
                    group.LastVisited = fileDate.Value;
                    group.CoverPath = p.Path;
                }
            }

            foreach (var g in groupsDict.Values)
            {
                g.Photos = g.Photos.OrderByDescending(ph => ph.FileDate ?? DateTime.MinValue).ToList();
                if (g.Photos.Count > 0 && string.IsNullOrEmpty(g.CoverPath))
                {
                    g.CoverPath = g.Photos[0].Path;
                }
            }

            return groupsDict.Values.OrderByDescending(w => w.Photos.Count).ThenBy(w => w.Name).ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Gallery] Error building world groups from cache: {ex.Message}");
            return new List<WorldGroupItem>();
        }
    }

    private async Task ScanWorldsAsync(bool forceRefresh = false)
    {
        if (string.IsNullOrEmpty(RootFolder) || !Directory.Exists(RootFolder))
        {
            worldGroups.Clear();
            return;
        }

        if (forceRefresh)
        {
            MetadataScanCache.Clear();
            cachedWorldGroups = null;
        }
        else if (worldGroups.Count == 0)
        {
            var fromCache = BuildWorldGroupsFromMetadataCache(RootFolder);
            if (fromCache.Count > 0)
            {
                worldGroups = fromCache;
                cachedWorldGroups = worldGroups;
                _ = LoadWorldDetailsAndCoversAsync();
                RestoreSelectedWorld();
                await InvokeAsync(StateHasChanged);
            }
        }

        isScanningWorlds = true;
        scannedCount = 0;
        totalFilesToScan = 0;
        await InvokeAsync(StateHasChanged);

        try
        {
            MetadataScanCache.EnsureLoaded();

            var allFiles = await Task.Run(() =>
            {
                try
                {
                    var enumOptions = new EnumerationOptions
                    {
                        IgnoreInaccessible = true,
                        RecurseSubdirectories = true,
                        MaxRecursionDepth = 5
                    };
                    return Directory.EnumerateFiles(RootFolder, "*", enumOptions)
                                    .Where(IsImageFile)
                                    .OrderByDescending(File.GetCreationTimeUtc)
                                    .ToList();
                }
                catch
                {
                    return new List<string>();
                }
            });

            totalFilesToScan = allFiles.Count;
            if (totalFilesToScan == 0)
            {
                worldGroups.Clear();
                cachedWorldGroups = worldGroups;
                return;
            }

            var groupsDict = new System.Collections.Concurrent.ConcurrentDictionary<string, WorldGroupItem>(StringComparer.OrdinalIgnoreCase);

            int degree = Math.Clamp(Environment.ProcessorCount, 2, 8);
            var parallelOptions = new ParallelOptions { MaxDegreeOfParallelism = degree };

            int processed = 0;
            long lastTicks = DateTime.UtcNow.Ticks;
            bool cacheModified = false;

            await Parallel.ForEachAsync(allFiles, parallelOptions, async (filePath, ct) =>
            {
                try
                {
                    var fileInfo = new FileInfo(filePath);
                    if (!fileInfo.Exists) return;

                    DateTime lastWrite = fileInfo.LastWriteTimeUtc;

                    string? worldId = null;
                    string? worldName = null;
                    string? authorName = null;
                    DateTime? fileDate = fileInfo.CreationTime;

                    if (!forceRefresh && MetadataScanCache.TryGet(filePath, out var cached) && cached != null && Math.Abs((cached.LastModifiedUtc - lastWrite).TotalSeconds) < 1)
                    {
                        if (cached.HasMetadata)
                        {
                            worldId = cached.WorldId;
                            worldName = cached.WorldName;
                            authorName = cached.AuthorName;
                            fileDate = cached.TakenAtUtc ?? fileInfo.CreationTime;
                        }
                    }
                    else
                    {
                        var meta = MetaDataImageReader.ExtractPhotoMetadata(filePath);
                        cacheModified = true;

                        if (meta?.World != null && (!string.IsNullOrWhiteSpace(meta.World.Id) || !string.IsNullOrWhiteSpace(meta.World.Name)))
                        {
                            worldId = meta.World.Id?.Trim();
                            worldName = meta.World.Name?.Trim();
                            authorName = meta.Author?.DisplayName?.Trim();

                            MetadataScanCache.Set(filePath, new CachedPhotoMetadata
                            {
                                Path = filePath,
                                LastModifiedUtc = lastWrite,
                                TakenAtUtc = fileInfo.CreationTimeUtc,
                                HasMetadata = true,
                                WorldId = worldId,
                                WorldName = worldName,
                                AuthorName = authorName
                            });
                        }
                        else
                        {
                            MetadataScanCache.Set(filePath, new CachedPhotoMetadata
                            {
                                Path = filePath,
                                LastModifiedUtc = lastWrite,
                                TakenAtUtc = fileInfo.CreationTimeUtc,
                                HasMetadata = false
                            });
                        }
                    }

                    if (!string.IsNullOrEmpty(worldId) || !string.IsNullOrEmpty(worldName))
                    {
                        if (string.IsNullOrEmpty(worldName))
                        {
                            worldName = !string.IsNullOrEmpty(worldId) ? worldId : "Unknown World";
                        }

                        string groupKey = !string.IsNullOrEmpty(worldId) ? worldId : $"name:{worldName}";

                        var worldGroup = groupsDict.GetOrAdd(groupKey, key =>
                        {
                            var item = new WorldGroupItem
                            {
                                Name = worldName,
                                WorldId = !string.IsNullOrEmpty(worldId) ? worldId : null,
                                AuthorName = authorName
                            };
                            if (!string.IsNullOrEmpty(worldId))
                            {
                                var cachedInfo = WorldCacheHelper.Get(worldId);
                                if (cachedInfo != null)
                                {
                                    if (!string.IsNullOrEmpty(cachedInfo.Name)) item.Name = cachedInfo.Name;
                                    item.AuthorName = cachedInfo.AuthorName;
                                    item.WorldImageUrl = cachedInfo.ImageUrl;
                                }
                            }
                            return item;
                        });

                        if (!string.IsNullOrEmpty(worldId) && string.IsNullOrEmpty(worldGroup.WorldId))
                        {
                            worldGroup.WorldId = worldId;
                        }
                        if (!string.IsNullOrEmpty(worldName) && (string.IsNullOrEmpty(worldGroup.Name) || worldGroup.Name == "Unknown World" || worldGroup.Name.StartsWith("wrld_")))
                        {
                            worldGroup.Name = worldName;
                        }

                        var photoItem = new GalleryItem
                        {
                            IsFolder = false,
                            Path = filePath,
                            Name = Path.GetFileName(filePath),
                            WorldName = worldName,
                            WorldId = worldId,
                            FileDate = fileDate
                        };

                        lock (worldGroup.Photos)
                        {
                            worldGroup.Photos.Add(photoItem);
                            if (!worldGroup.LastVisited.HasValue || (fileDate.HasValue && fileDate.Value > worldGroup.LastVisited.Value))
                            {
                                worldGroup.LastVisited = fileDate;
                                worldGroup.CoverPath = filePath;
                            }
                        }
                    }
                }
                catch { }

                int current = Interlocked.Increment(ref processed);
                long nowTicks = DateTime.UtcNow.Ticks;
                long prevTicks = Interlocked.Read(ref lastTicks);
                if (current == totalFilesToScan || (nowTicks - prevTicks) > TimeSpan.TicksPerMillisecond * 200)
                {
                    Interlocked.Exchange(ref lastTicks, nowTicks);
                    scannedCount = current;
                    await InvokeAsync(StateHasChanged);
                }
            });

            // Remove deleted files from cache
            var allFileSet = new HashSet<string>(allFiles, StringComparer.OrdinalIgnoreCase);
            var cachedUnderRoot = MetadataScanCache.GetAll()
                .Where(c => c.Path.StartsWith(RootFolder, StringComparison.OrdinalIgnoreCase))
                .ToList();
            foreach (var c in cachedUnderRoot)
            {
                if (!allFileSet.Contains(c.Path))
                {
                    MetadataScanCache.Remove(c.Path);
                    cacheModified = true;
                }
            }

            if (cacheModified)
            {
                MetadataScanCache.SaveIfDirty();
            }

            foreach (var group in groupsDict.Values)
            {
                group.Photos = group.Photos.OrderByDescending(p => p.FileDate ?? DateTime.MinValue).ToList();
                if (group.Photos.Count > 0 && string.IsNullOrEmpty(group.CoverPath))
                {
                    group.CoverPath = group.Photos[0].Path;
                }
            }

            worldGroups = groupsDict.Values.OrderByDescending(w => w.Photos.Count).ThenBy(w => w.Name).ToList();
            cachedWorldGroups = worldGroups;

            RestoreSelectedWorld();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error scanning worlds: {ex.Message}");
        }
        finally
        {
            isScanningWorlds = false;
            await InvokeAsync(StateHasChanged);
            _ = LoadWorldDetailsAndCoversAsync();
        }
    }

    private async Task LoadWorldDetailsAndCoversAsync()
    {
        isLoadingWorldDetails = true;
        try
        {
            var worldsToProcess = worldGroups
                .Where(w => !string.IsNullOrEmpty(w.WorldId) && w.WorldId.StartsWith("wrld_", StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (worldsToProcess.Count == 0) return;

            // Phase 1: Apply immediately from JSON cache (lightweight strings in memory, 0 network, 0 disk images)
            bool localChanged = false;
            foreach (var w in worldsToProcess)
            {
                var cached = WorldCacheHelper.Get(w.WorldId!);
                if (cached != null)
                {
                    if (string.IsNullOrEmpty(w.AuthorName) && !string.IsNullOrEmpty(cached.AuthorName))
                    {
                        w.AuthorName = cached.AuthorName;
                        localChanged = true;
                    }
                    if (string.IsNullOrEmpty(w.WorldImageUrl) && !string.IsNullOrEmpty(cached.ImageUrl))
                    {
                        w.WorldImageUrl = cached.ImageUrl;
                        localChanged = true;
                    }
                    if ((string.IsNullOrEmpty(w.Name) || w.Name.StartsWith("wrld_")) && !string.IsNullOrEmpty(cached.Name))
                    {
                        w.Name = cached.Name;
                        localChanged = true;
                    }
                }
            }
            if (localChanged)
            {
                await InvokeAsync(StateHasChanged);
            }

            // Phase 2: Fetch missing or outdated info from VRChat API (only worlds not already in JSON cache or cached with version 1, and not marked unavailable)
            var missingFromApi = worldsToProcess
                .Where(w => (string.IsNullOrEmpty(w.AuthorName) || string.IsNullOrEmpty(w.WorldImageUrl) || w.WorldImageUrl.Contains("/1/500")) && w.WorldImageUrl != "unavailable")
                .ToList();

            if (missingFromApi.Count > 0)
            {
                var parallelOptions = new ParallelOptions { MaxDegreeOfParallelism = 2 };
                long lastTicks = DateTime.UtcNow.Ticks;
                int count = 0;

                await Parallel.ForEachAsync(missingFromApi, parallelOptions, async (w, ct) =>
                {
                    try
                    {
                        var info = await WorldCacheHelper.FetchAndCacheAsync(w.WorldId!, Auth.ApiClient, ct);
                        if (info != null)
                        {
                            if (!string.IsNullOrEmpty(info.AuthorName)) w.AuthorName = info.AuthorName;
                            if (!string.IsNullOrEmpty(info.Name) && (string.IsNullOrEmpty(w.Name) || w.Name.StartsWith("wrld_")))
                            {
                                w.Name = info.Name;
                            }
                            if (!string.IsNullOrEmpty(info.ImageUrl))
                            {
                                w.WorldImageUrl = info.ImageUrl;
                            }
                        }
                        else
                        {
                            w.WorldImageUrl = "unavailable";
                        }
                    }
                    catch 
                    {
                        w.WorldImageUrl = "unavailable";
                    }

                    int c = Interlocked.Increment(ref count);
                    long nowTicks = DateTime.UtcNow.Ticks;
                    long prevTicks = Interlocked.Read(ref lastTicks);
                    if (c == missingFromApi.Count || c % 3 == 0 || (nowTicks - prevTicks) > TimeSpan.TicksPerMillisecond * 250)
                    {
                        Interlocked.Exchange(ref lastTicks, nowTicks);
                        await InvokeAsync(StateHasChanged);
                    }
                });

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Gallery] Error in LoadWorldDetailsAndCoversAsync: {ex.Message}");
        }
        finally
        {
            isLoadingWorldDetails = false;
            foreach (var w in worldGroups)
            {
                if (string.IsNullOrEmpty(w.WorldImageUrl))
                {
                    w.WorldImageUrl = "unavailable";
                }
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectWorld(WorldGroupItem world)
    {
