    private static bool IsImageFile(string filename)
    {
        var ext = Path.GetExtension(filename);
        return ext.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".jpeg", StringComparison.OrdinalIgnoreCase);
    }

    private string GetItemTooltip(GalleryItem item)
    {
        if (item.IsFolder)
        {
            var countStr = item.PhotoCount.HasValue
                ? (item.PhotoCount.Value == 1 ? "1 photo" : $"{item.PhotoCount.Value} photos")
                : null;
            var dateStr = item.FileDate.HasValue ? item.FileDate.Value.ToString("yyyy-MM-dd") : null;
            if (countStr != null && dateStr != null) return $"{item.Name} ({countStr} • {dateStr})";
            if (countStr != null) return $"{item.Name} ({countStr})";
            if (dateStr != null) return $"{item.Name} ({dateStr})";
            return item.Name;
        }
        return item.Name;
    }

