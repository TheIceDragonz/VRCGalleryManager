@page "/gallery"
@using System.IO
@using System.Threading
@using VRCGalleryManager.Core
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@inject VRCAuth Auth
@inject NavigationManager Nav
@inject DialogService dialogService
@inject NotificationService NotificationService
@inject ImageViewerService ViewerService
@inject IJSRuntime JS

<div class="h-100 d-flex flex-column p-3 @(isMultiSelectMode ? "gallery-multiselect-active" : "")" @onmouseup="HandleMouseUp">
    @* TOP TOOLBAR *@
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
        <div class="d-flex align-items-center text-truncate me-2">
            <h3 class="mb-0 text-accent d-flex align-items-center gap-2 text-nowrap">
                <img src="/svg/gallery-wide-svgrepo-com.svg" class="media-page-icon" /> Gallery
            </h3>
            @{
                var breadcrumbs = GetBreadcrumbs();
            }
            @if (breadcrumbs.Count > 0)
            {
                <nav class="gallery-breadcrumbs ms-3 d-flex align-items-center flex-nowrap" aria-label="breadcrumb">
                    @for (int i = 0; i < breadcrumbs.Count; i++)
                    {
                        var crumb = breadcrumbs[i];
                        if (i > 0)
                        {
                            <span class="gallery-breadcrumb-sep">/</span>
                        }
                        if (crumb.IsCurrent)
                        {
                            <span class="gallery-breadcrumb-item current text-truncate" title="@crumb.Path">
                                @crumb.Name
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="gallery-breadcrumb-item btn-link-crumb text-truncate"
                                    @onclick="() => NavigateToFolder(crumb.Path)"
                                    title="Go to @crumb.Name">
                                @crumb.Name
                            </button>
                        }
                    }
                </nav>
            }
            else if (!string.IsNullOrEmpty(CurrentFolder))
            {
                <span class="text-white-50 ms-3 small mb-0 text-truncate" style="max-width: 450px;" title="@CurrentFolder">@CurrentFolder</span>
            }
        </div>

        @if (isMultiSelectMode)
        {
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <span class="gallery-multiselect-badge text-nowrap me-1">
                    <span class="badge-count-accent">@selectedPaths.Count</span>
                    <span class="badge-count-sep">/</span>
                    <span class="badge-count-total">@(Items.Count(x => !x.IsFolder))</span>
                    <span class="badge-label">selected</span>
                </span>

                <button type="button"
                        class="gallery-tb-circle-btn checked"
                        @onclick="SelectAll"
                        title="Select all">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#12161c" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>

                <button type="button"
                        class="gallery-tb-circle-btn"
                        @onclick="DeselectAll"
                        title="Deselect all">
                </button>

                <button class="btn btn-danger btn-sm"
                        disabled="@(selectedPaths.Count == 0 || isDeleting)"
                        @onclick="DeleteSelectedItems"
                        title="@(selectedPaths.Count > 0 ? $"Delete {selectedPaths.Count} selected" : "Delete selected")">
                    @if (isDeleting)
                    {
                        <div class="spinner-border spinner-border-sm text-white" style="width: 14px; height: 14px; margin: 0;" role="status"></div>
                    }
                    else
                    {
                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                    }
                </button>

                <button class="btn btn-secondary btn-sm"
                        id="gallery-cancel-multiselect-btn"
                        @onclick="CancelMultiSelect"
                        title="Cancel multi-selection">
                    <img src="/svg/close-bold-svgrepo-com.svg" class="btn-icon" /> Cancel
                </button>
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack" disabled="@(!CanGoBack)" title="Go back">
                    <img src="/svg/back-arrow-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@IsLoading" title="Refresh">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(IsLoading ? "spin" : "")" style="margin: 0;" />
                </button>
                <button class="btn btn-secondary btn-sm" @onclick="ChangeFolder" title="Change folder">
                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" /> Change
                </button>
            </div>
        }
    </div>

    @* MAIN CONTENT *@
    <div class="flex-grow-1 overflow-hidden d-flex gap-3" @onclick="CloseUploadMenu">
        
        @* GRID *@
        <div class="flex-grow-1 overflow-auto h-100 pe-2 gallery-scroll-container" id="gallery-scroll-container" data-folder="@CurrentFolder">
            @if (string.IsNullOrEmpty(RootFolder) || !Directory.Exists(RootFolder))
            {
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                    <img src="/svg/folder-open-svgrepo-com.svg" class="mb-3 opacity-50 folder-svg-icon" />
                    <h5 class="text-white">No folder selected</h5>
                    <p>Click <strong>Change</strong> or select below to pick your VRChat screenshots folder.</p>
                    <button class="btn btn-primary mt-2 d-flex align-items-center gap-2" @onclick="ChangeFolder">
                        <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" /> Select Folder
                    </button>
                </div>
            }
            else if (Items.Count == 0 && !IsLoading)
            {
                <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                    <img src="/svg/folder-open-svgrepo-com.svg" class="mb-3 opacity-50 folder-svg-icon" />
                    <h5>This folder is empty</h5>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(activeExpandedPath))
                {
                    <div class="card-action-backdrop" @onclick="CloseExpandedCard" @oncontextmenu="CloseExpandedCard" @oncontextmenu:preventDefault="true"></div>
                }

                <div class="media-grid gap-3 pb-3 @(!string.IsNullOrEmpty(activeExpandedPath) ? "has-card-expanded" : "")" @onmouseup="HandleMouseUp">
                    @foreach (var item in Items)
                    {
                        <div @key="item.Path"
                             class="position-relative gallery-icon-card media-card-container @(item.IsFolder ? "gallery-folder-item" : "") @(activeExpandedPath == item.Path ? "card-expanded-active" : "") @(!item.IsFolder && isMultiSelectMode && selectedPaths.Contains(item.Path) ? "is-selected" : "")"
                             style="cursor: pointer;"
                             @onmousedown="() => HandleMouseDown(item)"
                             @onmouseenter="() => HandleMouseEnter(item)"
                             @onclick="() => HandleCardClick(item)"
                             @oncontextmenu="() => { if(!isMultiSelectMode) HandleCardContextMenu(item.Path); }"
                             @oncontextmenu:preventDefault="true"
                             @onmouseleave="() => { if(!isMultiSelectMode) HandleCardMouseLeave(item.Path); }"
                             title="@GetItemTooltip(item)">

                            @if (item.IsFolder)
                            {
                                <div class="w-100 h-100 d-flex flex-column" style="background-color: var(--bg-hover);">
                                    @if (!string.IsNullOrEmpty(item.ThumbnailBase64))
                                    {
                                        <img src="@item.ThumbnailBase64" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" style="filter: brightness(0.4);" draggable="false" />
                                    }
                                    <div class="folder-icon position-relative z-1" style="flex: 1; display: flex; align-items: center; justify-content: center;">
                                        @if (item.IsThumbLoading && string.IsNullOrEmpty(item.ThumbnailBase64))
                                        {
                                            <div class="spinner-border spinner-border-sm text-primary"></div>
                                        }
                                        else
                                        {
                                            <img src="/svg/folder-open-svgrepo-com.svg" class="folder-svg-icon" draggable="false" />
                                        }
                                    </div>
                                    <div class="media-card-label position-absolute w-100 text-truncate text-center z-2">
                                        @item.Name
                                    </div>
                                </div>

                                @* Folder action buttons (shown on right-click) *@
                                @if (!isMultiSelectMode && activeExpandedPath == item.Path)
                                {
                                    <div class="media-card-actions" style="z-index: 10;">
                                        <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteFolder(item)"
                                                title="Delete Folder">
                                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                        </button>

                                        <button class="btn btn-sm rounded-circle btn-action media-btn-folder media-btn-extra"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenInExplorer(item.Path)"
                                                title="Open in Explorer">
                                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(item.ThumbnailBase64))
                                {
                                    <img src="@item.ThumbnailBase64" class="w-100 h-100 object-fit-cover" draggable="false" />
                                }
                                else if (item.IsThumbLoading)
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <div class="spinner-border spinner-border-sm text-primary"></div>
                                    </div>
                                }

                                @* Multi-select trigger button (appears on right-click in top-right of the card as an unselected circle) *@
                                @if (!isMultiSelectMode && activeExpandedPath == item.Path)
                                {
                                    <div class="gallery-multiselect-checkbox media-btn-multiselect-trigger"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => StartMultiSelect(item.Path)"
                                         title="Select">
                                    </div>
                                }

                                @* Multi-select mode checkbox indicator on each image card *@
                                @if (isMultiSelectMode)
                                {
                                    <div class="gallery-multiselect-checkbox @(selectedPaths.Contains(item.Path) ? "checked" : "")"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => HandleCardClick(item)"
                                         title="@(selectedPaths.Contains(item.Path) ? "Deselect" : "Select")">
                                        @if (selectedPaths.Contains(item.Path))
                                        {
                                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="#12161c" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </div>
                                }

                                @* Standard card actions (hidden during multi-selection mode) *@
                                @if (!isMultiSelectMode && !string.IsNullOrEmpty(item.ThumbnailBase64))
                                {
                                    <div class="media-card-actions">
                                        <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete" @onclick:stopPropagation="true" @onclick="() => DeleteItem(item)" title="Delete">
                                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                        </button>

                                        <button class="btn btn-success btn-sm rounded-circle btn-action media-btn-upload" @onclick:stopPropagation="true" @onclick="() => { SelectedImage = item; ToggleUploadMenu(); }" title="Upload">
                                            <img src="/svg/add-circle-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>

                                        @if (activeExpandedPath == item.Path)
                                        {
                                            <button class="btn btn-sm rounded-circle btn-action media-btn-copy media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyImageToClipboardAsync(item.Path)" title="Copy Image">
                                                <img src="/svg/copy-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                            </button>
                                            <button class="btn btn-sm rounded-circle btn-action media-btn-folder media-btn-extra" @onclick:stopPropagation="true" @onclick="() => OpenInExplorer(item.Path)" title="Open Location">
                                                <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>


    </div>
</div>

@if (ShowUploadMenu)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center dialog-overlay" style="z-index: 20000;" @onclick="CloseUploadMenu">
        <div class="dialog-panel d-flex flex-column" @onclick:stopPropagation="true" style="min-width: 300px;">
            <div class="p-4 flex-grow-1 border-bottom border-secondary text-center">
                <h5 class="fw-bold text-white mb-2">Upload to...</h5>
                <p class="text-light mb-3 small">Select the category where you want to upload this image.</p>
                <img src="@(string.IsNullOrEmpty(SelectedImage.FullBase64) ? SelectedImage.ThumbnailBase64 : SelectedImage.FullBase64)" class="rounded shadow-sm" style="max-height: 200px; max-width: 100%; object-fit: contain;" alt="@SelectedImage.Name" />
            </div>
            <div class="p-3 d-flex flex-column gap-2 dialog-footer">
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Icons", "icons")'><img src="/svg/profile-user-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Icons</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Photos", "photos")'><img src="/svg/gallery-minimalistic-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Photos</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Emoji", "emoji")'><img src="/svg/emoji-funny-circle-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Emoji</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Sticker", "sticker")'><img src="/svg/sticker-smile-square-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Sticker</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Prints", "prints")'><img src="/svg/camera-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Prints</button>
                
                <button class="btn btn-danger mt-2 fw-bold" @onclick="CloseUploadMenu">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // ── State ─────────────────────────────────────────────────────────────
    private string RootFolder;
    private string CurrentFolder;
    private List<GalleryItem> Items = new();
    private GalleryItem SelectedImage;

    private static string cachedRootFolder = null;
    private static string cachedCurrentFolder = null;
    private static List<GalleryItem> cachedItems = null;

    private bool IsLoading;
    private bool ShowUploadMenu;
    private bool _shouldRestoreScroll = false;

    private CancellationTokenSource _cts;

    private bool isMultiSelectMode = false;
    private HashSet<string> selectedPaths = new();
    private bool _isMouseDown = false;
    private bool _hasDragged = false;
    private bool _dragSelectMode = true;
    private string? _dragStartPath = null;

    private bool CanGoBack =>
        !string.IsNullOrEmpty(CurrentFolder) &&
        !string.IsNullOrEmpty(RootFolder) &&
        Directory.Exists(CurrentFolder) &&
        Directory.Exists(RootFolder) &&
        !string.Equals(
            Path.GetFullPath(CurrentFolder).TrimEnd(Path.DirectorySeparatorChar),
            Path.GetFullPath(RootFolder).TrimEnd(Path.DirectorySeparatorChar),
            StringComparison.OrdinalIgnoreCase);

    // ── Model ─────────────────────────────────────────────────────────────
    public class BreadcrumbItem
    {
        public string Name { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
        public bool IsCurrent { get; set; }
    }

    public class GalleryItem
    {
        public bool IsFolder { get; set; }
        public string Path { get; set; }
        public string Name { get; set; }
        public string ThumbnailBase64 { get; set; }
        public string FullBase64 { get; set; }
        public bool IsThumbLoading { get; set; }
        public int? PhotoCount { get; set; }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var path = Config.GetPath("PathGallery");
        if (string.IsNullOrEmpty(path) || !Directory.Exists(path))
        {
            var defaultVrc = FolderPickerHelper.GetDefaultVRChatPhotoPath();
            if (!string.IsNullOrEmpty(defaultVrc) && Directory.Exists(defaultVrc))
            {
                path = defaultVrc;
                Config.Set("PathGallery", path);
            }
        }

        if (!string.IsNullOrEmpty(path) && Directory.Exists(path))
        {
            if (cachedItems != null && cachedRootFolder == path)
            {
                RootFolder = cachedRootFolder;
                CurrentFolder = cachedCurrentFolder ?? cachedRootFolder;
                Items = cachedItems;
                _shouldRestoreScroll = true;
            }
            else
            {
                RootFolder = path;
                CurrentFolder = path;
                await LoadFolderAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRestoreScroll && !IsLoading && !string.IsNullOrEmpty(CurrentFolder))
        {
            _shouldRestoreScroll = false;
            try
            {
                await JS.InvokeVoidAsync("restoreGalleryScroll", CurrentFolder);
            }
            catch { }
        }
    }

    // ── Navigation ────────────────────────────────────────────────────────
    private async Task GoBack()
    {
        if (!CanGoBack) return;
        SelectedImage = null;
        if (!string.IsNullOrEmpty(CurrentFolder))
        {
            try { await JS.InvokeVoidAsync("saveGalleryScroll", CurrentFolder); } catch { }
        }
        var parent = Directory.GetParent(CurrentFolder);
        if (parent != null)
        {
            CurrentFolder = parent.FullName;
            await LoadFolderAsync();
        }
    }

    private async Task NavigateToFolder(string folderPath)
    {
        if (string.IsNullOrEmpty(folderPath) || !Directory.Exists(folderPath)) return;
        if (string.Equals(Path.GetFullPath(CurrentFolder).TrimEnd(Path.DirectorySeparatorChar),
                          Path.GetFullPath(folderPath).TrimEnd(Path.DirectorySeparatorChar),
                          StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        SelectedImage = null;
        if (!string.IsNullOrEmpty(CurrentFolder))
        {
            try { await JS.InvokeVoidAsync("saveGalleryScroll", CurrentFolder); } catch { }
        }

        CurrentFolder = folderPath;
        await LoadFolderAsync();
    }

    private List<BreadcrumbItem> GetBreadcrumbs()
    {
        var result = new List<BreadcrumbItem>();
        if (string.IsNullOrEmpty(CurrentFolder)) return result;

        try
        {
            var currentFull = Path.GetFullPath(CurrentFolder).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            var rootFull = !string.IsNullOrEmpty(RootFolder)
                ? Path.GetFullPath(RootFolder).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                : null;

            if (rootFull != null && currentFull.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase))
            {
                var rootName = Path.GetFileName(rootFull);
                if (string.IsNullOrEmpty(rootName)) rootName = rootFull;

                result.Add(new BreadcrumbItem
                {
                    Name = rootName,
                    Path = rootFull,
                    IsCurrent = string.Equals(currentFull, rootFull, StringComparison.OrdinalIgnoreCase)
                });

                if (currentFull.Length > rootFull.Length)
                {
                    var relative = currentFull.Substring(rootFull.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                    var parts = relative.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);

                    var accumPath = rootFull;
                    for (int i = 0; i < parts.Length; i++)
                    {
                        accumPath = Path.Combine(accumPath, parts[i]);
                        result.Add(new BreadcrumbItem
                        {
                            Name = parts[i],
                            Path = accumPath,
                            IsCurrent = (i == parts.Length - 1)
                        });
                    }
                }
            }
            else
            {
                var parts = currentFull.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
                var rootDrive = Path.GetPathRoot(currentFull) ?? "";

                int vrcIndex = -1;
                for (int i = 0; i < parts.Length; i++)
                {
                    if (string.Equals(parts[i], "VRChat", StringComparison.OrdinalIgnoreCase))
                    {
                        vrcIndex = i;
                        break;
                    }
                }

                int startIndex = (vrcIndex >= 0) ? vrcIndex : Math.Max(0, parts.Length - 4);
                var accumPath = rootDrive.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                for (int i = 0; i < startIndex; i++)
                {
                    accumPath = string.IsNullOrEmpty(accumPath) ? parts[i] : Path.Combine(accumPath, parts[i]);
                }

                for (int i = startIndex; i < parts.Length; i++)
                {
                    accumPath = string.IsNullOrEmpty(accumPath) ? parts[i] : Path.Combine(accumPath, parts[i]);
                    result.Add(new BreadcrumbItem
                    {
                        Name = parts[i],
                        Path = accumPath,
                        IsCurrent = (i == parts.Length - 1)
                    });
                }
            }
        }
        catch
        {
            result.Clear();
            result.Add(new BreadcrumbItem
            {
                Name = Path.GetFileName(CurrentFolder) ?? CurrentFolder,
                Path = CurrentFolder,
                IsCurrent = true
            });
        }

        return result;
    }

    private async Task Refresh() => await LoadFolderAsync();

    private async Task ChangeFolder()
    {
        try
        {
            string? startPath = !string.IsNullOrEmpty(CurrentFolder) && Directory.Exists(CurrentFolder)
                ? CurrentFolder
                : (!string.IsNullOrEmpty(RootFolder) && Directory.Exists(RootFolder) ? RootFolder : FolderPickerHelper.GetDefaultVRChatPhotoPath());

            var picked = await FolderPickerHelper.PickFolderAsync(startPath, "Select VRChat Screenshots Folder");
            if (!string.IsNullOrEmpty(picked) && Directory.Exists(picked))
            {
                try { await JS.InvokeVoidAsync("clearGalleryScroll"); } catch { }
                Config.Set("PathGallery", picked);
                RootFolder = picked;
                CurrentFolder = picked;
                cachedItems = null;
                cachedRootFolder = picked;
                cachedCurrentFolder = picked;
                SelectedImage = null;
                await LoadFolderAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Error selecting folder: {ex.Message}", "Error", NotificationType.Error);
        }
    }

    // ── Folder Loading ─────────────────────────────────────────────────────
    private async Task LoadFolderAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        IsLoading = true;
        isMultiSelectMode = false;
        selectedPaths.Clear();
        _isMouseDown = false;
        _hasDragged = false;
        _dragStartPath = null;
        Items = new List<GalleryItem>();
        SelectedImage = null;
        StateHasChanged();

        if (string.IsNullOrEmpty(CurrentFolder) || !Directory.Exists(CurrentFolder))
        {
            IsLoading = false;
            StateHasChanged();
            return;
        }

        var dirs = Directory.GetDirectories(CurrentFolder);
        foreach (var dir in dirs)
        {
            if (token.IsCancellationRequested) break;
            int? count = null;
            try
            {
                count = Directory.EnumerateFiles(dir).Count(IsImageFile);
            }
            catch { }

            Items.Add(new GalleryItem
            {
                IsFolder = true,
                Path = dir,
                Name = Path.GetFileName(dir),
                PhotoCount = count,
                IsThumbLoading = true
            });
        }

        try
        {
            var files = Directory.EnumerateFiles(CurrentFolder).Where(IsImageFile).ToList();
            foreach (var file in files)
            {
                if (token.IsCancellationRequested) break;
                Items.Add(new GalleryItem
                {
                    IsFolder = false,
                    Path = file,
                    Name = Path.GetFileName(file),
                    IsThumbLoading = true
                });
            }
        }
        catch (Exception ex)
        {
            Items.Add(new GalleryItem
            {
                IsFolder = false,
                Path = "",
                Name = "Error: " + ex.Message,
                IsThumbLoading = false
            });
        }

        cachedItems = Items;
        cachedRootFolder = RootFolder;
        cachedCurrentFolder = CurrentFolder;

        IsLoading = false;
        _shouldRestoreScroll = true;
        StateHasChanged();

        _ = LoadThumbnailsAsync(token);
    }

    private async Task LoadThumbnailsAsync(CancellationToken token)
    {
        var snapshot = Items.ToList();
        if (snapshot.Count == 0) return;

        int degreeOfParallelism = Math.Clamp(Environment.ProcessorCount, 2, 6);
        var parallelOptions = new ParallelOptions
        {
            MaxDegreeOfParallelism = degreeOfParallelism,
            CancellationToken = token
        };

        long lastUpdateTicks = DateTime.UtcNow.Ticks;
        int completedCount = 0;

        try
        {
            await Parallel.ForEachAsync(snapshot, parallelOptions, async (item, ct) =>
            {
                try
                {
                    if (item.IsFolder)
                    {
                        var enumOptions = new EnumerationOptions
                        {
                            IgnoreInaccessible = true,
                            RecurseSubdirectories = true,
                            MaxRecursionDepth = 2
                        };
                        var imageFiles = Directory.EnumerateFiles(item.Path, "*", enumOptions)
                                                  .Where(IsImageFile)
                                                  .ToList();
                        item.PhotoCount = imageFiles.Count;
                        var firstImg = imageFiles.LastOrDefault();
                        if (!string.IsNullOrEmpty(firstImg))
                        {
                            item.ThumbnailBase64 = await MakeThumbnailBase64Async(firstImg, 256, ct);
                        }
                        item.IsThumbLoading = false;
                    }
                    else
                    {
                        item.ThumbnailBase64 = await MakeThumbnailBase64Async(item.Path, 256, ct);
                        item.IsThumbLoading = false;
                    }
                }
                catch
                {
                    item.IsThumbLoading = false;
                }

                int count = Interlocked.Increment(ref completedCount);
                long nowTicks = DateTime.UtcNow.Ticks;
                long prevTicks = Interlocked.Read(ref lastUpdateTicks);

                // Throttle StateHasChanged to at most once per 100ms or every 10 items
                if (count == snapshot.Count || count % 10 == 0 || (nowTicks - prevTicks) > TimeSpan.TicksPerMillisecond * 100)
                {
                    Interlocked.Exchange(ref lastUpdateTicks, nowTicks);
                    if (!ct.IsCancellationRequested)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            });
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static async Task<string> MakeThumbnailBase64Async(string path, int maxSize, CancellationToken token)
    {
        if (token.IsCancellationRequested) return null;
        try
        {
#if WINDOWS
            return await Task.Run(() =>
            {
#pragma warning disable CA1416
                using var image = SixLabors.ImageSharp.Image.Load<SixLabors.ImageSharp.PixelFormats.Rgba32>(path);
                if (image.Width <= maxSize && image.Height <= maxSize)
                {
                    using var ms = new MemoryStream();
                    image.SaveAsJpeg(ms);
                    return $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
                }
                
                var ratio = (double)maxSize / Math.Max(image.Width, image.Height);
                var width = (int)(image.Width * ratio);
                var height = (int)(image.Height * ratio);
                
                using var thumb = image.Clone(x => x.Resize(width, height, SixLabors.ImageSharp.Processing.KnownResamplers.Bicubic));
                
                using var ms2 = new MemoryStream();
                thumb.SaveAsJpeg(ms2);
                return $"data:image/jpeg;base64,{Convert.ToBase64String(ms2.ToArray())}";
#pragma warning restore CA1416
            }, token);
#else
            using var stream = File.OpenRead(path);
            var image = Microsoft.Maui.Graphics.Platform.PlatformImage.FromStream(stream);
            if (image != null)
            {
                if (image.Width <= maxSize && image.Height <= maxSize)
                {
                    using var ms = new MemoryStream();
                    image.Save(ms);
                    return $"data:image/png;base64,{Convert.ToBase64String(ms.ToArray())}";
                }

                var ratio = (double)maxSize / Math.Max(image.Width, image.Height);
                var width = (int)(image.Width * ratio);
                var height = (int)(image.Height * ratio);
                
                using var resized = image.Downsize((float)width, (float)height, true);
                using var ms2 = new MemoryStream();
                resized.Save(ms2);
                return $"data:image/png;base64,{Convert.ToBase64String(ms2.ToArray())}";
            }
            return null;
#endif
        }
        catch { return null; }
    }

