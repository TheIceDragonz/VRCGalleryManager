                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Photos", "photos")'><img src="/svg/gallery-minimalistic-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Photos</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Emoji", "emoji")'><img src="/svg/emoji-funny-circle-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Emoji</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Sticker", "sticker")'><img src="/svg/sticker-smile-square-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Sticker</button>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2" @onclick='() => UploadForCategory("Prints", "prints")'><img src="/svg/camera-svgrepo-com.svg" class="icon-accent" style="width:20px;height:20px;" /> Prints</button>
                
                <button class="btn btn-danger mt-2 fw-bold" @onclick="CloseUploadMenu">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // ── View Mode ─────────────────────────────────────────────────────────
    public enum GalleryView
    {
        Photos,
        Worlds
    }

    private static GalleryView cachedCurrentView = GalleryView.Photos;
    private const string WorldsScrollKey = "__worlds_overview__";
    private string? _pendingScrollKey = null;

    private static WorldGroupItem? cachedSelectedWorld = null;
    private static string? cachedSelectedWorldId = null;
    private static string? cachedSelectedWorldName = null;

    private GalleryView currentView
    {
        get => cachedCurrentView;
        set => cachedCurrentView = value;
    }

    private WorldGroupItem? selectedWorld
    {
        get => cachedSelectedWorld;
        set
        {
            if (cachedSelectedWorld != null && value == null)
            {
                _pendingScrollKey = WorldsScrollKey;
                _shouldRestoreScroll = true;
            }
            cachedSelectedWorld = value;
            cachedSelectedWorldId = value?.WorldId;
            cachedSelectedWorldName = value?.Name;
        }
    }

    private string GetWorldScrollKey(WorldGroupItem? world)
    {
        if (world == null) return "__world_none__";
        return !string.IsNullOrEmpty(world.WorldId) ? $"__world_{world.WorldId}__" : $"__world_name_{world.Name}__";
    }

    private async Task ExitSelectedWorld()
    {
        try
        {
            if (selectedWorld != null)
            {
                try
                {
                    await JS.InvokeVoidAsync("saveGalleryScroll", GetWorldScrollKey(selectedWorld));
                }
                catch { }

                selectedWorld = null;
                _pendingScrollKey = WorldsScrollKey;
                _shouldRestoreScroll = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Gallery] Error in ExitSelectedWorld: {ex.Message}");
        }
    }

    private void RestoreSelectedWorld()
    {
        try
        {
            if (worldGroups.Count == 0) return;

            if (selectedWorld != null)
            {
                var match = worldGroups.FirstOrDefault(w =>
                    (!string.IsNullOrEmpty(selectedWorld.WorldId) && !string.IsNullOrEmpty(w.WorldId) && string.Equals(w.WorldId, selectedWorld.WorldId, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(selectedWorld.Name) && !string.IsNullOrEmpty(w.Name) && string.Equals(w.Name, selectedWorld.Name, StringComparison.OrdinalIgnoreCase)));
                if (match != null)
                {
                    selectedWorld = match;
                }
                _ = LoadWorldPhotosThumbnailsAsync(selectedWorld);
                return;
            }

            var savedId = cachedSelectedWorldId;
            var savedName = cachedSelectedWorldName;

            if (!string.IsNullOrEmpty(savedId) || !string.IsNullOrEmpty(savedName))
            {
                var match = worldGroups.FirstOrDefault(w =>
                    (!string.IsNullOrEmpty(savedId) && !string.IsNullOrEmpty(w.WorldId) && string.Equals(w.WorldId, savedId, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(savedName) && !string.IsNullOrEmpty(w.Name) && string.Equals(w.Name, savedName, StringComparison.OrdinalIgnoreCase)));
                if (match != null)
                {
                    selectedWorld = match;
                    _ = LoadWorldPhotosThumbnailsAsync(match);
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Gallery] Error restoring selected world: {ex.Message}");
        }
    }

    private List<WorldGroupItem> worldGroups = new();
    private static List<WorldGroupItem>? cachedWorldGroups = null;
    private bool isScanningWorlds = false;
    private bool isLoadingWorldDetails = false;
    private string worldSearchQuery = string.Empty;
    private static string cachedWorldSortBy = "count";
    private string worldSortBy
    {
        get => cachedWorldSortBy;
        set => cachedWorldSortBy = value;
    }
    private bool isSortDropdownOpen = false;
    private void ToggleSortDropdown() => isSortDropdownOpen = !isSortDropdownOpen;
    private void CloseSortDropdown() => isSortDropdownOpen = false;
    private void SelectSort(string sortBy)
    {
        worldSortBy = sortBy;
        isSortDropdownOpen = false;
    }
    private string GetSortLabel(string sortKey) => sortKey switch
    {
        "recent" => "Recently Visited",
        "name" => "Name (A-Z)",
        _ => "Most Photos"
    };

    private static string cachedPhotoSortBy = "newest";
    private string photoSortBy
    {
        get => cachedPhotoSortBy;
        set
        {
            cachedPhotoSortBy = value;
            try { Config.Set("GalleryPhotoSortBy", value); } catch { }
        }
    }
    private bool isPhotoSortDropdownOpen = false;
    private void TogglePhotoSortDropdown() => isPhotoSortDropdownOpen = !isPhotoSortDropdownOpen;
    private void ClosePhotoSortDropdown() => isPhotoSortDropdownOpen = false;
    private void SelectPhotoSort(string sortBy)
    {
        photoSortBy = sortBy;
        isPhotoSortDropdownOpen = false;
    }
    private string GetPhotoSortLabel(string sortKey) => sortKey switch
    {
        "oldest" => "Oldest First",
        "name" => "Name (A-Z)",
        _ => "Newest First"
    };

    private string photoSearchQuery = string.Empty;

    private int FilteredFolderCount => FilteredItems.Count(x => x.IsFolder);
    private int FilteredPhotoCount => FilteredItems.Count(x => !x.IsFolder);

    private List<GalleryItem> FilteredItems
    {
        get
        {
            var folders = Items.Where(x => x.IsFolder);
            var files = Items.Where(x => !x.IsFolder);

            folders = photoSortBy switch
            {
                "oldest" => folders.OrderBy(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name),
                "name" => folders.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
                _ => folders.OrderByDescending(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name)
            };

            files = photoSortBy switch
            {
                "oldest" => files.OrderBy(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name),
                "name" => files.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase),
                _ => files.OrderByDescending(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name)
            };

            return folders.Concat(files).ToList();
        }
    }

    private List<GalleryItem> SortedSelectedWorldPhotos
    {
        get
        {
            if (selectedWorld == null) return new List<GalleryItem>();
            IEnumerable<GalleryItem> query = selectedWorld.Photos;
            return photoSortBy switch
            {
                "oldest" => query.OrderBy(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name).ToList(),
                "name" => query.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                _ => query.OrderByDescending(x => x.FileDate ?? DateTime.MinValue).ThenBy(x => x.Name).ToList()
            };
        }
    }

    private int scannedCount = 0;
    private int totalFilesToScan = 0;

    private List<WorldGroupItem> FilteredWorlds
    {
        get
        {
            IEnumerable<WorldGroupItem> query = worldGroups;
            if (!string.IsNullOrWhiteSpace(worldSearchQuery))
            {
                var term = worldSearchQuery.Trim();
                var termWithoutBy = term.StartsWith("by ", StringComparison.OrdinalIgnoreCase) ? term[3..].Trim() : term;
                query = query.Where(w => w.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         (!string.IsNullOrEmpty(w.AuthorName) && (w.AuthorName.Contains(term, StringComparison.OrdinalIgnoreCase) || w.AuthorName.Contains(termWithoutBy, StringComparison.OrdinalIgnoreCase))));
            }

            query = worldSortBy switch
            {
                "recent" => query.OrderByDescending(w => w.LastVisited ?? DateTime.MinValue),
                "name" => query.OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase),
                _ => query.OrderByDescending(w => w.Photos.Count).ThenBy(w => w.Name)
            };

            return query.ToList();
        }
    }

    private static string GetWorldCardTitle(WorldGroupItem world)
    {
        var author = !string.IsNullOrEmpty(world.AuthorName) ? $" by {world.AuthorName}" : string.Empty;
        var count = world.Photos.Count == 1 ? "1 photo" : $"{world.Photos.Count} photos";
        return $"{world.Name}{author} ({count})";
    }

    private static DateTime? GetFolderDate(string dirPath)
    {
        try
        {
            var name = Path.GetFileName(dirPath);
            if (!string.IsNullOrEmpty(name))
            {
                if (DateTime.TryParseExact(name, new[] { "yyyy-MM", "yyyy-MM-dd", "yyyy_MM", "yyyy_MM_dd", "yyyyMMdd" },
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var exactDate))
                {
                    return exactDate;
                }

                if (DateTime.TryParse(name, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedDate))
                {
                    return parsedDate;
                }
            }

            var di = new DirectoryInfo(dirPath);
            return di.LastWriteTime > di.CreationTime ? di.LastWriteTime : di.CreationTime;
        }
        catch
        {
            return null;
        }
    }

