    private DateTime _lastOpenFileTime = DateTime.MinValue;

    private void OpenFile(string path)
    {
        if ((DateTime.UtcNow - _lastOpenFileTime).TotalMilliseconds < 400) return;
        _lastOpenFileTime = DateTime.UtcNow;

        try
        {
            var viewerItems = Items.Where(x => !x.IsFolder).Select(x => new VRCGalleryManager.Components.ImageViewer.ViewerItem {
                HighResSource = x.Path,
                LowResSource = x.ThumbnailBase64,
                Title = x.Name
            }).ToList();
            
            var index = viewerItems.FindIndex(i => i.HighResSource == path);
            if (index == -1)
            {
                var item = Items.FirstOrDefault(x => x.Path == path);
                viewerItems = new List<VRCGalleryManager.Components.ImageViewer.ViewerItem> {
                    new VRCGalleryManager.Components.ImageViewer.ViewerItem {
                        HighResSource = path,
                        LowResSource = item?.ThumbnailBase64,
                        Title = item?.Name ?? System.IO.Path.GetFileName(path)
                    }
                };
                index = 0;
            }
            ViewerService.Open(new ImageViewerOptions
            {
                Items = viewerItems,
                StartIndex = index,
                ShowDownloadButton = false,
                ShowInfoButton = true,
                ShowDeleteButton = true,
                ShowUploadButton = true,
                OnDeleteRequested = async (idx) => await HandleViewerDelete(idx),
                OnUploadRequested = async (idx) => { HandleViewerUpload(idx); await Task.CompletedTask; }
            });
        }
        catch { }
    }

    private void OpenInExplorer(string filePath)
    {
        try
        {
            if (File.Exists(filePath))
            {
                System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{filePath}\"");
            }
            else if (Directory.Exists(filePath))
            {
                System.Diagnostics.Process.Start("explorer.exe", $"\"{filePath}\"");
            }
        }
        catch { }
        finally
        {
            activeExpandedPath = null;
            StateHasChanged();
        }
    }

    private string? activeExpandedPath = null;
    private DateTime _lastContextMenuTime = DateTime.MinValue;

    private void HandleCardContextMenu(string path)
    {
        if ((DateTime.UtcNow - _lastContextMenuTime).TotalMilliseconds < 450) return;
        _lastContextMenuTime = DateTime.UtcNow;

        activeExpandedPath = (activeExpandedPath == path) ? null : path;
        StateHasChanged();
    }

    private void HandleCardMouseLeave(string path)
    {
        if (activeExpandedPath == path)
        {
            activeExpandedPath = null;
            StateHasChanged();
        }
    }

    private void CloseExpandedCard()
    {
        if (activeExpandedPath != null)
        {
            activeExpandedPath = null;
            StateHasChanged();
        }
    }

    // ── Multi-Selection ───────────────────────────────────────────────────
    private void StartMultiSelect(string initialPath)
    {
        activeExpandedPath = null;
        isMultiSelectMode = true;
        selectedPaths.Clear();
        _isMouseDown = false;
        _hasDragged = false;
        _dragStartPath = null;
        if (!string.IsNullOrEmpty(initialPath))
        {
            selectedPaths.Add(initialPath);
        }
        StateHasChanged();
    }

    private void HandleMouseDown(GalleryItem item)
    {
        if (!isMultiSelectMode || item.IsFolder || string.IsNullOrEmpty(item.Path)) return;

        _isMouseDown = true;
        _hasDragged = false;
        _dragStartPath = item.Path;
        _dragSelectMode = !selectedPaths.Contains(item.Path);
    }

    private void HandleMouseEnter(GalleryItem item)
    {
        if (!isMultiSelectMode || !_isMouseDown || item.IsFolder || string.IsNullOrEmpty(item.Path)) return;

        if (!_hasDragged)
        {
            _hasDragged = true;
            if (!string.IsNullOrEmpty(_dragStartPath))
            {
                if (_dragSelectMode)
                    selectedPaths.Add(_dragStartPath);
                else
                    selectedPaths.Remove(_dragStartPath);
            }
        }

        if (_dragSelectMode)
            selectedPaths.Add(item.Path);
        else
            selectedPaths.Remove(item.Path);

        StateHasChanged();
    }

    private void HandleMouseUp()
    {
        _isMouseDown = false;
    }

    private void HandleCardClick(GalleryItem item)
    {
        if (isMultiSelectMode)
        {
            if (item.IsFolder || string.IsNullOrEmpty(item.Path)) return;
            if (!_hasDragged)
            {
                ToggleSelection(item.Path);
            }
            _hasDragged = false;
        }
        else
        {
            if (item.IsFolder)
                _ = OnItemClick(item);
            else
                OpenFile(item.Path);
        }
    }

    private void ToggleSelection(string path)
    {
        if (string.IsNullOrEmpty(path)) return;

        if (selectedPaths.Contains(path))
        {
            selectedPaths.Remove(path);
        }
        else
        {
            selectedPaths.Add(path);
        }
        StateHasChanged();
    }

    private void SelectAll()
    {
        var allImages = Items.Where(x => !x.IsFolder && !string.IsNullOrEmpty(x.Path)).Select(x => x.Path).ToList();
        selectedPaths = allImages.ToHashSet();
        StateHasChanged();
    }

    private void DeselectAll()
    {
        selectedPaths.Clear();
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        var allImages = Items.Where(x => !x.IsFolder && !string.IsNullOrEmpty(x.Path)).Select(x => x.Path).ToList();
        if (selectedPaths.Count >= allImages.Count)
        {
            selectedPaths.Clear();
        }
        else
        {
            selectedPaths = allImages.ToHashSet();
        }
        StateHasChanged();
    }

    private void CancelMultiSelect()
    {
        isMultiSelectMode = false;
        selectedPaths.Clear();
        _isMouseDown = false;
        _hasDragged = false;
        _dragStartPath = null;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (isMultiSelectMode && e.Key == "Escape")
        {
            CancelMultiSelect();
        }
    }

    private bool isDeleting = false;

    private async Task DeleteSelectedItems()
    {
        if (isDeleting || selectedPaths.Count == 0) return;

        int count = selectedPaths.Count;
        string title = count == 1 ? "Delete Photo" : "Delete Photos";
        string message = count == 1
            ? "Are you sure you want to move the selected photo to the Recycle Bin?"
            : $"Are you sure you want to move {count} selected photos to the Recycle Bin?";

        bool confirm = await dialogService.ShowConfirmAsync(title, message, "Delete", "Cancel");
        if (confirm)
        {
            isDeleting = true;
            StateHasChanged();

            int deletedCount = 0;
            var pathsToDelete = selectedPaths.ToList();

            try
            {
                await Task.Run(() =>
                {
                    foreach (var path in pathsToDelete)
                    {
                        try
                        {
                            if (FileHelper.DeleteToRecycleBin(path))
                            {
                                Interlocked.Increment(ref deletedCount);
                            }
                        }
                        catch (Exception ex)
                        {
                            System.Diagnostics.Debug.WriteLine($"Error deleting {path}: {ex.Message}");
                        }
                    }
                });

                var deletedSet = pathsToDelete.ToHashSet();
                Items.RemoveAll(x => deletedSet.Contains(x.Path));

                cachedItems = Items;
                selectedPaths.Clear();
                isMultiSelectMode = false;

                if (deletedCount > 0)
                {
                    NotificationService.Show(
                        deletedCount == 1 ? "Photo moved to the Recycle Bin." : $"{deletedCount} photos moved to the Recycle Bin.",
                        "Deleted",
                        NotificationType.Success);
                }
                else
                {
                    NotificationService.Show("Failed to delete selected photos.", "Delete Error", NotificationType.Error);
                }
            }
            finally
            {
                isDeleting = false;
                StateHasChanged();
            }
        }
    }

    private async Task CopyImageToClipboardAsync(string filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return;
        try
        {
            bool success = await ClipboardHandler.CopyImageToClipboardAsync(filePath);
            if (success)
            {
                NotificationService.Show("Image copied to clipboard.", "Copied", NotificationType.Success);
            }
            else
            {
                NotificationService.Show("Failed to copy image.", "Error", NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Failed to copy image: {ex.Message}", "Error", NotificationType.Error);
        }
        finally
        {
            activeExpandedPath = null;
            StateHasChanged();
        }
    }

