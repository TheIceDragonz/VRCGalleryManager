                                     @oncontextmenu:preventDefault="true"
                                     @onmouseleave="() => HandleCardMouseLeave(worldKey)"
                                     title="@GetWorldCardTitle(world)">
                                    @if (!string.IsNullOrEmpty(world.WorldImageUrl) && world.WorldImageUrl != "unavailable")
                                    {
                                        <img src="@world.WorldImageUrl" class="gallery-world-cover" alt="@world.Name" loading="lazy" draggable="false" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                        <div class="gallery-world-placeholder" style="display: none;">
                                            <span class="gallery-world-placeholder-label">Preview Unavailable</span>
                                        </div>
                                    }
                                    else if (isScanningWorlds || isLoadingWorldDetails)
                                    {
                                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: #12161c;">
                                            <div class="spinner-border spinner-border-sm text-accent"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="gallery-world-placeholder">
                                            <span class="gallery-world-placeholder-label">Preview Unavailable</span>
                                        </div>
                                    }
                                    <div class="panel-gradient"></div>
                                    <div class="panel-badge">
                                        <img src="/svg/camera-svgrepo-com.svg" class="btn-icon" />
                                        <span>@world.Photos.Count</span>
                                    </div>
                                    <div class="panel-info">
                                        <h5 class="panel-title text-truncate">@world.Name</h5>
                                        @if (!string.IsNullOrEmpty(world.AuthorName))
                                        {
                                            <p class="panel-subtitle text-truncate">by @world.AuthorName</p>
                                        }
                                    </div>

                                    @if (activeExpandedPath == worldKey)
                                    {
                                        <div class="media-card-actions" style="z-index: 10; bottom: 10px; right: 10px;">
                                            @if (!string.IsNullOrEmpty(world.WorldId) && world.WorldId.StartsWith("wrld_"))
                                            {
                                                <button class="btn btn-sm rounded-circle btn-action media-btn-world media-btn-extra"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => OpenWorldFromCard(world.WorldId)"
                                                        title="Open in VRChat (Browser)">
                                                    <img src="/svg/world-svgrepo-com.svg" class="btn-icon icon-white" style="width: 15px; height: 15px; margin: 0;" />
                                                </button>
                                                <button class="btn btn-sm rounded-circle btn-action media-btn-link media-btn-extra"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => CopyWorldLinkAsync(world)"
                                                        title="Copy World Link">
                                                    <img src="/svg/link-svgrepo-com.svg" class="btn-icon icon-white" style="width: 14px; height: 14px; margin: 0;" />
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* SINGLE WORLD PHOTOS VIEW *@
                <div class="flex-grow-1 overflow-auto h-100 pe-2 gallery-scroll-container" id="gallery-scroll-container" data-folder="@GetWorldScrollKey(selectedWorld)">
                    @if (!string.IsNullOrEmpty(activeExpandedPath))
                    {
                        <div class="card-action-backdrop" @onclick="CloseExpandedCard" @oncontextmenu="CloseExpandedCard" @oncontextmenu:preventDefault="true"></div>
                    }


                    <div class="media-grid gap-3 pb-3 @(!string.IsNullOrEmpty(activeExpandedPath) ? "has-card-expanded" : "")">
                        @foreach (var photo in SortedSelectedWorldPhotos)
                        {
                            <div @key="photo.Path"
                                 class="position-relative gallery-icon-card media-card-container @(activeExpandedPath == photo.Path ? "card-expanded-active" : "")"
                                 style="cursor: pointer;"
                                 @onclick="() => OpenFileInWorld(photo.Path)"
                                 @oncontextmenu="() => HandleCardContextMenu(photo.Path)"
                                 @oncontextmenu:preventDefault="true"
                                 @onmouseleave="() => HandleCardMouseLeave(photo.Path)"
                                 title="@photo.Name">

                                @if (!string.IsNullOrEmpty(photo.ThumbnailBase64))
                                {
                                    <img src="@photo.ThumbnailBase64" class="w-100 h-100 object-fit-cover" draggable="false" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <div class="spinner-border spinner-border-sm text-primary"></div>
                                    </div>
                                }

                                @if (activeExpandedPath == photo.Path && !string.IsNullOrEmpty(photo.ThumbnailBase64))
                                {
                                    <div class="media-card-actions">
                                        <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteWorldItem(photo)"
                                                title="Delete">
                                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-success btn-sm rounded-circle btn-action media-btn-upload"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => { SelectedImage = photo; ToggleUploadMenu(); }"
                                                title="Add (upload)">
                                            <img src="/svg/add-circle-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-copy media-btn-extra"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => CopyImageToClipboardAsync(photo.Path)"
                                                title="Copy Image">
                                            <img src="/svg/copy-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                        <button class="btn btn-sm rounded-circle btn-action media-btn-folder media-btn-extra"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenInExplorer(photo.Path)"
                                                title="Open in Explorer">
                                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

    </div>
</div>

@if (ShowUploadMenu)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center dialog-overlay" style="z-index: 20000;" @onclick="CloseUploadMenu">
        <div class="dialog-panel d-flex flex-column" @onclick:stopPropagation="true" style="min-width: 300px;">
            <div class="p-4 flex-grow-1 border-bottom border-secondary text-center">
