                    }
                    else if (worldGroups.Count == 0)
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50 text-center px-4">
                            <img src="/svg/world-svgrepo-com.svg" class="mb-3 opacity-50 icon-white" style="width: 56px; height: 56px;" />
                            <h5 class="text-white">No World Metadata Found</h5>
                            <p class="small" style="max-width: 480px;">No photos with VRChat world metadata were found in this folder. Keep <strong>VRCGalleryManager</strong> running while taking photos in VRChat to automatically embed world metadata.</p>
                            <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => ScanWorldsAsync(forceRefresh: true)">
                                <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" /> Scan Again
                            </button>
