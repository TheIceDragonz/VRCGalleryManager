    // ── Upload menu ───────────────────────────────────────────────────────
    private void ToggleUploadMenu() => ShowUploadMenu = !ShowUploadMenu;
    private void CloseUploadMenu() { if (ShowUploadMenu) ShowUploadMenu = false; }

    private async Task HandleViewerUpload(int index)
    {
        var targetList = Items.Where(x => !x.IsFolder).ToList();
        if (index >= 0 && index < targetList.Count)
        {
            SelectedImage = targetList[index];
            ShowUploadMenu = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UploadForCategory(string category, string route)
    {
        ShowUploadMenu = false;
        ViewerService.Close();

        string filePath = SelectedImage?.Path ?? string.Empty;
        if (!string.IsNullOrEmpty(filePath))
        {
            var encoded = Uri.EscapeDataString(filePath);
            Nav.NavigateTo($"/{route}?uploadPath={encoded}");
        }
        else
        {
            Nav.NavigateTo($"/{route}");
        }
    }

    private async Task HandleViewerDelete(int index)
    {
        var targetList = Items.Where(x => !x.IsFolder).ToList();
        if (index < 0 || index >= targetList.Count) return;
        var item = targetList[index];

        bool confirm = await dialogService.ShowConfirmAsync("Delete Photo", $"Are you sure you want to move \"{item.Name}\" to the Recycle Bin?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                bool deleted = FileHelper.DeleteToRecycleBin(item.Path);
                if (!deleted)
                {
                    NotificationService.Show("Failed to delete the photo.", "Delete Error", NotificationType.Error);
                    return;
                }

                Items.Remove(item);
                if (SelectedImage == item)
                {
                    SelectedImage = null;
                }

                var remainingPhotos = Items.Where(x => !x.IsFolder).ToList();
                if (remainingPhotos.Count > 0)
                {
                    var viewerItems = remainingPhotos.Select(x => new VRCGalleryManager.Components.ImageViewer.ViewerItem
                    {
                        HighResSource = x.Path,
                        LowResSource = x.ThumbnailBase64,
                        Title = x.Name
                    }).ToList();
                    ViewerService.Open(new ImageViewerOptions
                    {
                        Items = viewerItems,
                        StartIndex = Math.Min(index, viewerItems.Count - 1),
                        ShowDownloadButton = false,
                        ShowInfoButton = true,
                        ShowDeleteButton = true,
                        ShowUploadButton = true,
                        OnDeleteRequested = async (idx) => await HandleViewerDelete(idx),
                        OnUploadRequested = async (idx) => { HandleViewerUpload(idx); await Task.CompletedTask; }
                    });
                }
                else
                {
                    ViewerService.Close();
                }

                StateHasChanged();
                NotificationService.Show("Photo moved to the Recycle Bin.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show($"Delete failed: {ex.Message}", "Delete Error", NotificationType.Error);
            }
        }
    }

    private async Task DeleteFolder(GalleryItem item)
    {
        if (item == null || !item.IsFolder || string.IsNullOrEmpty(item.Path)) return;

        bool confirm = await dialogService.ShowConfirmAsync("Delete Folder", $"Are you sure you want to move the folder \"{item.Name}\" and all its contents to the Recycle Bin?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                bool deleted = await Task.Run(() => FileHelper.DeleteToRecycleBin(item.Path));
                if (!deleted)
                {
                    NotificationService.Show("Failed to delete the folder.", "Delete Error", NotificationType.Error);
                    return;
                }

                Items.Remove(item);
                activeExpandedPath = null;
                StateHasChanged();
                NotificationService.Show("Folder moved to the Recycle Bin.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show($"Delete failed: {ex.Message}", "Delete Error", NotificationType.Error);
            }
        }
    }

    private async Task DeleteItem(GalleryItem item)
    {
        if (item == null || item.IsFolder) return;

        bool confirm = await dialogService.ShowConfirmAsync("Delete Photo", $"Are you sure you want to move \"{item.Name}\" to the Recycle Bin?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                bool deleted = await Task.Run(() => FileHelper.DeleteToRecycleBin(item.Path));
                if (!deleted)
                {
                    NotificationService.Show("Failed to delete the photo.", "Delete Error", NotificationType.Error);
                    return;
                }

                Items.Remove(item);
                if (SelectedImage == item)
                {
                    SelectedImage = null;
                }

                StateHasChanged();
                NotificationService.Show("Photo moved to the Recycle Bin.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show($"Delete failed: {ex.Message}", "Delete Error", NotificationType.Error);
            }
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    private static bool IsImageFile(string filename)
    {
        var ext = Path.GetExtension(filename);
        return ext.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".jpeg", StringComparison.OrdinalIgnoreCase);
    }

    private string GetItemTooltip(GalleryItem item)
    {
        if (item.IsFolder)
        {
            if (item.PhotoCount.HasValue)
            {
                return item.PhotoCount.Value == 1 ? "1 photo" : $"{item.PhotoCount.Value} photos";
            }
            return item.Name;
        }
        return item.Name;
    }
