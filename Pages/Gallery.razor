            catch { }

            activeExpandedPath = null;
            selectedWorld = world;
            _pendingScrollKey = GetWorldScrollKey(world);
            _shouldRestoreScroll = true;
            StateHasChanged();
            _ = LoadWorldPhotosThumbnailsAsync(world);
