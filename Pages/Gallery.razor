                            {
                                var worldKey = !string.IsNullOrEmpty(world.WorldId) ? world.WorldId : $"name_{world.Name}";
                                <div @key="worldKey"
                                     class="gallery-world-card media-card-container @(activeExpandedPath == worldKey ? "card-expanded-active" : "")"
                                     @onclick="() => SelectWorld(world)"
