    private async Task LoadWorldPhotosThumbnailsAsync(WorldGroupItem world)
    {
        var photosToLoad = world.Photos.Where(p => string.IsNullOrEmpty(p.ThumbnailBase64)).ToList();
        if (photosToLoad.Count == 0) return;

        var parallelOptions = new ParallelOptions { MaxDegreeOfParallelism = Math.Clamp(Environment.ProcessorCount, 2, 6) };
        long lastTicks = DateTime.UtcNow.Ticks;
        int count = 0;

        await Parallel.ForEachAsync(photosToLoad, parallelOptions, async (p, ct) =>
        {
            try
            {
                var existing = Items.FirstOrDefault(i => i.Path == p.Path);
                if (existing != null && !string.IsNullOrEmpty(existing.ThumbnailBase64))
                {
                    p.ThumbnailBase64 = existing.ThumbnailBase64;
                }
                else
                {
                    p.ThumbnailBase64 = await MakeThumbnailBase64Async(p.Path, 256, ct);
                }
                p.IsThumbLoading = false;
            }
            catch
            {
                p.IsThumbLoading = false;
            }

            int c = Interlocked.Increment(ref count);
            long nowTicks = DateTime.UtcNow.Ticks;
            long prevTicks = Interlocked.Read(ref lastTicks);
            if (c == photosToLoad.Count || c % 10 == 0 || (nowTicks - prevTicks) > TimeSpan.TicksPerMillisecond * 150)
            {
                Interlocked.Exchange(ref lastTicks, nowTicks);
                await InvokeAsync(StateHasChanged);
            }
        });

        await InvokeAsync(StateHasChanged);
    }

    private void OpenFileInWorld(string path)
    {
        if (selectedWorld == null || (DateTime.UtcNow - _lastOpenFileTime).TotalMilliseconds < 400) return;
        _lastOpenFileTime = DateTime.UtcNow;

        try
        {
            var viewerItems = SortedSelectedWorldPhotos.Select(x => new VRCGalleryManager.Components.ImageViewer.ViewerItem
            {
                HighResSource = x.Path,
                LowResSource = x.ThumbnailBase64,
                Title = x.Name
            }).ToList();

            var index = viewerItems.FindIndex(i => i.HighResSource == path);
            if (index == -1) index = 0;

            ViewerService.Open(new ImageViewerOptions
            {
                Items = viewerItems,
                StartIndex = index,
                ShowDownloadButton = false,
                ShowInfoButton = true,
                ShowDeleteButton = true,
                ShowUploadButton = true,
                OnDeleteRequested = async (idx) => await HandleWorldViewerDelete(idx),
                OnUploadRequested = async (idx) => { HandleWorldViewerUpload(idx); await Task.CompletedTask; }
            });
        }
        catch { }
    }

    private async Task HandleWorldViewerDelete(int index)
    {
        if (selectedWorld == null || index < 0 || index >= selectedWorld.Photos.Count) return;
        var item = selectedWorld.Photos[index];

        bool confirm = await dialogService.ShowConfirmAsync("Delete Photo", $"Are you sure you want to move \"{item.Name}\" to the Recycle Bin?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                bool deleted = FileHelper.DeleteToRecycleBin(item.Path);
                if (!deleted)
                {
                    NotificationService.Show("Failed to delete the photo.", "Delete Error", NotificationType.Error);
                    return;
                }

                selectedWorld.Photos.Remove(item);
                Items.RemoveAll(x => x.Path == item.Path);

                if (selectedWorld.Photos.Count > 0)
                {
                    var remainingPhotos = selectedWorld.Photos.Select(x => new VRCGalleryManager.Components.ImageViewer.ViewerItem
                    {
                        HighResSource = x.Path,
                        LowResSource = x.ThumbnailBase64,
                        Title = x.Name
                    }).ToList();

                    ViewerService.Open(new ImageViewerOptions
                    {
                        Items = remainingPhotos,
                        StartIndex = Math.Min(index, remainingPhotos.Count - 1),
                        ShowDownloadButton = false,
                        ShowInfoButton = true,
                        ShowDeleteButton = true,
                        ShowUploadButton = true,
                        OnDeleteRequested = async (idx) => await HandleWorldViewerDelete(idx),
                        OnUploadRequested = async (idx) => { HandleWorldViewerUpload(idx); await Task.CompletedTask; }
                    });
                }
                else
                {
                    ViewerService.Close();
                    worldGroups.Remove(selectedWorld);
                    selectedWorld = null;
                }

                StateHasChanged();
                NotificationService.Show("Photo moved to the Recycle Bin.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show($"Delete failed: {ex.Message}", "Delete Error", NotificationType.Error);
            }
        }
    }

    private void HandleWorldViewerUpload(int index)
    {
        if (selectedWorld == null || index < 0 || index >= selectedWorld.Photos.Count) return;
        SelectedImage = selectedWorld.Photos[index];
        ShowUploadMenu = true;
        StateHasChanged();
    }

    private async Task DeleteWorldItem(GalleryItem item)
    {
        if (item == null || selectedWorld == null) return;

        bool confirm = await dialogService.ShowConfirmAsync("Delete Photo", $"Are you sure you want to move \"{item.Name}\" to the Recycle Bin?", "Delete", "Cancel");
        if (confirm)
        {
            try
            {
                bool deleted = await Task.Run(() => FileHelper.DeleteToRecycleBin(item.Path));
                if (!deleted)
                {
                    NotificationService.Show("Failed to delete the photo.", "Delete Error", NotificationType.Error);
                    return;
                }

                selectedWorld.Photos.Remove(item);
                MetadataScanCache.Remove(item.Path);
                MetadataScanCache.SaveIfDirty();
                Items.RemoveAll(x => x.Path == item.Path);
                activeExpandedPath = null;

                if (selectedWorld.Photos.Count == 0)
                {
                    worldGroups.Remove(selectedWorld);
                    selectedWorld = null;
                }

                StateHasChanged();
                NotificationService.Show("Photo moved to the Recycle Bin.", "Deleted", NotificationType.Success);
            }
            catch (Exception ex)
            {
                NotificationService.Show($"Delete failed: {ex.Message}", "Delete Error", NotificationType.Error);
            }
        }
    }

    private void OpenWorldInBrowser(string? worldId)
    {
        if (string.IsNullOrEmpty(worldId)) return;
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = $"https://vrchat.com/home/world/{worldId}",
                UseShellExecute = true
            });
        }
        catch { }
    }

    private void OpenWorldFromCard(string? worldId)
    {
        activeExpandedPath = null;
        OpenWorldInBrowser(worldId);
        StateHasChanged();
    }

    private async Task CopyWorldLinkAsync(WorldGroupItem world)
    {
        if (world == null || string.IsNullOrEmpty(world.WorldId) || !world.WorldId.StartsWith("wrld_"))
        {
            NotificationService.Show("World ID not available for this world.", "Warning", NotificationType.Info);
            return;
        }

        var url = $"https://vrchat.com/home/world/{world.WorldId}";
        try
        {
            bool success = false;
            try
            {
                success = await JS.InvokeAsync<bool>("clipboardInterop.writeText", url);
            }
            catch { }

            if (!success)
            {
                await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(url);
                success = true;
            }

            if (success)
            {
                NotificationService.Show("World link copied to clipboard.", "Copied", NotificationType.Success);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Show($"Failed to copy link: {ex.Message}", "Error", NotificationType.Error);
        }
        finally
        {
            activeExpandedPath = null;
            StateHasChanged();
        }
    }

    private void HandleLivePhotoCaptured(PhotoPopupModel popup)
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                if (string.IsNullOrEmpty(popup.FilePath) || !File.Exists(popup.FilePath)) return;

                // 1. If currently in Photos view and in the folder where photo was saved, add to Items
                string? photoDir = Path.GetDirectoryName(popup.FilePath);
                if (!string.IsNullOrEmpty(photoDir) && !string.IsNullOrEmpty(CurrentFolder) &&
                    string.Equals(Path.GetFullPath(photoDir), Path.GetFullPath(CurrentFolder), StringComparison.OrdinalIgnoreCase))
                {
                    if (!Items.Any(i => string.Equals(i.Path, popup.FilePath, StringComparison.OrdinalIgnoreCase)))
                    {
                        var newItem = new GalleryItem
                        {
                            IsFolder = false,
                            Path = popup.FilePath,
                            Name = popup.FileName,
                            WorldName = popup.WorldName,
                            WorldId = popup.WorldId,
                            FileDate = DateTime.Now,
                            ThumbnailBase64 = popup.ThumbnailBase64
                        };
                        Items.Insert(0, newItem);
                        cachedItems = Items;
                    }
                }

                // 2. Update Worlds view in memory
                string worldId = popup.WorldId?.Trim() ?? "";
                string worldName = popup.WorldName?.Trim() ?? "";
                if (string.IsNullOrEmpty(worldName))
                {
                    worldName = !string.IsNullOrEmpty(worldId) ? worldId : "Unknown World";
                }

                var group = worldGroups.FirstOrDefault(w =>
                    (!string.IsNullOrEmpty(worldId) && string.Equals(w.WorldId, worldId, StringComparison.OrdinalIgnoreCase)) ||
                    (string.IsNullOrEmpty(worldId) && string.Equals(w.Name, worldName, StringComparison.OrdinalIgnoreCase)));

                var newPhoto = new GalleryItem
                {
                    IsFolder = false,
                    Path = popup.FilePath,
                    Name = popup.FileName,
                    WorldName = worldName,
                    WorldId = worldId,
                    FileDate = DateTime.Now,
                    ThumbnailBase64 = popup.ThumbnailBase64
                };

                if (group != null)
                {
                    lock (group.Photos)
                    {
                        group.Photos.Insert(0, newPhoto);
                        group.LastVisited = DateTime.Now;
                        group.CoverPath = popup.FilePath;
                    }
                }
                else
                {
                    group = new WorldGroupItem
                    {
                        Name = worldName,
                        WorldId = !string.IsNullOrEmpty(worldId) ? worldId : null,
                        CoverPath = popup.FilePath,
                        LastVisited = DateTime.Now,
                        Photos = new List<GalleryItem> { newPhoto }
                    };
                    if (!string.IsNullOrEmpty(worldId))
                    {
                        var cachedInfo = WorldCacheHelper.Get(worldId);
                        if (cachedInfo != null)
                        {
                            if (!string.IsNullOrEmpty(cachedInfo.Name)) group.Name = cachedInfo.Name;
                            group.AuthorName = cachedInfo.AuthorName;
                            group.WorldImageUrl = cachedInfo.ImageUrl;
                        }
                    }
                    worldGroups.Insert(0, group);
                    cachedWorldGroups = worldGroups;
                    _ = LoadWorldDetailsAndCoversAsync();
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[Gallery] Error in HandleLivePhotoCaptured: {ex.Message}");
            }
        });
    }

    public void Dispose()
    {
        try
        {
            PhotoWatcher.OnPhotoCaptured -= HandleLivePhotoCaptured;
        }
        catch { }
    }
}


