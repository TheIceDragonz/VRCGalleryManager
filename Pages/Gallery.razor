@page "/gallery"
@using System.IO
@using System.Threading
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.Helpers
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@inject VRCAuth Auth
@inject NavigationManager Nav
@inject DialogService dialogService
@inject NotificationService NotificationService
@inject ImageViewerService ViewerService
@inject VRCLogWatcherService PhotoWatcher
@inject IJSRuntime JS
@implements IDisposable

<div class="h-100 d-flex flex-column p-3 @(isMultiSelectMode ? "gallery-multiselect-active" : "")" @onmouseup="HandleMouseUp">
    @* TOP TOOLBAR *@
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
        <div class="d-flex align-items-center text-truncate me-2">
            <h3 class="mb-0 text-accent d-flex align-items-center gap-2 text-nowrap">
                <img src="/svg/gallery-wide-svgrepo-com.svg" class="media-page-icon" /> Gallery
            </h3>
            @if (currentView == GalleryView.Photos)
            {
                var breadcrumbs = GetBreadcrumbs();
                if (breadcrumbs.Count > 0)
                {
                    <nav class="gallery-breadcrumbs ms-3 d-flex align-items-center flex-nowrap" aria-label="breadcrumb">
                        @for (int i = 0; i < breadcrumbs.Count; i++)
                        {
                            var crumb = breadcrumbs[i];
                            if (i > 0)
                            {
                                <span class="gallery-breadcrumb-sep">/</span>
                            }
                            if (crumb.IsCurrent)
                            {
                                <span class="gallery-breadcrumb-item current text-truncate" title="@crumb.Path">
                                    @crumb.Name
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        class="gallery-breadcrumb-item btn-link-crumb text-truncate"
                                        @onclick="() => NavigateToFolder(crumb.Path)"
                                        title="Go to @crumb.Name">
                                    @crumb.Name
                                </button>
                            }
                        }
                    </nav>
                }
                else if (!string.IsNullOrEmpty(CurrentFolder))
                {
                    <span class="text-white-50 ms-3 small mb-0 text-truncate" style="max-width: 450px;" title="@CurrentFolder">@CurrentFolder</span>
                }
            }
            else if (currentView == GalleryView.Worlds)
            {
                <nav class="gallery-breadcrumbs ms-3 d-flex align-items-center flex-nowrap" aria-label="breadcrumb">
                    @if (selectedWorld != null)
                    {
                        <button type="button"
                                class="gallery-breadcrumb-item btn-link-crumb text-truncate"
                                @onclick="ExitSelectedWorld"
                                title="Back to all worlds">
                            Worlds
                        </button>
                        <span class="gallery-breadcrumb-sep">/</span>
                        <span class="gallery-breadcrumb-item current text-truncate" title="@selectedWorld.Name">
                            @selectedWorld.Name
                        </span>
                    }
                    else
                    {
                        <span class="gallery-breadcrumb-item current text-truncate" title="Worlds">
                            Worlds
                        </span>
                    }
                </nav>
            }
        </div>

        @if (currentView == GalleryView.Photos)
        {
            @if (isMultiSelectMode)
            {
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <span class="gallery-multiselect-badge text-nowrap me-1">
                        <span class="badge-count-accent">@selectedPaths.Count</span>
                        <span class="badge-count-sep">/</span>
                        <span class="badge-count-total">@(FilteredItems.Count(x => !x.IsFolder))</span>
                        <span class="badge-label">selected</span>
                    </span>

                    <button type="button"
                            class="gallery-tb-circle-btn checked"
                            @onclick="SelectAll"
                            title="Select all">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#12161c" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>

                    <button type="button"
                            class="gallery-tb-circle-btn"
                            @onclick="DeselectAll"
                            title="Deselect all">
                    </button>

                    <button class="btn btn-danger btn-sm"
                            disabled="@(selectedPaths.Count == 0 || isDeleting)"
                            @onclick="DeleteSelectedItems"
                            title="@(selectedPaths.Count > 0 ? $"Delete {selectedPaths.Count} selected" : "Delete selected")">
                        @if (isDeleting)
                        {
                            <div class="spinner-border spinner-border-sm text-white" style="width: 14px; height: 14px; margin: 0;" role="status"></div>
                        }
                        else
                        {
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                        }
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            id="gallery-cancel-multiselect-btn"
                            @onclick="CancelMultiSelect"
                            title="Cancel multi-selection">
                        <img src="/svg/close-bold-svgrepo-com.svg" class="btn-icon" /> Cancel
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack" disabled="@(!CanGoBack)" title="Go back">
                        <img src="/svg/back-arrow-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@IsLoading" title="Refresh">
                        <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(IsLoading ? "spin" : "")" style="margin: 0;" />
                    </button>
                </div>
            }
        }
        else if (currentView == GalleryView.Worlds)
        {
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack" disabled="@(!CanGoBack)" title="Go back">
                    <img src="/svg/back-arrow-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => ScanWorldsAsync(forceRefresh: true)" disabled="@isScanningWorlds" title="Rescan Worlds">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon @(isScanningWorlds ? "spin" : "")" style="margin: 0;" />
                </button>
            </div>
        }
    </div>

    @* CAPSULE NAVIGATION ROW (WITH SEARCH & SORT ON THE SAME ROW) *@
    <div class="gallery-controls-row mb-3">
        @* LEFT: Search worlds/photos input OR Selected World Name & Creator *@
        <div class="gallery-controls-left">
            @if (currentView == GalleryView.Worlds)
            {
                @if (selectedWorld != null)
                {
                    var hasValidWorldId = !string.IsNullOrEmpty(selectedWorld.WorldId) && selectedWorld.WorldId.StartsWith("wrld_");
                    <button type="button"
                            class="btn gallery-world-capsule-btn @(hasValidWorldId ? "clickable" : "non-clickable") shadow-sm"
                            @onclick="() => { if (hasValidWorldId) OpenWorldInBrowser(selectedWorld.WorldId); }"
                            title="@(hasValidWorldId ? $"Open {selectedWorld.Name} on VRChat website" : selectedWorld.Name)">
                        <div class="gallery-world-capsule-thumb">
                            @if (!string.IsNullOrEmpty(selectedWorld.WorldImageUrl) && selectedWorld.WorldImageUrl != "unavailable")
                            {
                                <img src="@selectedWorld.WorldImageUrl"
                                     alt="@selectedWorld.Name"
                                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="gallery-selected-world-placeholder align-items-center justify-content-center" style="display: none;">
                                    <img src="/svg/world-svgrepo-com.svg" class="btn-icon" style="width: 13px; height: 13px; opacity: 0.5; margin: 0;" />
                                </div>
                            }
                            else if (isScanningWorlds || isLoadingWorldDetails)
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <div class="spinner-border spinner-border-sm text-accent" style="width: 11px; height: 11px;"></div>
                                </div>
                            }
                            else
                            {
                                <div class="gallery-selected-world-placeholder d-flex align-items-center justify-content-center">
                                    <img src="/svg/world-svgrepo-com.svg" class="btn-icon" style="width: 13px; height: 13px; opacity: 0.5; margin: 0;" />
                                </div>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-1 overflow-hidden text-truncate">
                            <span class="gallery-world-capsule-title text-truncate">@selectedWorld.Name</span>
                            @if (!string.IsNullOrEmpty(selectedWorld.AuthorName))
                            {
                                <span class="gallery-world-capsule-author flex-shrink-0">by @selectedWorld.AuthorName</span>
                            }
                        </div>

                        @if (hasValidWorldId)
                        {
                            <img src="/svg/link-svgrepo-com.svg" class="btn-icon gallery-world-capsule-link-icon flex-shrink-0" alt="Link" />
                        }
                    </button>
                }
                else if (worldGroups.Count > 0)
                {
                    <div class="gallery-search-pill d-flex align-items-center px-3 rounded-pill shadow-sm">
                        <img src="/svg/search-alt-2-svgrepo-com.svg" class="btn-icon gallery-search-icon flex-shrink-0" alt="Search" />
                        <input type="text"
                               class="gallery-search-input"
                               placeholder="Search worlds, author..."
                               @bind="worldSearchQuery"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(worldSearchQuery))
                        {
                            <button type="button" class="btn-clear-search ms-1" @onclick="() => worldSearchQuery = string.Empty" title="Clear search">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        }
                    </div>
                }
            }
        </div>

        @* CENTER: Capsule Navigation Bar *@
        <div class="gallery-controls-center">
            <div class="gallery-view-nav d-flex gap-1 p-1 rounded-pill shadow-sm align-items-center">
                <button class="btn btn-sm rounded-pill px-3 picflow-cat-btn d-inline-flex align-items-center @GetGalleryViewBtnClass(GalleryView.Photos)"
                        @onclick="() => SwitchGalleryView(GalleryView.Photos)">
                    <img src="/svg/gallery-wide-svgrepo-com.svg" class="btn-icon @(currentView == GalleryView.Photos ? "icon-white" : "")" style="width: 14px; height: 14px; margin: 0 6px 0 0;" />
                    <span>Photos</span>
                </button>
                <button class="btn btn-sm rounded-pill px-3 picflow-cat-btn d-inline-flex align-items-center @GetGalleryViewBtnClass(GalleryView.Worlds)"
                        @onclick="() => SwitchGalleryView(GalleryView.Worlds)">
                    <img src="/svg/world-svgrepo-com.svg" class="btn-icon @(currentView == GalleryView.Worlds ? "icon-white" : "")" style="width: 14px; height: 14px; margin: 0 6px 0 0;" />
                    <span>Worlds</span>
                </button>
            </div>
        </div>

        @* RIGHT: Sort Dropdown & Content Count Badge *@
        <div class="gallery-controls-right">
            @if (currentView == GalleryView.Worlds)
            {
                @if (selectedWorld != null)
                {
                    @if (selectedWorld.Photos.Count > 1)
                    {
                        <span class="gallery-sort-label text-white-50 small fw-semibold">Sort:</span>
                        <div class="gallery-dropdown-container">
                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 gallery-dropdown-btn d-inline-flex align-items-center gap-2 @(isPhotoSortDropdownOpen ? "open" : "")" @onclick="TogglePhotoSortDropdown" @onclick:stopPropagation="true">
                                <span>@GetPhotoSortLabel(photoSortBy)</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron @(isPhotoSortDropdownOpen ? "open" : "")">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                            @if (isPhotoSortDropdownOpen)
                            {
                                <div class="custom-dropdown-backdrop" @onclick="ClosePhotoSortDropdown" @onclick:stopPropagation="true"></div>
                                <div class="custom-dropdown-menu" @onclick:stopPropagation="true">
                                    <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "newest" ? "active" : "")" @onclick='() => SelectPhotoSort("newest")'>
                                        <span>Newest First</span>
                                        @if (photoSortBy == "newest")
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </button>
                                    <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "oldest" ? "active" : "")" @onclick='() => SelectPhotoSort("oldest")'>
                                        <span>Oldest First</span>
                                        @if (photoSortBy == "oldest")
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </button>
                                    <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "name" ? "active" : "")" @onclick='() => SelectPhotoSort("name")'>
                                        <span>Name (A-Z)</span>
                                        @if (photoSortBy == "name")
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="gallery-count-pill px-3 py-1 rounded-pill small shadow-sm d-flex align-items-center gap-1">
                        <span class="text-accent fw-bold">@selectedWorld.Photos.Count</span>
                        <span class="text-white-50">@(selectedWorld.Photos.Count == 1 ? "photo" : "photos")</span>
                    </div>
                }
                else if (worldGroups.Count > 0)
                {
                    <span class="gallery-sort-label text-white-50 small fw-semibold">Sort:</span>
                    <div class="gallery-dropdown-container">
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 gallery-dropdown-btn d-inline-flex align-items-center gap-2 @(isSortDropdownOpen ? "open" : "")" @onclick="ToggleSortDropdown" @onclick:stopPropagation="true">
                            <span>@GetSortLabel(worldSortBy)</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron @(isSortDropdownOpen ? "open" : "")">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        @if (isSortDropdownOpen)
                        {
                            <div class="custom-dropdown-backdrop" @onclick="CloseSortDropdown" @onclick:stopPropagation="true"></div>
                            <div class="custom-dropdown-menu" @onclick:stopPropagation="true">
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(worldSortBy == "count" ? "active" : "")" @onclick='() => SelectSort("count")'>
                                    <span>Most Photos</span>
                                    @if (worldSortBy == "count")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(worldSortBy == "recent" ? "active" : "")" @onclick='() => SelectSort("recent")'>
                                    <span>Recently Visited</span>
                                    @if (worldSortBy == "recent")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(worldSortBy == "name" ? "active" : "")" @onclick='() => SelectSort("name")'>
                                    <span>Name (A-Z)</span>
                                    @if (worldSortBy == "name")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                    <div class="gallery-count-pill px-3 py-1 rounded-pill small shadow-sm d-flex align-items-center gap-1">
                        <span class="text-accent fw-bold">@FilteredWorlds.Count</span>
                        <span class="text-white-50">@(FilteredWorlds.Count == 1 ? "world" : "worlds")</span>
                    </div>
                }
            }
            else if (currentView == GalleryView.Photos)
            {
                @if (Items.Count > 0)
                {
                    <span class="gallery-sort-label text-white-50 small fw-semibold">Sort:</span>
                    <div class="gallery-dropdown-container">
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 gallery-dropdown-btn d-inline-flex align-items-center gap-2 @(isPhotoSortDropdownOpen ? "open" : "")" @onclick="TogglePhotoSortDropdown" @onclick:stopPropagation="true">
                            <span>@GetPhotoSortLabel(photoSortBy)</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron @(isPhotoSortDropdownOpen ? "open" : "")">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        @if (isPhotoSortDropdownOpen)
                        {
                            <div class="custom-dropdown-backdrop" @onclick="ClosePhotoSortDropdown" @onclick:stopPropagation="true"></div>
                            <div class="custom-dropdown-menu" @onclick:stopPropagation="true">
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "newest" ? "active" : "")" @onclick='() => SelectPhotoSort("newest")'>
                                    <span>Newest First</span>
                                    @if (photoSortBy == "newest")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "oldest" ? "active" : "")" @onclick='() => SelectPhotoSort("oldest")'>
                                    <span>Oldest First</span>
                                    @if (photoSortBy == "oldest")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                                <button type="button" class="custom-dropdown-item d-flex align-items-center justify-content-between @(photoSortBy == "name" ? "active" : "")" @onclick='() => SelectPhotoSort("name")'>
                                    <span>Name (A-Z)</span>
                                    @if (photoSortBy == "name")
                                    {
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                            </div>
                        }
                    </div>

                    <div class="gallery-count-pill px-3 py-1 rounded-pill small shadow-sm d-flex align-items-center gap-1">
                        @if (FilteredFolderCount > 0 && FilteredPhotoCount > 0)
                        {
                            <span class="text-accent fw-bold">@FilteredFolderCount</span>
                            <span class="text-white-50">@(FilteredFolderCount == 1 ? "folder" : "folders"),</span>
                            <span class="text-accent fw-bold">@FilteredPhotoCount</span>
                            <span class="text-white-50">@(FilteredPhotoCount == 1 ? "photo" : "photos")</span>
                        }
                        else if (FilteredFolderCount > 0)
                        {
                            <span class="text-accent fw-bold">@FilteredFolderCount</span>
                            <span class="text-white-50">@(FilteredFolderCount == 1 ? "folder" : "folders")</span>
                        }
                        else
                        {
                            <span class="text-accent fw-bold">@FilteredPhotoCount</span>
                            <span class="text-white-50">@(FilteredPhotoCount == 1 ? "photo" : "photos")</span>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* MAIN CONTENT *@
    <div class="flex-grow-1 overflow-hidden d-flex gap-3" @onclick="CloseUploadMenu">
        
        @if (currentView == GalleryView.Photos)
        {
            @* STANDARD PHOTOS GRID *@
            <div class="flex-grow-1 overflow-auto h-100 pe-2 gallery-scroll-container" id="gallery-scroll-container" data-folder="@CurrentFolder">
                @if (string.IsNullOrEmpty(RootFolder) || !Directory.Exists(RootFolder))
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                        <img src="/svg/folder-open-svgrepo-com.svg" class="mb-3 opacity-50 folder-svg-icon" />
                        <h5 class="text-white">No folder selected</h5>
                        <p>Go to <strong>Settings</strong> to configure your VRChat screenshots folder.</p>
                        <button class="btn btn-primary mt-2 d-flex align-items-center gap-2" @onclick='() => Nav.NavigateTo("/settings")'>
                            <img src="/svg/settings-svgrepo-com.svg" class="btn-icon icon-white" /> Open Settings
                        </button>
                    </div>
                }
                else if (Items.Count == 0 && !IsLoading)
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                        <img src="/svg/folder-open-svgrepo-com.svg" class="mb-3 opacity-50 folder-svg-icon" />
                        <h5>This folder is empty</h5>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(activeExpandedPath))
                    {
                        <div class="card-action-backdrop" @onclick="CloseExpandedCard" @oncontextmenu="CloseExpandedCard" @oncontextmenu:preventDefault="true"></div>
                    }

                    <div class="media-grid gap-3 pb-3 @(!string.IsNullOrEmpty(activeExpandedPath) ? "has-card-expanded" : "")" @onmouseup="HandleMouseUp">
                        @foreach (var item in FilteredItems)
                        {
                            <div @key="item.Path"
                                 class="position-relative gallery-icon-card media-card-container @(item.IsFolder ? "gallery-folder-item" : "") @(activeExpandedPath == item.Path ? "card-expanded-active" : "") @(!item.IsFolder && isMultiSelectMode && selectedPaths.Contains(item.Path) ? "is-selected" : "")"
                                 style="cursor: pointer;"
                                 @onmousedown="() => HandleMouseDown(item)"
                                 @onmouseenter="() => HandleMouseEnter(item)"
                                 @onclick="() => HandleCardClick(item)"
                                 @oncontextmenu="() => { if(!isMultiSelectMode) HandleCardContextMenu(item.Path); }"
                                 @oncontextmenu:preventDefault="true"
                                 @onmouseleave="() => { if(!isMultiSelectMode) HandleCardMouseLeave(item.Path); }"
                                 title="@GetItemTooltip(item)">

                                @if (item.IsFolder)
                                {
                                    <div class="w-100 h-100 d-flex flex-column" style="background-color: var(--bg-hover);">
                                        @if (!string.IsNullOrEmpty(item.ThumbnailBase64))
                                        {
                                            <img src="@item.ThumbnailBase64" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" style="filter: brightness(0.4);" draggable="false" />
                                        }
                                        <div class="folder-icon position-relative z-1" style="flex: 1; display: flex; align-items: center; justify-content: center;">
                                            @if (item.IsThumbLoading && string.IsNullOrEmpty(item.ThumbnailBase64))
                                            {
                                                <div class="spinner-border spinner-border-sm text-primary"></div>
                                            }
                                            else
                                            {
                                                <img src="/svg/folder-open-svgrepo-com.svg" class="folder-svg-icon" draggable="false" />
                                            }
                                        </div>
                                        @if (item.PhotoCount.HasValue)
                                        {
                                            <div class="panel-badge">
                                                <img src="/svg/camera-svgrepo-com.svg" class="btn-icon" />
                                                <span>@item.PhotoCount.Value</span>
                                            </div>
                                        }
                                        <div class="panel-gradient"></div>
                                        <div class="panel-info">
                                            <h5 class="panel-title text-truncate">@item.Name</h5>
                                        </div>
                                    </div>

                                    @* Folder action buttons (shown on right-click) *@
                                    @if (!isMultiSelectMode && activeExpandedPath == item.Path)
                                    {
                                        <div class="media-card-actions" style="z-index: 10;">
                                            <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => DeleteFolder(item)"
                                                    title="Delete Folder">
                                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                            </button>

                                            <button class="btn btn-sm rounded-circle btn-action media-btn-folder media-btn-extra"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenInExplorer(item.Path)"
                                                    title="Open in Explorer">
                                                <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(item.ThumbnailBase64))
                                    {
                                        <img src="@item.ThumbnailBase64" class="w-100 h-100 object-fit-cover" draggable="false" />
                                    }
                                    else if (item.IsThumbLoading)
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                            <div class="spinner-border spinner-border-sm text-primary"></div>
                                        </div>
                                    }

                                    @* Multi-select trigger button (appears on right-click in top-right of the card as an unselected circle) *@
                                    @if (!isMultiSelectMode && activeExpandedPath == item.Path)
                                    {
                                        <div class="gallery-multiselect-checkbox media-btn-multiselect-trigger"
                                             @onclick:stopPropagation="true"
                                             @onclick="() => StartMultiSelect(item.Path)"
                                             title="Select">
                                        </div>
                                    }

                                    @* Multi-select mode checkbox indicator on each image card *@
                                    @if (isMultiSelectMode)
                                    {
                                        <div class="gallery-multiselect-checkbox @(selectedPaths.Contains(item.Path) ? "checked" : "")"
                                             @onclick:stopPropagation="true"
                                             @onclick="() => HandleCardClick(item)"
                                             title="@(selectedPaths.Contains(item.Path) ? "Deselect" : "Select")">
                                            @if (selectedPaths.Contains(item.Path))
                                            {
                                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="#12161c" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            }
                                        </div>
                                    }

                                    @* Standard card actions (hidden during multi-selection mode) *@
                                    @if (!isMultiSelectMode && !string.IsNullOrEmpty(item.ThumbnailBase64))
                                    {
                                        <div class="media-card-actions">
                                            <button class="btn btn-danger btn-sm rounded-circle btn-action media-btn-delete" @onclick:stopPropagation="true" @onclick="() => DeleteItem(item)" title="Delete">
                                                <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" style="margin: 0;" />
                                            </button>

                                            <button class="btn btn-success btn-sm rounded-circle btn-action media-btn-upload" @onclick:stopPropagation="true" @onclick="() => { SelectedImage = item; ToggleUploadMenu(); }" title="Upload">
                                                <img src="/svg/add-circle-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                            </button>

                                            @if (activeExpandedPath == item.Path)
                                            {
                                                <button class="btn btn-sm rounded-circle btn-action media-btn-copy media-btn-extra" @onclick:stopPropagation="true" @onclick="() => CopyImageToClipboardAsync(item.Path)" title="Copy Image">
                                                    <img src="/svg/copy-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                                </button>
                                                <button class="btn btn-sm rounded-circle btn-action media-btn-folder media-btn-extra" @onclick:stopPropagation="true" @onclick="() => OpenInExplorer(item.Path)" title="Open Location">
                                                    <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon icon-white" style="margin: 0;" />
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (currentView == GalleryView.Worlds)
        {
            @if (selectedWorld == null)
            {
                @* WORLDS LIST *@
                <div class="flex-grow-1 overflow-auto h-100 pe-2 gallery-scroll-container" id="gallery-scroll-container" data-folder="@WorldsScrollKey">
                    @if (string.IsNullOrEmpty(RootFolder) || !Directory.Exists(RootFolder))
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="mb-3 opacity-50 folder-svg-icon" />
                            <h5 class="text-white">No folder selected</h5>
                            <p>Go to <strong>Settings</strong> to configure your VRChat screenshots folder.</p>
                            <button class="btn btn-primary mt-2 d-flex align-items-center gap-2" @onclick='() => Nav.NavigateTo("/settings")'>
                                <img src="/svg/settings-svgrepo-com.svg" class="btn-icon icon-white" /> Open Settings
                            </button>
                        </div>
                    }
                    else if (isScanningWorlds && worldGroups.Count == 0)
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-white-50">
                            <div class="spinner-border text-accent mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
                            <h5 class="text-white">Scanning Screenshot Metadata...</h5>
                            <p class="small text-white-50">Analyzing VRChat worlds from photos (@scannedCount / @totalFilesToScan photos scanned)</p>
