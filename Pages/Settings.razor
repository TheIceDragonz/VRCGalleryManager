@code {
    private string Username = "";
    private string Password = "";
    private string Code2FA = "";
    private int CacheFilesCount = 0;
    private string CacheTotalSize = "0 B";
    private bool CacheExists = false;
    private int VrcLogsFilesCount = 0;
    private string VrcLogsTotalSize = "0 B";
    private bool VrcLogsExists = false;
    private bool IsLoggingIn = false;
    private bool HasVRCPlus = false;
    private bool HasUpdate = false;
    private string LatestUpdateVersion = "";
    private string LocalVersion = "";
    private bool IsUpdating = false;
    private int UpdateProgressPercentage = 0;
    private bool _isPromptingUpdate = false;
    [SupplyParameterFromQuery]
    public bool? PromptUpdate { get; set; }
    private bool ShowPassword = false;
    private bool Show2FA = false;
    private bool IsEmail2FA = false;
    private bool ShowLicensesModal = false;

    private int PicflowDbTotal = 0;
    private int PicflowDbStickers = 0;
    private int PicflowDbEmojis = 0;
    private int PicflowDbPrints = 0;

    private bool DisplayVRCProfileBackgrounds
    {
        get => BackgroundService.DisplayVRCProfileBackgrounds;
        set => BackgroundService.DisplayVRCProfileBackgrounds = value;
    }

    private bool DisplayVRCProfileThemes
    {
        get => BackgroundService.DisplayVRCProfileThemes;
        set => BackgroundService.DisplayVRCProfileThemes = value;
    }

    private bool DisplayVRCCosmetics
    {
        get => BackgroundService.DisplayVRCCosmetics;
        set => BackgroundService.DisplayVRCCosmetics = value;
    }

    private bool _startWithWindows;
    private bool StartWithWindows
    {
        get => _startWithWindows;
        set { _startWithWindows = value; Config.Set("StartWithWindows", value ? "true" : "false"); WindowsStartupHelper.SetStartup(value); }
    }

    private bool _startInBackground;
    private bool StartInBackground
    {
        get => _startInBackground;
        set { _startInBackground = value; Config.Set("StartInBackground", value ? "true" : "false"); }
    }

    private bool _minimizeToTray;
    private bool MinimizeToTray
    {
        get => _minimizeToTray;
        set { _minimizeToTray = value; Config.Set("MinimizeToTray", value ? "true" : "false"); }
    }

    private bool IsLoggedIn => (Auth.LoggedIn || Auth.CookieLoaded) && Auth.CurrentUser != null && !string.IsNullOrEmpty(Auth.CurrentUser.Id);

    protected override async Task OnInitializedAsync()
    {
        AppEvents.RequestPromptUpdate += HandleRequestPromptUpdate;
        await Auth.EnsureInitializedAsync();
        _startWithWindows = Config.Get("StartWithWindows", "false") == "true";
        _startInBackground = Config.Get("StartInBackground", "false") == "true";
        _minimizeToTray = Config.Get("MinimizeToTray", "true") == "true";

        _ = Task.Run(() =>
        {
            UpdateCacheInfo();
            UpdateVRChatLogsInfo();
            UpdatePicflowDbStats();
            InvokeAsync(StateHasChanged);
        });

        LocalVersion = UpdateManager.GetCurrentVersion();

        try
        {
            var updateCheck = await Updater.IsUpdateAvailableAsync();
            HasUpdate = updateCheck.isAvailable;
            if (!string.IsNullOrEmpty(updateCheck.localVersion))
            {
                LocalVersion = updateCheck.localVersion;
            }
            if (HasUpdate)
            {
                LatestUpdateVersion = updateCheck.latestVersion;
            }
        }
        catch { }

        if (Auth.Is2FARequired)
        {
            var creds = await Auth.LoadCredentialsAsync();
            if (creds != null && !string.IsNullOrEmpty(creds.Value.username))
            {
                Username = creds.Value.username;
            }
            else
            {
                try { Username = await SecureStorage.Default.GetAsync("auth_username") ?? Username; } catch { }
            }
            Password = "";
            ShowPassword = false;
            IsEmail2FA = Auth.IsEmail2FA;
            Show2FA = true;
            Notifications.Show("Authentication required. Please enter the new 2FA code.", "2FA Required", VRCGalleryManager.Core.NotificationType.Info);
            return;
        }

        if (Auth.LoggedIn || Auth.CookieLoaded)
        {
            if (Auth.CurrentUser != null && !string.IsNullOrEmpty(Auth.CurrentUser.Id))
            {
                ApplyCurrentUser(Auth.CurrentUser);
            }
            else
            {
                await LoadCurrentUser();
            }
        }
        else
        {
            var creds = await Auth.LoadCredentialsAsync();
            if (creds != null && !string.IsNullOrEmpty(creds.Value.username))
            {
                Username = creds.Value.username;
            }
            else
            {
                try { Username = await SecureStorage.Default.GetAsync("auth_username") ?? Username; } catch { }
            }
            Password = "";
            ShowPassword = false;
        }
    }

    private void ApplyCurrentUser(CurrentUser user)
    {
        if (user == null) return;
        Username = user.DisplayName;
        Password = "";
        ShowPassword = false;

        // Check VRChat Plus badge or tag
        HasVRCPlus = VRCAuth.CheckHasVRCPlus(user);
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var user = Auth.CurrentUser ?? await Auth.AuthApi.GetCurrentUserAsync();
            if (user != null && !string.IsNullOrEmpty(user.Id))
            {
                Auth.CurrentUser = user;
                ApplyCurrentUser(user);
            }
            else
            {
                Auth.CurrentUser = null;
                throw new VRChatApiException(401, "User is not authenticated or 2FA is required.");
            }
        }
        catch (VRChatApiException ex) when (ex.StatusCode == 401)
        {
            try
            {
                IsLoggingIn = true;
                StateHasChanged();

                bool success = await Auth.TryAutoReloginAsync();
                if (success)
                {
                    var user = await Auth.AuthApi.GetCurrentUserAsync();
                    Auth.CurrentUser = user;
                    ApplyCurrentUser(user);
                }
                else if (Auth.Is2FARequired)
                {
                    Password = "";
                    ShowPassword = false;
                    IsEmail2FA = Auth.IsEmail2FA;
                    Show2FA = true;
                    Notifications.Show("IP changed. Please enter your 2FA code.", "2FA Required", VRCGalleryManager.Core.NotificationType.Info);
                }
                else
                {
                    var creds = await Auth.LoadCredentialsAsync();
                    if (creds != null && !string.IsNullOrEmpty(creds.Value.username))
                    {
                        Username = creds.Value.username;
                    }
                    Password = "";
                    ShowPassword = false;
                    Auth.Logout(keepCredentials: true);
                    Notifications.Show("Session expired and auto-login failed. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
                }
            }
            catch
            {
                var creds = await Auth.LoadCredentialsAsync();
                if (creds != null && !string.IsNullOrEmpty(creds.Value.username))
                {
                    Username = creds.Value.username;
                }
                Password = "";
                ShowPassword = false;
                Auth.Logout(keepCredentials: true);
                Notifications.Show("Session expired and auto-login failed. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
            }
            finally
            {
                IsLoggingIn = false;
                StateHasChanged();
            }
        }
        catch
        {
            var creds = await Auth.LoadCredentialsAsync();
            if (creds != null && !string.IsNullOrEmpty(creds.Value.username))
            {
                Username = creds.Value.username;
            }
            Password = "";
            ShowPassword = false;
            Auth.Logout(keepCredentials: true);
            Notifications.Show("Session expired. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
            StateHasChanged();
        }
    }

    private async Task ToggleLogin()
    {
        if (IsLoggedIn)
        {
            try { await Auth.AuthApi.LogoutAsync(); } catch { }
            finally
            {
                Auth.Logout();
                Username = "";
                Password = "";
                HasVRCPlus = false;
                ShowPassword = false;
                Show2FA = false;
                Code2FA = "";
            }
        }
        else
        {
            IsLoggingIn = true;
            StateHasChanged();
            try
            {
                var status = await Auth.LoginAsync(Username, Password, isManualLogin: true);
                if (status == VRCAuthStatus.RequiresEmail2FA || status == VRCAuthStatus.RequiresApp2FA)
                {
                    await Auth.SaveCredentialsAsync(Username, Password);
                    Password = "";
                    ShowPassword = false;
                    IsEmail2FA = status == VRCAuthStatus.RequiresEmail2FA;
                    Show2FA = true;
                }
                else if (status == VRCAuthStatus.Success)
                {
                    await Auth.SaveCredentialsAsync(Username, Password);
                    Password = "";
                    ShowPassword = false;
                    await LoadCurrentUser();
                }
                else
                {
                    Password = "";
                    ShowPassword = false;
                    Notifications.Show(string.IsNullOrEmpty(Auth.LastErrorMessage) ? "Invalid credentials or connection error." : Auth.LastErrorMessage, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
                }
            }
            catch (Exception ex)
            {
                Password = "";
                ShowPassword = false;
                Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
            finally
            {
                IsLoggingIn = false;
            }
        }
    }

    private async Task Submit2FA()
    {
        if (string.IsNullOrWhiteSpace(Code2FA)) return;
        
        IsLoggingIn = true;
        StateHasChanged();
        
        try
        {
            var status = await Auth.Verify2FAAsync(Code2FA, IsEmail2FA);
            if (status == VRCAuthStatus.Success)
            {
                Show2FA = false;
                Code2FA = "";
                Password = "";
                ShowPassword = false;
                if (Auth.CurrentUser != null)
                {
                    ApplyCurrentUser(Auth.CurrentUser);
                }
                else
                {
                    await LoadCurrentUser();
                }
            }
            else
            {
                Notifications.Show(string.IsNullOrEmpty(Auth.LastErrorMessage) ? "Invalid 2FA code." : Auth.LastErrorMessage, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
        }
        finally
        {
            IsLoggingIn = false;
            StateHasChanged();
        }
    }

    private async Task Cancel2FA()
    {
        Show2FA = false;
        Code2FA = "";
        Password = "";
        ShowPassword = false;
        IsLoggingIn = false;

        // Reset auth state and remove unverified partial session cookies
        Auth.Logout(keepCredentials: true);

        // Remove stored password so auto-login won't immediately re-trigger 2FA without user action
        try
        {
            SecureStorage.Default.Remove("auth_password");
        }
        catch { }

        // Keep username prefilled in the login form for convenience
        try
        {
            var storedUser = await SecureStorage.Default.GetAsync("auth_username");
            if (!string.IsNullOrEmpty(storedUser))
            {
                Username = storedUser;
            }
        }
        catch { }

        StateHasChanged();
    }

    private async Task Resend2FA()
    {
        IsLoggingIn = true;
        StateHasChanged();
        
        try
        {
            var creds = await Auth.LoadCredentialsAsync();
            if (creds == null)
            {
                Notifications.Show("Saved credentials not found. Please log in again.", "Login Error", VRCGalleryManager.Core.NotificationType.Error);
                Cancel2FA();
                return;
            }

            var status = await Auth.LoginAsync(creds.Value.username, creds.Value.password, isManualLogin: false);
            Password = "";
            ShowPassword = false;
            if (status == VRCAuthStatus.RequiresEmail2FA)
            {
                Notifications.Show("New code sent to your email!", "2FA", VRCGalleryManager.Core.NotificationType.Success);
            }
            else if (status == VRCAuthStatus.Success)
            {
                Show2FA = false;
                Code2FA = "";
                await LoadCurrentUser();
            }
            else
            {
                Notifications.Show(string.IsNullOrEmpty(Auth.LastErrorMessage) ? "Unexpected status when resending code." : Auth.LastErrorMessage, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            Password = "";
            ShowPassword = false;
            Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private async Task On2FAKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit2FA();
    }

    private async Task OnUsernameKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OpenGitHub()
    {
        await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri("https://github.com/TheIceDragonz/VRCGalleryManager"));
    }

