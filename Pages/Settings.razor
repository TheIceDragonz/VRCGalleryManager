@page "/settings"
@using VRCGalleryManager.Core
@using System.IO
@using Microsoft.AspNetCore.Components.Web
@using VRChat.API.Model
@inject VRCAuth Auth
@inject DialogService dialogService
@inject UpdateManager Updater
@inject NotificationService Notifications

<div class="settings-page container-fluid h-100 p-4 overflow-y-auto">
    <div class="d-flex flex-column gap-4 max-w-600 mx-auto w-100">
        <h3 class="mb-1 text-center">Settings</h3>
        <!-- Login Panel -->
        <div class="panel d-flex flex-column gap-3">
            @if (Show2FA)
            {
                <h4 class="mb-2 text-accent">Two-Factor Authentication</h4>
                <p class="text-muted mb-2 text-09rem">@(IsEmail2FA ? "Enter the code sent to your email." : "Enter the code from your Authenticator app.")</p>
                
                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Auth Code</label>
                    <input type="text" class="form-control" @bind="Code2FA" @onkeydown="On2FAKeyDown" placeholder="123456" />
                </div>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill py-2" @onclick="Cancel2FA" disabled="@IsLoggingIn">Cancel</button>
                    @if (IsEmail2FA)
                    {
                        <button class="btn btn-outline-primary flex-fill py-2" @onclick="Resend2FA" disabled="@IsLoggingIn" title="Resend Email Code">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    }
                    <button class="btn btn-primary flex-fill py-2" @onclick="Submit2FA" disabled="@IsLoggingIn">
                        @if (IsLoggingIn)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Verify
                    </button>
                </div>
                

            }
            else
            {
                <h4 class="mb-2 @(IsLoggedIn ? "text-accent" : "")">
                    @(IsLoggedIn ? "Logged In" : "VRChat Login")
                </h4>

                @if (IsLoggedIn && !HasVRCPlus)
                {
                    <div class="alert mb-0 p-3 d-flex align-items-center gap-2 alert-vrcplus">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>You need <strong>VRChat Plus</strong> to use this program.</span>
                    </div>
                }

                <div class="mb-2">
                    <label class="form-label text-muted mb-1">Username</label>
                    <input type="text" class="form-control" @bind="Username" disabled="@IsLoggedIn" @onkeydown="OnUsernameKeyDown" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Password</label>
                    <div class="input-group">
                        <input type="@(ShowPassword ? "text" : "password")" class="form-control password-input" @bind="Password" @bind:event="oninput" disabled="@IsLoggedIn" @onkeydown="OnPasswordKeyDown" />
                        @if (!IsLoggedIn && !string.IsNullOrEmpty(Password))
                        {
                            <button class="btn btn-password-toggle p-2" type="button" @onclick="() => ShowPassword = !ShowPassword" title="@(ShowPassword ? "Hide password" : "Show password")">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin-right: 0;" />
                            </button>
                        }
                    </div>
                </div>

                <button class="btn @(IsLoggedIn ? "btn-outline-danger" : "btn-primary") w-100 py-2" @onclick="ToggleLogin" disabled="@IsLoggingIn">
                    @if (IsLoggingIn)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    @(IsLoggedIn ? "Logout" : "Login")
                </button>


            }
        </div>

        <!-- About Panel -->
        <div class="panel d-flex flex-column gap-3">
            <h4 class="mb-2">About</h4>
                <p class="text-muted mb-0">VRCGalleryManager v2.0</p>
                <button class="btn w-100" @onclick="OpenGitHub">
                    <img src="/svg/info-circle-svgrepo-com.svg" class="btn-icon" />Open GitHub Page
                </button>
                @if (HasUpdate)
                {
                    @if (IsUpdating)
                    {
                        <div class="mt-2 p-3 panel" style="background-color: var(--bg-hover); border: 1px solid var(--accent); box-shadow: 0 0 10px rgba(106, 227, 249, 0.2);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="spinner-border spinner-border-sm" style="color: var(--accent);" role="status"></span>
                                    <span class="fw-bold" style="color: var(--accent);">Downloading Update...</span>
                                </div>
                                <span class="text-white small fw-bold">@(UpdateProgressPercentage)%</span>
                            </div>
                            <div class="progress" style="height: 8px; background-color: var(--bg-active);">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(UpdateProgressPercentage)%; background-color: var(--accent);"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-warning w-100 mt-2 fw-bold text-dark" @onclick="StartUpdate">
                            <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="filter: invert(0);" />New Update Available!
                        </button>
                    }
                }

            </div>
        <!-- System Panel -->
        <div class="panel d-flex flex-column">
            <h4 class="mb-4">System</h4>

                @if (!OperatingSystem.IsAndroid())
                {
                    <h5 class="mt-0 mb-3 text-muted fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.8rem;">Application Behavior</h5>
                    <div class="d-flex flex-column mb-4 panel shadow-none border-0" style="background-color: var(--bg-hover); padding: 0;">
                        
                        <!-- Start with Windows -->
                        <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color: var(--border-color) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px; border-radius: 10px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M22 2L11.2 3.6V11.6H22V2ZM10 3.8L2 5V11.6H10V3.8ZM2 12.4V19L10 20.2V12.4H2ZM11.2 12.4V20.4L22 22V12.4H11.2Z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-white fw-bold">Start with Windows</h6>
                                    <div class="text-muted" style="font-size: 0.85rem;">Automatically launch the app when your PC boots</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="startWithWindows" @bind="StartWithWindows">
                            </div>
                        </div>
                        
                        <!-- Start in Background -->
                        <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color: var(--border-color) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px; border-radius: 10px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-white fw-bold">Start in Background</h6>
                                    <div class="text-muted" style="font-size: 0.85rem;">Launch silently into the system tray without showing the window</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="startInBackground" @bind="StartInBackground" disabled="@(!StartWithWindows)">
                            </div>
                        </div>

                        <!-- Minimize to Tray -->
                        <div class="d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px; border-radius: 10px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M21 3H3v18h18V3zM9 13H5l7-7 7 7h-4v4H9v-4z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-white fw-bold">Minimize to Tray</h6>
                                    <div class="text-muted" style="font-size: 0.85rem;">Hide to the system tray instead of closing the application</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="minimizeToTray" @bind="MinimizeToTray">
                            </div>
                        </div>

                    </div>
                }   

                @if (OperatingSystem.IsWindows())
                {
                    <h5 class="mt-4 mb-2 text-muted text-09rem">VRChat Logs Information</h5>
                    @if (VrcLogsExists)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                    <i class="bi bi-files text-primary fs-3"></i>
                                    <div class="d-flex flex-column">
                                        <span class="text-muted small text-uppercase fw-bold">Files</span>
                                        <span class="fw-bold fs-5">@VrcLogsFilesCount</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                    <i class="bi bi-hdd-fill text-success fs-3"></i>
                                    <div class="d-flex flex-column">
                                        <span class="text-muted small text-uppercase fw-bold">Total Size</span>
                                        <span class="fw-bold fs-5">@VrcLogsTotalSize</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 cache-info-box text-warning d-flex align-items-center mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> VRChat logs folder not found.
                        </div>
                    }

                    <div class="d-flex flex-column gap-2 mb-4">
                        <button class="btn text-nowrap w-100" @onclick="OpenVRChatLogs">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open Logs
                        </button>
                        <button class="btn btn-danger text-nowrap w-100" @onclick="ClearVRChatLogs">
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear Logs
                        </button>
                    </div>
                }

                <h5 class="mt-4 mb-2 text-muted text-09rem">Cache Information</h5>
                @if (CacheExists)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                <i class="bi bi-files text-primary fs-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Files</span>
                                    <span class="fw-bold fs-5">@CacheFilesCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                <i class="bi bi-hdd-fill text-success fs-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Total Size</span>
                                    <span class="fw-bold fs-5">@CacheTotalSize</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3 cache-info-box text-warning d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Cache folder not found.
                    </div>
                }

                <div class="d-flex flex-column gap-2 mb-4">
                    @if (!OperatingSystem.IsAndroid())
                    {
                        <button class="btn text-nowrap w-100" @onclick="OpenCacheFolder">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open Cache
                        </button>
                    }
                    <button class="btn btn-danger text-nowrap w-100" @onclick="ClearCacheFiles">
                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear Cache
                    </button>
                </div>
                
                @if (OperatingSystem.IsWindows())
                {
                    <h5 class="mt-4 mb-2 text-muted text-09rem">Picflow Database</h5>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                <i class="bi bi-database-fill text-info fs-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Total Saved</span>
                                    <span class="fw-bold fs-5">@PicflowDbTotal</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex flex-column justify-content-center gap-1">
                                <div class="d-flex justify-content-between">
                                    <span class="small text-muted">Stickers</span><span class="small fw-bold">@PicflowDbStickers</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="small text-muted">Emojis</span><span class="small fw-bold">@PicflowDbEmojis</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="small text-muted">Prints</span><span class="small fw-bold">@PicflowDbPrints</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-outline-danger w-100" @onclick="ClearPicflowDb" disabled="@(PicflowDbTotal == 0)">
                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" /> Clear Picflow Database
                    </button>
                }
            </div>
        </div>
    </div>

@code {
    private string Username = "";
    private string Password = "";
    private string Code2FA = "";
    private int CacheFilesCount = 0;
    private string CacheTotalSize = "0 B";
    private bool CacheExists = false;
    private int VrcLogsFilesCount = 0;
    private string VrcLogsTotalSize = "0 B";
    private bool VrcLogsExists = false;
    private bool IsLoggingIn = false;
    private bool HasVRCPlus = false;
    private bool HasUpdate = false;
    private string LatestUpdateVersion = "";
    private string LocalVersion = "";
    private bool IsUpdating = false;
    private int UpdateProgressPercentage = 0;
    private bool ShowPassword = false;
    private bool Show2FA = false;
    private bool IsEmail2FA = false;

    private int PicflowDbTotal = 0;
    private int PicflowDbStickers = 0;
    private int PicflowDbEmojis = 0;
    private int PicflowDbPrints = 0;

    private bool _startWithWindows;
    private bool StartWithWindows
    {
        get => _startWithWindows;
        set { _startWithWindows = value; Config.Set("StartWithWindows", value ? "true" : "false"); WindowsStartupHelper.SetStartup(value); }
    }

    private bool _startInBackground;
    private bool StartInBackground
    {
        get => _startInBackground;
        set { _startInBackground = value; Config.Set("StartInBackground", value ? "true" : "false"); }
    }

    private bool _minimizeToTray;
    private bool MinimizeToTray
    {
        get => _minimizeToTray;
        set { _minimizeToTray = value; Config.Set("MinimizeToTray", value ? "true" : "false"); }
    }

    private bool IsLoggedIn => Auth.LoggedIn || Auth.CookieLoaded;

    protected override async Task OnInitializedAsync()
    {
        _startWithWindows = Config.Get("StartWithWindows", "false") == "true";
        _startInBackground = Config.Get("StartInBackground", "false") == "true";
        _minimizeToTray = Config.Get("MinimizeToTray", "true") == "true";

        UpdateCacheInfo();
        UpdateVRChatLogsInfo();
        UpdatePicflowDbStats();

        if (OperatingSystem.IsWindows())
        {
            try
            {
                var updateCheck = await Updater.IsUpdateAvailableAsync();
                HasUpdate = updateCheck.isAvailable;
                if (HasUpdate)
                {
                    LatestUpdateVersion = updateCheck.latestVersion;
                    LocalVersion = updateCheck.localVersion;
                }
            }
            catch { }
        }

        if (Auth.Is2FARequired)
        {
            var creds = Auth.LoadCredentials();
            if (creds != null)
            {
                Username = creds.Value.username;
                Password = creds.Value.password;
            }
            IsEmail2FA = Auth.IsEmail2FA;
            Show2FA = true;
            Notifications.Show("Authentication required. Please enter the new 2FA code.", "2FA Required", VRCGalleryManager.Core.NotificationType.Info);
            return;
        }

        if (IsLoggedIn)
        {
            if (Auth.CurrentUser != null)
            {
                ApplyCurrentUser(Auth.CurrentUser);
            }
            else
            {
                await LoadCurrentUser();
            }
        }
    }

    private void ApplyCurrentUser(CurrentUser user)
    {
        Username = user.DisplayName;
        Password = "password";
        ShowPassword = false;

        // Check VRChat Plus badge or tag
        HasVRCPlus = false;
        if (user.Badges != null)
        {
            foreach (var badge in user.Badges)
            {
                if (badge.BadgeId == "bdg_754f9935-0f97-49d8-b857-95afb9b673fa")
                {
                    HasVRCPlus = true;
                    break;
                }
            }
        }
        
        if (!HasVRCPlus && user.Tags != null && user.Tags.Contains("system_supporter"))
        {
            HasVRCPlus = true;
        }
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var user = await Auth.AuthApi.GetCurrentUserAsync();
            Auth.CurrentUser = user;
            ApplyCurrentUser(user);
        }
        catch (VRChat.API.Client.ApiException ex) when (ex.ErrorCode == 401)
        {
            try
            {
                IsLoggingIn = true;
                StateHasChanged();

                var creds = Auth.LoadCredentials();
                if (creds != null)
                {
                    Username = creds.Value.username;
                    Password = creds.Value.password;
                }
                
                bool success = await Auth.TryAutoReloginAsync();
                if (success)
                {
                    var user = await Auth.AuthApi.GetCurrentUserAsync();
                    Auth.CurrentUser = user;
                    ApplyCurrentUser(user);
                }
                else if (Auth.Is2FARequired)
                {
                    IsEmail2FA = Auth.IsEmail2FA;
                    Show2FA = true;
                    Notifications.Show("IP changed. Please enter your 2FA code.", "2FA Required", VRCGalleryManager.Core.NotificationType.Info);
                }
                else
                {
                    Auth.Logout(keepCredentials: true);
                    Notifications.Show("Session expired and auto-login failed. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
                }
            }
            catch
            {
                Auth.Logout(keepCredentials: true);
                Notifications.Show("Session expired and auto-login failed. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
            }
            finally
            {
                IsLoggingIn = false;
                StateHasChanged();
            }
        }
        catch
        {
            Auth.Logout(keepCredentials: true);
            Notifications.Show("Session expired. Please log in again.", "Session Expired", VRCGalleryManager.Core.NotificationType.Error);
            StateHasChanged();
        }
    }

    private async Task ToggleLogin()
    {

        if (IsLoggedIn)
        {
            try { Auth.AuthApi.Logout(); } catch { }
            finally
            {
                Auth.Logout();
                Username = "";
                Password = "";
                HasVRCPlus = false;
                ShowPassword = false;
                Show2FA = false;
                Code2FA = "";
            }
        }
        else
        {
            IsLoggingIn = true;
            StateHasChanged();
            try
            {
                var status = await Auth.LoginAsync(Username, Password);
                if (status == VRCAuthStatus.RequiresEmail2FA)
                {
                    IsEmail2FA = true;
                    Show2FA = true;
                }
                else if (status == VRCAuthStatus.RequiresApp2FA)
                {
                    IsEmail2FA = false;
                    Show2FA = true;
                }
                else if (status == VRCAuthStatus.Success)
                {
                    Auth.SaveCredentials(Username, Password);
                    await LoadCurrentUser();
                }
                else
                {
                    Notifications.Show(string.IsNullOrEmpty(Auth.LastErrorMessage) ? "Invalid credentials or connection error." : Auth.LastErrorMessage, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
                }
            }
            catch (Exception ex)
            {
                Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
            finally
            {
                IsLoggingIn = false;
            }
        }
    }

    private async Task Submit2FA()
    {
        if (string.IsNullOrWhiteSpace(Code2FA)) return;
        
        IsLoggingIn = true;

        StateHasChanged();
        
        try
        {
            var status = await Auth.Verify2FAAsync(Code2FA, IsEmail2FA);
            if (status == VRCAuthStatus.Success)
            {
                Auth.SaveCredentials(Username, Password);
                Show2FA = false;
                Code2FA = "";
                Password = "";
                await LoadCurrentUser();
            }
            else
            {
                Notifications.Show("Invalid 2FA code.", "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private void Cancel2FA()
    {
        Show2FA = false;
        Code2FA = "";

    }

    private async Task Resend2FA()
    {
        IsLoggingIn = true;

        StateHasChanged();
        
        try
        {
            // Clear temporary headers so VRChat treats this as a fresh login request (and thus sends a new code)
            Auth.Config.ApiKey.Clear();
            Auth.Config.DefaultHeaders.Clear();
            Auth.ApiClient = new VRChat.API.Client.ApiClient(Auth.Config.BasePath);
            Auth.AuthApi = new VRChat.API.Api.AuthenticationApi(Auth.ApiClient, Auth.ApiClient, Auth.Config);

            var status = await Auth.LoginAsync(Username, Password);
            if (status == VRCAuthStatus.RequiresEmail2FA)
            {
                // Just notify that a new code has been sent
                Notifications.Show("New code sent to your email!", "2FA", VRCGalleryManager.Core.NotificationType.Success);
            }
            else if (status == VRCAuthStatus.Success)
            {
                // Somehow they logged in without 2FA (e.g. they turned it off in the meantime)
                Auth.SaveCredentials(Username, Password);
                Show2FA = false;
                Code2FA = "";
                Password = "";
                await LoadCurrentUser();
            }
            else
            {
                Notifications.Show("Unexpected status when resending code.", "Login Error", VRCGalleryManager.Core.NotificationType.Error);
            }
        }
        catch (Exception ex)
        {
            Notifications.Show(ex.Message, "Login Error", VRCGalleryManager.Core.NotificationType.Error);
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private async Task On2FAKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit2FA();
    }

    private async Task OnUsernameKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OpenGitHub()
    {
        await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri("https://github.com/TheIceDragonz/VRCGalleryManager"));
    }

    private async Task StartUpdate()
    {
        bool confirmed = await dialogService.ShowConfirmAsync(
            "Update Available", 
            $"A new version ({LatestUpdateVersion}) is available.\nYou are currently on version {LocalVersion}.\n\nDo you want to download and install it?", 
            "Yes", "No");
        if (!confirmed) return;

        IsUpdating = true;
        UpdateProgressPercentage = 0;
        StateHasChanged();

        try
        {
            await Updater.DownloadAndInstallUpdateAsync(Notifications, (progressText, progressInt, isError) => 
            {
                if (!isError)
                {
                    UpdateProgressPercentage = progressInt;
                    InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (Exception ex)
        {
            Notifications.Show($"Update failed: {ex.Message}", "Update Error", VRCGalleryManager.Core.NotificationType.Error);
            IsUpdating = false;
            StateHasChanged();
        }
    }

    private void OpenCacheFolder()
    {
        if (!OperatingSystem.IsWindows())
        {
            ShowSystemMessage("Opening folders is only supported on Windows.", true);
            return;
        }

        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (Directory.Exists(cacheFolderPath))
            System.Diagnostics.Process.Start("explorer.exe", cacheFolderPath);
        else
            ShowSystemMessage("Cache folder does not exist.", true);
    }

    private void OpenVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");
        if (Directory.Exists(vrchatLogPath))
            System.Diagnostics.Process.Start("explorer.exe", vrchatLogPath);
        else
            ShowSystemMessage("VRChat logs folder does not exist.", true);
    }

    private async Task ClearVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");

        string[] logFiles = Directory.Exists(vrchatLogPath)
            ? Directory.GetFiles(vrchatLogPath, "output_log_*.txt")
            : Array.Empty<string>();

        if (logFiles.Length == 0)
        {
            ShowSystemMessage("No log files found.", true);
            return;
        }

        bool confirmed = await dialogService.ShowConfirmAsync("Clear Logs", $"Do you want to delete {logFiles.Length} VRChat log file(s)?", "Delete", "Cancel");
        if (confirmed)
        {
            foreach (var file in logFiles)
                try { System.IO.File.Delete(file); } catch { }
            Notifications.Show("All VRChat logs have been successfully deleted!", "System", VRCGalleryManager.Core.NotificationType.Success);
            UpdateVRChatLogsInfo();
        }
    }

    private async Task ClearCacheFiles()
    {
        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");

        if (!Directory.Exists(cacheFolderPath))
        {
            ShowSystemMessage("Cache folder does not exist.", true);
            return;
        }

        string[] cacheFiles = Directory.GetFiles(cacheFolderPath);
        if (cacheFiles.Length == 0)
        {
            ShowSystemMessage("No cache files found.", true);
            return;
        }

        bool confirmed = await dialogService.ShowConfirmAsync("Clear Cache", "Do you want to delete all cache files?", "Delete", "Cancel");
        if (confirmed)
        {
            foreach (var file in cacheFiles)
                try { System.IO.File.Delete(file); } catch { }
            ShowSystemMessage("All cache files have been successfully deleted!", false);
            UpdateCacheInfo();
        }
    }

    private void ShowSystemMessage(string message, bool isError)
    {
        Notifications.Show(message, isError ? "Error" : "System", isError ? VRCGalleryManager.Core.NotificationType.Error : VRCGalleryManager.Core.NotificationType.Success);
    }

    private void UpdateCacheInfo()
    {
        string cacheFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (!Directory.Exists(cacheFolder))
        {
            try { Directory.CreateDirectory(cacheFolder); } catch { }
        }
        
        CacheExists = Directory.Exists(cacheFolder);
        if (CacheExists)
        {
            string[] files = Directory.GetFiles(cacheFolder);
            CacheFilesCount = files.Length;
            long totalSize = files.Sum(file => new FileInfo(file).Length);

            string[] units = { "B", "KB", "MB", "GB", "TB" };
            double size = totalSize;
            int unitIndex = 0;
            while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }

            CacheTotalSize = $"{size:0.##} {units[unitIndex]}";
        }
        else
        {
            CacheFilesCount = 0;
            CacheTotalSize = "0 B";
        }
    }

    private void UpdateVRChatLogsInfo()
    {
        if (!OperatingSystem.IsWindows()) return;
        
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");
        
        VrcLogsExists = Directory.Exists(vrchatLogPath);
        if (VrcLogsExists)
        {
            string[] files = Directory.GetFiles(vrchatLogPath, "output_log_*.txt");
            VrcLogsFilesCount = files.Length;
            long totalSize = files.Sum(file => new FileInfo(file).Length);

            string[] units = { "B", "KB", "MB", "GB", "TB" };
            double size = totalSize;
            int unitIndex = 0;
            while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }

            VrcLogsTotalSize = $"{size:0.##} {units[unitIndex]}";
        }
        else
        {
            VrcLogsFilesCount = 0;
            VrcLogsTotalSize = "0 B";
        }
    }

    private void UpdatePicflowDbStats()
    {
        PicflowDatabase.Load();
        var allItems = PicflowDatabase.GetAll().Values;
        PicflowDbTotal = allItems.Count;
        
        // 0 = Sticker, 1 = Emoji, 2 = Print (assuming Picflow.ItemCategory maps to 0, 1, 2)
        PicflowDbStickers = allItems.Count(x => x.CategoryInt == 0);
        PicflowDbEmojis = allItems.Count(x => x.CategoryInt == 1);
        PicflowDbPrints = allItems.Count(x => x.CategoryInt == 2);
    }

    private async Task ClearPicflowDb()
    {
        bool confirmed = await dialogService.ShowConfirmAsync("Clear Picflow DB", "Are you sure you want to delete all saved items from the Picflow database?", "Delete", "Cancel");
        if (confirmed)
        {
            PicflowDatabase.Clear();
            UpdatePicflowDbStats();
            Notifications.Show("Picflow database has been successfully cleared!", "System", VRCGalleryManager.Core.NotificationType.Success);
        }
    }
