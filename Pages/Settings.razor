    }

    private void OpenLicenses()
    {
        ShowLicensesModal = true;
    }

    private void CloseLicenses()
    {
        ShowLicensesModal = false;
    }

    private async Task OpenExternalUrl(string url)
    {
        try
        {
            if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
            {
                await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(uri);
            }
        }
        catch { }
    }

    private async Task OpenVRCPlusSubscriptions()
    {
        await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri("https://vrchat.com/home/subscriptions"));
    }

    private async Task OpenAndroidUpdate()
    {
        await StartUpdate();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PromptUpdate == true)
        {
            PromptUpdate = null;
            _ = InvokeAsync(async () =>
            {
                await Task.Delay(200);
                await StartUpdate();
            });
        }
    }

    private void HandleRequestPromptUpdate()
    {
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(100);
            await StartUpdate();
        });
    }

    private async Task StartUpdate()
    {
        if (IsUpdating || _isPromptingUpdate) return;

        _isPromptingUpdate = true;
        try
        {
            if (string.IsNullOrEmpty(LatestUpdateVersion))
            {
                var updateCheck = await Updater.IsUpdateAvailableAsync();
                if (updateCheck.isAvailable)
                {
                    HasUpdate = true;
                    LatestUpdateVersion = updateCheck.latestVersion;
                    LocalVersion = updateCheck.localVersion;
                }
            }

            bool confirmed = await dialogService.ShowConfirmAsync(
                "Update Available", 
                $"A new version ({LatestUpdateVersion}) is available.\nYou are currently on version {LocalVersion}.\n\nDo you want to download and install it?", 
                "Yes", "No");
            if (!confirmed) return;

            IsUpdating = true;
            UpdateProgressPercentage = 0;
            StateHasChanged();

            try
            {
                await Updater.DownloadAndInstallUpdateAsync(Notifications, (progressText, progressInt, isError) => 
                {
                    if (!isError)
                    {
                        UpdateProgressPercentage = progressInt;
                        InvokeAsync(StateHasChanged);
                    }
                });
            }
            catch (Exception ex)
            {
                Notifications.Show($"Update failed: {ex.Message}", "Update Error", VRCGalleryManager.Core.NotificationType.Error);
            }
            finally
            {
                IsUpdating = false;
                InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _isPromptingUpdate = false;
        }
    }

    private void OpenCacheFolder()
    {
        if (!OperatingSystem.IsWindows())
        {
            ShowSystemMessage("Opening folders is only supported on Windows.", true);
            return;
        }

        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (Directory.Exists(cacheFolderPath))
            System.Diagnostics.Process.Start("explorer.exe", cacheFolderPath);
        else
            ShowSystemMessage("Cache folder does not exist.", true);
    }

    private void OpenVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");
        if (Directory.Exists(vrchatLogPath))
            System.Diagnostics.Process.Start("explorer.exe", vrchatLogPath);
        else
            ShowSystemMessage("VRChat logs folder does not exist.", true);
    }

    private async Task ClearVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");

        string[] logFiles = Directory.Exists(vrchatLogPath)
            ? Directory.GetFiles(vrchatLogPath, "output_log_*.txt")
            : Array.Empty<string>();

        if (logFiles.Length == 0)
        {
            ShowSystemMessage("No log files found.", true);
            return;
        }

        bool confirmed = await dialogService.ShowConfirmAsync("Clear Logs", $"Do you want to delete {logFiles.Length} VRChat log file(s)?", "Delete", "Cancel");
        if (confirmed)
        {
            foreach (var file in logFiles)
                try { System.IO.File.Delete(file); } catch { }
            Notifications.Show("All VRChat logs have been successfully deleted!", "System", VRCGalleryManager.Core.NotificationType.Success);
            UpdateVRChatLogsInfo();
        }
    }

    private async Task ClearCacheFiles()
    {
        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");

        if (!Directory.Exists(cacheFolderPath))
        {
            ShowSystemMessage("Cache folder does not exist.", true);
            return;
        }

        string[] cacheFiles = Directory.GetFiles(cacheFolderPath);
        if (cacheFiles.Length == 0)
        {
            ShowSystemMessage("No cache files found.", true);
            return;
        }

        bool confirmed = await dialogService.ShowConfirmAsync("Clear Cache", "Do you want to delete all cache files?", "Delete", "Cancel");
        if (confirmed)
        {
            foreach (var file in cacheFiles)
                try { System.IO.File.Delete(file); } catch { }
            ShowSystemMessage("All cache files have been successfully deleted!", false);
            UpdateCacheInfo();
        }
    }

    private void ShowSystemMessage(string message, bool isError)
    {
        Notifications.Show(message, isError ? "Error" : "System", isError ? VRCGalleryManager.Core.NotificationType.Error : VRCGalleryManager.Core.NotificationType.Success);
    }

    private void UpdateCacheInfo()
    {
        string cacheFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (!Directory.Exists(cacheFolder))
        {
            try { Directory.CreateDirectory(cacheFolder); } catch { }
        }
        
        CacheExists = Directory.Exists(cacheFolder);
        if (CacheExists)
        {
            string[] files = Directory.GetFiles(cacheFolder);
            CacheFilesCount = files.Length;
            long totalSize = files.Sum(file => new FileInfo(file).Length);

            string[] units = { "B", "KB", "MB", "GB", "TB" };
            double size = totalSize;
            int unitIndex = 0;
            while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }

            CacheTotalSize = $"{size:0.##} {units[unitIndex]}";
        }
        else
        {
            CacheFilesCount = 0;
            CacheTotalSize = "0 B";
        }
    }

    private void UpdateVRChatLogsInfo()
    {
        if (!OperatingSystem.IsWindows()) return;
        
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");
        
        VrcLogsExists = Directory.Exists(vrchatLogPath);
        if (VrcLogsExists)
        {
            string[] files = Directory.GetFiles(vrchatLogPath, "output_log_*.txt");
            VrcLogsFilesCount = files.Length;
            long totalSize = files.Sum(file => new FileInfo(file).Length);

            string[] units = { "B", "KB", "MB", "GB", "TB" };
            double size = totalSize;
            int unitIndex = 0;
            while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }

            VrcLogsTotalSize = $"{size:0.##} {units[unitIndex]}";
        }
        else
        {
            VrcLogsFilesCount = 0;
            VrcLogsTotalSize = "0 B";
        }
    }

    private void UpdatePicflowDbStats()
    {
        PicflowDatabase.Load();
        var allItems = PicflowDatabase.GetAll().Values;
        PicflowDbTotal = allItems.Count;
        
        // 0 = Sticker, 1 = Emoji, 2 = Print (assuming Picflow.ItemCategory maps to 0, 1, 2)
        PicflowDbStickers = allItems.Count(x => x.CategoryInt == 0);
        PicflowDbEmojis = allItems.Count(x => x.CategoryInt == 1);
        PicflowDbPrints = allItems.Count(x => x.CategoryInt == 2);
    }

    private async Task ClearPicflowDb()
    {
        bool confirmed = await dialogService.ShowConfirmAsync("Clear Picflow DB", "Are you sure you want to delete all saved items from the Picflow database?", "Delete", "Cancel");
        if (confirmed)
        {
            PicflowDatabase.Clear();
            UpdatePicflowDbStats();
            Notifications.Show("Picflow database has been successfully cleared!", "System", VRCGalleryManager.Core.NotificationType.Success);
        }
    }

    public void Dispose()
    {
        AppEvents.RequestPromptUpdate -= HandleRequestPromptUpdate;
    }
