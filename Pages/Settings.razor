@page "/settings"
@using VRCGalleryManager.Core
@using VRCGalleryManager.Core.Api
@using VRCGalleryManager.Core.Api.Models
@using System.IO
@using System.Reflection
@using Microsoft.AspNetCore.Components.Web
@inject VRCAuth Auth
@inject DialogService dialogService
@inject UpdateManager Updater
@inject NotificationService Notifications
@inject ProfileBackgroundService BackgroundService
@implements IDisposable

<div class="settings-page container-fluid h-100 p-4 overflow-y-auto">
    <div class="d-flex flex-column gap-4 max-w-600 mx-auto w-100">
        <h3 class="mb-1 text-center">Settings</h3>

        @if (IsLoggedIn && Auth.CurrentUser != null && !string.IsNullOrEmpty(Auth.CurrentUser.Id) && !HasVRCPlus)
        {
            <div class="alert mb-0 p-3 d-flex align-items-center justify-content-between gap-3 flex-wrap alert-vrcplus">
                <div class="d-flex align-items-center gap-2">
                    <img src="/svg/error-svgrepo-com.svg" class="icon-warning flex-shrink-0" style="width: 20px; height: 20px;" />
                    <span>You need <strong>VRChat Plus</strong> to use this program.</span>
                </div>
                <button type="button" class="btn-vrcplus-subscribe" @onclick="OpenVRCPlusSubscriptions">
                    <img src="/svg/link-svgrepo-com.svg" class="btn-icon" alt="" />
                    <span>Get VRChat Plus</span>
                </button>
            </div>
        }

        <!-- Login Panel -->
        <div class="panel d-flex flex-column gap-3">
            @if (Show2FA)
            {
                <h4 class="mb-2 text-accent">Two-Factor Authentication</h4>
                <p class="text-muted mb-2 text-09rem">@(IsEmail2FA ? "Enter the code sent to your email." : "Enter the code from your Authenticator app.")</p>
                
                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Auth Code</label>
                    <input type="text" class="form-control" @bind="Code2FA" @onkeydown="On2FAKeyDown" placeholder="123456" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" />
                </div>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill py-2" @onclick="Cancel2FA" disabled="@IsLoggingIn">Cancel</button>
                    <button class="btn btn-primary flex-fill py-2" @onclick="Submit2FA" disabled="@IsLoggingIn">
                        @if (IsLoggingIn)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Verify
                    </button>
                    @if (IsEmail2FA)
                    {
                        <button type="button" class="btn btn-square" @onclick="Resend2FA" disabled="@IsLoggingIn" title="Resend Email Code">
                            <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" style="width: 18px; height: 18px; margin: 0;" />
                        </button>
                    }
                </div>
                

            }
            else if (IsLoggedIn && Auth.CurrentUser != null && !string.IsNullOrEmpty(Auth.CurrentUser.Id))
            {
                var user = Auth.CurrentUser;
                string avatarUrl = !string.IsNullOrEmpty(user.UserIcon) 
                    ? user.UserIcon 
                    : (!string.IsNullOrEmpty(user.ProfilePicOverrideThumbnail) 
                        ? user.ProfilePicOverrideThumbnail 
                        : user.CurrentAvatarThumbnailImageUrl);

                <h4 class="mb-2 text-accent">VRChat Account</h4>

                <div class="settings-account-card d-flex flex-column p-3">
                    <div class="settings-account-top d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3 min-w-0 flex-grow-1">
                            <img src="@(string.IsNullOrEmpty(avatarUrl) ? "/svg/profile-user-svgrepo-com.svg" : avatarUrl)" class="settings-account-avatar flex-shrink-0" />
                            <div class="d-flex flex-column gap-1 min-w-0 flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="settings-account-name text-truncate" title="@user.DisplayName">@user.DisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(user.Pronouns))
                                    {
                                        <span class="settings-account-pronouns" title="Pronouns: @user.Pronouns">@user.Pronouns</span>
                                    }
                                    @if (user.Badges != null && user.Badges.Any(b => b.Hidden != true))
                                    {
                                        <div class="settings-badge-list settings-account-desktop-badges">
                                            @foreach (var badge in user.Badges.Where(b => b.Hidden != true))
                                            {
                                                <img src="@badge.BadgeImageUrl" class="settings-badge-item" title="@badge.BadgeName" />
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="settings-account-tags settings-account-desktop-tags d-flex align-items-center gap-1 flex-wrap mt-1">
                                    <div class="settings-pill @user.TrustClass" title="Trust Rank: @user.TrustLevel">
                                        <span>@user.TrustLevel</span>
                                    </div>

                                    @if (HasVRCPlus)
                                    {
                                        <div class="settings-pill pill-vrcplus" title="VRChat Plus Subscriber">
                                            <span>VRChat Plus</span>
                                        </div>
                                    }

                                    @if (user.AgeVerified || user.AgeVerificationStatus == "18+")
                                    {
                                        <div class="settings-pill pill-age-verified" title="Age Verified (@(user.AgeVerificationStatus ?? "18+"))">
                                            <span>@(user.AgeVerificationStatus ?? "18+") Verified</span>
                                        </div>
                                    }

                                    @if (user.Languages != null && user.Languages.Any())
                                    {
                                        @foreach (var lang in user.Languages)
                                        {
                                            <div class="settings-pill pill-language" title="Language: @lang.DisplayName">
                                                <span>@lang.Code</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-outline-danger px-3 py-2 flex-shrink-0 settings-logout-btn" @onclick="ToggleLogin" disabled="@IsLoggingIn">
                            @if (IsLoggingIn)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Logout
                        </button>
                    </div>

                    <!-- Mobile Badges & Tags (Displayed below Avatar, Name, and Logout) -->
                    <div class="settings-account-mobile-bottom">
                        @if (user.Badges != null && user.Badges.Any(b => b.Hidden != true))
                        {
                            <div class="settings-badge-list justify-content-center w-100">
                                @foreach (var badge in user.Badges.Where(b => b.Hidden != true))
                                {
                                    <img src="@badge.BadgeImageUrl" class="settings-badge-item" title="@badge.BadgeName" />
                                }
                            </div>
                        }

                        <div class="settings-account-tags d-flex align-items-center justify-content-center flex-nowrap w-100">
                            <div class="settings-pill @user.TrustClass" title="Trust Rank: @user.TrustLevel">
                                <span>@user.TrustLevel</span>
                            </div>

                            @if (HasVRCPlus)
                            {
                                <div class="settings-pill pill-vrcplus" title="VRChat Plus Subscriber">
                                    <span>VRChat Plus</span>
                                </div>
                            }

                            @if (user.AgeVerified || user.AgeVerificationStatus == "18+")
                            {
                                <div class="settings-pill pill-age-verified" title="Age Verified (@(user.AgeVerificationStatus ?? "18+"))">
                                    <span>@(user.AgeVerificationStatus ?? "18+") Verified</span>
                                </div>
                            }

                            @if (user.Languages != null && user.Languages.Any())
                            {
                                @foreach (var lang in user.Languages)
                                {
                                    <div class="settings-pill pill-language" title="Language: @lang.DisplayName">
                                        <span>@lang.Code</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <h4 class="mb-2">VRChat Login</h4>

                <div class="mb-2">
                    <label class="form-label text-muted mb-1">Username</label>
                    <input type="text" class="form-control" @bind="Username" @onkeydown="OnUsernameKeyDown" placeholder="Enter username or email" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Password</label>
                    <div class="input-group">
                        <input type="@(ShowPassword ? "text" : "password")" class="form-control password-input" @bind="Password" @bind:event="oninput" @onkeydown="OnPasswordKeyDown" placeholder="Enter password" autocomplete="current-password" autocorrect="off" autocapitalize="none" />
                        @if (!string.IsNullOrEmpty(Password))
                        {
                            <button class="btn btn-password-toggle p-2" type="button" @onclick="() => ShowPassword = !ShowPassword" title="@(ShowPassword ? "Hide password" : "Show password")">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin-right: 0;" />
                            </button>
                        }
                    </div>
                </div>

                <button class="btn btn-primary w-100 py-2" @onclick="ToggleLogin" disabled="@IsLoggingIn">
                    @if (IsLoggingIn)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Login
                </button>
            }
        </div>

        <!-- About Panel -->
        <div class="panel d-flex flex-column gap-3 about-panel">
            <h4 class="mb-1">About</h4>

            <!-- App Branding Box with Action Links -->
            <div class="about-brand-box p-3 d-flex flex-column gap-3">
                <div class="about-brand-top d-flex align-items-center justify-content-between gap-3 flex-wrap">
                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <img src="/VRCGM.png" alt="VRCGalleryManager Logo" class="about-logo flex-shrink-0" />
                        <div class="d-flex flex-column min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fs-5 fw-bold text-white text-truncate">VRCGalleryManager</span>
                                @if (OperatingSystem.IsAndroid())
                                {
                                    <span class="badge about-platform-badge about-platform-badge-android" title="Android">
                                        <img src="/svg/android-svgrepo-com.svg" class="about-platform-icon" alt="Android" />
                                    </span>
                                }
                                else if (OperatingSystem.IsWindows())
                                {
                                    <span class="badge about-platform-badge about-platform-badge-win" title="Windows">
                                        <img src="/svg/windows-svgrepo-com.svg" class="about-platform-icon" alt="Windows" />
                                    </span>
                                }
                                else if (OperatingSystem.IsMacOS() || OperatingSystem.IsMacCatalyst() || OperatingSystem.IsIOS())
                                {
                                    <span class="badge about-platform-badge about-platform-badge-apple" title="Apple">
                                        <img src="/svg/apple-svgrepo-com.svg" class="about-platform-icon" alt="Apple" />
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                <span class="badge about-version-badge">v@(LocalVersion)</span>
                                @if (HasUpdate && !string.IsNullOrEmpty(LatestUpdateVersion))
                                {
                                    <span class="badge about-update-badge" title="New version available: v@(LatestUpdateVersion)">
                                        ➜ v@(LatestUpdateVersion)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="about-actions-col">
                        <button class="btn about-action-btn" @onclick="OpenGitHub" title="Open GitHub Page">
                            <img src="/svg/info-circle-svgrepo-com.svg" class="btn-icon" />
                            <span>GitHub</span>
                        </button>
                        <button class="btn about-action-btn" @onclick="OpenReleases" title="View Release Notes and Changelog">
                            <img src="/svg/files-fill-svgrepo-com.svg" class="btn-icon" />
                            <span>Changelog</span>
                        </button>
                        <button class="btn about-action-btn" @onclick="OpenIssues" title="Report a Bug or Request a Feature">
                            <img src="/svg/error-svgrepo-com.svg" class="btn-icon" />
                            <span>Issues</span>
                        </button>
                    </div>
                </div>
            </div>

            @if (HasUpdate)
            {
                <!-- Update Banner Card -->
                <div class="p-3 about-update-card d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <img src="/svg/rotate-right-svgrepo-com.svg" class="icon-warning flex-shrink-0" style="width: 20px; height: 20px;" />
                            <span class="fw-bold text-white">@(OperatingSystem.IsAndroid() ? "New Android Version Available!" : "New Version Available!")</span>
                        </div>
                        <span class="badge about-update-badge">v@(LatestUpdateVersion)</span>
                    </div>

                    <p class="text-muted small mb-1" style="font-size: 0.8rem; line-height: 1.4;">
                        @(OperatingSystem.IsAndroid() 
                            ? "A new release of VRCGalleryManager is available. Tap below to download the latest APK directly to your device." 
                            : "A new release of VRCGalleryManager is available. Click below to install the update.")
                    </p>

                    @if (OperatingSystem.IsWindows() || OperatingSystem.IsAndroid())
                    {
                        @if (IsUpdating)
                        {
                            <div class="mt-1 d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="spinner-border spinner-border-sm" style="color: var(--accent);" role="status"></span>
                                        <span class="fw-bold small" style="color: var(--accent);">@(OperatingSystem.IsAndroid() ? "Downloading APK..." : "Downloading Update...")</span>
                                    </div>
                                    <span class="text-white small fw-bold">@(UpdateProgressPercentage)%</span>
                                </div>
                                <div class="progress" style="height: 8px; background-color: var(--bg-active);">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(UpdateProgressPercentage)%; background-color: var(--accent);"></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-warning w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2" @onclick="StartUpdate">
                                <img src="/svg/@(OperatingSystem.IsAndroid() ? "download-svgrepo-com.svg" : "rotate-right-svgrepo-com.svg")" class="btn-icon" />
                                <span>@(OperatingSystem.IsAndroid() ? "Install Update (APK)" : "Install Update")</span>
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-warning w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2" @onclick="OpenAndroidUpdate">
                            <img src="/svg/download-svgrepo-com.svg" class="btn-icon" alt="" />
                            <span>Download APK</span>
                        </button>
                    }
                </div>
            }

        </div>
        <!-- Appearance Panel -->
        <div class="panel d-flex flex-column">
            <h4 class="mb-4">Appearance</h4>
            <h5 class="mt-0 mb-3 text-muted fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.8rem;">VRChat Profile</h5>
            <div class="d-flex flex-column panel shadow-none border-0" style="background-color: var(--bg-hover); padding: 0;">
                
                <!-- Display VRChat Profile Backgrounds -->
                <div class="settings-toggle-row p-3 border-bottom" style="border-color: var(--border-color) !important;">
                    <div class="settings-toggle-info">
                        <div class="settings-toggle-icon">
                            <img src="/svg/gallery-wide-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Backgrounds" />
                        </div>
                        <div class="settings-toggle-text">
                            <h6>VRChat Profile Backgrounds</h6>
                            <div class="settings-toggle-desc">Show profile backgrounds</div>
                        </div>
                    </div>
                    <div class="form-check form-switch fs-4 m-0">
                        <input class="form-check-input cursor-pointer" type="checkbox" id="displayVRCProfileBackgrounds" @bind="DisplayVRCProfileBackgrounds">
                    </div>
                </div>

                <!-- Display VRChat Profile Themes -->
                <div class="settings-toggle-row p-3 border-bottom" style="border-color: var(--border-color) !important;">
                    <div class="settings-toggle-info">
                        <div class="settings-toggle-icon">
                            <img src="/svg/color-picker-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Themes" />
                        </div>
                        <div class="settings-toggle-text">
                            <h6>VRChat Profile Themes</h6>
                            <div class="settings-toggle-desc">Show custom theme colors on buttons, icons and text</div>
                        </div>
                    </div>
                    <div class="form-check form-switch fs-4 m-0">
                        <input class="form-check-input cursor-pointer" type="checkbox" id="displayVRCProfileThemes" @bind="DisplayVRCProfileThemes">
                    </div>
                </div>

                <!-- Display VRChat Cosmetics -->
                <div class="settings-toggle-row p-3">
                    <div class="settings-toggle-info">
                        <div class="settings-toggle-icon">
                            <img src="/svg/sticker-smile-square-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Cosmetics" />
                        </div>
                        <div class="settings-toggle-text">
                            <h6>VRChat Profile Cosmetics</h6>
                            <div class="settings-toggle-desc">Show profile effects and icon frames</div>
                        </div>
                    </div>
                    <div class="form-check form-switch fs-4 m-0">
                        <input class="form-check-input cursor-pointer" type="checkbox" id="displayVRCCosmetics" @bind="DisplayVRCCosmetics">
                    </div>
                </div>

            </div>
        </div>

        <!-- System Panel -->
        <div class="panel d-flex flex-column">
            <h4 class="mb-4">System</h4>

                @if (!OperatingSystem.IsAndroid())
                {
                    <h5 class="mt-0 mb-3 text-muted fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.8rem;">Application Behavior</h5>
                    <div class="d-flex flex-column mb-4 panel shadow-none border-0" style="background-color: var(--bg-hover); padding: 0;">
                        
                        <!-- Start with Windows -->
                        <div class="settings-toggle-row p-3 border-bottom" style="border-color: var(--border-color) !important;">
                            <div class="settings-toggle-info">
                                <div class="settings-toggle-icon">
                                    <img src="/svg/windows-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Windows" />
                                </div>
                                <div class="settings-toggle-text">
                                    <h6>Start with Windows</h6>
                                    <div class="settings-toggle-desc">Automatically launch the app when your PC boots</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="startWithWindows" @bind="StartWithWindows">
                            </div>
                        </div>
                        
                        <!-- Start in Background -->
                        <div class="settings-toggle-row p-3 border-bottom" style="border-color: var(--border-color) !important;">
                            <div class="settings-toggle-info">
                                <div class="settings-toggle-icon">
                                    <img src="/svg/shield-minus-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Background" />
                                </div>
                                <div class="settings-toggle-text">
                                    <h6>Start in Background</h6>
                                    <div class="settings-toggle-desc">Launch silently into the system tray without showing the window</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="startInBackground" @bind="StartInBackground" disabled="@(!StartWithWindows)">
                            </div>
                        </div>

                        <!-- Minimize to Tray -->
                        <div class="settings-toggle-row p-3">
                            <div class="settings-toggle-info">
                                <div class="settings-toggle-icon">
                                    <img src="/svg/minimize-square-minimalistic-svgrepo-com.svg" class="icon-accent" style="width: 20px; height: 20px;" alt="Minimize" />
                                </div>
                                <div class="settings-toggle-text">
                                    <h6>Minimize to Tray</h6>
                                    <div class="settings-toggle-desc">Hide to the system tray instead of closing the application</div>
                                </div>
                            </div>
                            <div class="form-check form-switch fs-4 m-0">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="minimizeToTray" @bind="MinimizeToTray">
                            </div>
                        </div>

                    </div>
                }   

                @if (OperatingSystem.IsWindows())
                {
                    <h5 class="mt-4 mb-2 text-muted text-09rem">VRChat Logs Information</h5>
                    @if (VrcLogsExists)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                    <img src="/svg/files-fill-svgrepo-com.svg" class="icon-accent" style="width: 28px; height: 28px;" />
                                    <div class="d-flex flex-column">
                                        <span class="text-muted small text-uppercase fw-bold">Files</span>
                                        <span class="fw-bold fs-5">@VrcLogsFilesCount</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                    <img src="/svg/storage-svgrepo-com.svg" class="icon-success" style="width: 28px; height: 28px;" />
                                    <div class="d-flex flex-column">
                                        <span class="text-muted small text-uppercase fw-bold">Total Size</span>
                                        <span class="fw-bold fs-5">@VrcLogsTotalSize</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 cache-info-box text-warning d-flex align-items-center mb-3">
                            <img src="/svg/error-svgrepo-com.svg" class="icon-danger me-2" style="width: 16px; height: 16px;" /> VRChat logs folder not found.
                        </div>
                    }

                    <div class="d-flex flex-column gap-2 mb-4">
                        <button class="btn text-nowrap w-100" @onclick="OpenVRChatLogs">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open Logs
                        </button>
                        <button class="btn btn-danger text-nowrap w-100" @onclick="ClearVRChatLogs">
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear Logs
                        </button>
                    </div>
                }

                <h5 class="mt-4 mb-2 text-muted text-09rem">Cache Information</h5>
                @if (CacheExists)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                <img src="/svg/files-fill-svgrepo-com.svg" class="icon-accent" style="width: 28px; height: 28px;" />
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Files</span>
                                    <span class="fw-bold fs-5">@CacheFilesCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 cache-info-box h-100 d-flex align-items-center gap-3">
                                <img src="/svg/storage-svgrepo-com.svg" class="icon-success" style="width: 28px; height: 28px;" />
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Total Size</span>
                                    <span class="fw-bold fs-5">@CacheTotalSize</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3 cache-info-box text-warning d-flex align-items-center mb-3">
                        <img src="/svg/error-svgrepo-com.svg" class="icon-danger me-2" style="width: 16px; height: 16px;" /> Cache folder not found.
                    </div>
                }

                <div class="d-flex flex-column gap-2 mb-4">
                    @if (!OperatingSystem.IsAndroid())
                    {
                        <button class="btn text-nowrap w-100" @onclick="OpenCacheFolder">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open Cache
                        </button>
                    }
                    <button class="btn btn-danger text-nowrap w-100" @onclick="ClearCacheFiles">
                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear Cache
                    </button>
                </div>
                
                @if (OperatingSystem.IsWindows())
                {
