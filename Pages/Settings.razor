@page "/settings"
@using VRCGalleryManager.Core
@using System.IO
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using VRChat.API.Model
@inject VRCAuth Auth
@inject IJSRuntime JSRuntime
@inject DialogService dialogService
@inject UpdateManager Updater
@inject NotificationService Notifications

<div class="settings-page container-fluid h-100 p-4 overflow-y-auto">
    <div class="d-flex flex-column gap-4 max-w-600 mx-auto w-100">
        <h3 class="mb-1 text-center">Settings</h3>
        <!-- Login Panel -->
        <div class="panel d-flex flex-column gap-3">
            @if (Show2FA)
            {
                <h4 class="mb-2 text-accent">Two-Factor Authentication</h4>
                <p class="text-muted mb-2 text-09rem">@(IsEmail2FA ? "Enter the code sent to your email." : "Enter the code from your Authenticator app.")</p>
                
                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Auth Code</label>
                    <input type="text" class="form-control" @bind="Code2FA" @onkeydown="On2FAKeyDown" placeholder="123456" />
                </div>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill py-2" @onclick="Cancel2FA" disabled="@IsLoggingIn">Cancel</button>
                    @if (IsEmail2FA)
                    {
                        <button class="btn btn-outline-primary flex-fill py-2" @onclick="Resend2FA" disabled="@IsLoggingIn" title="Resend Email Code">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    }
                    <button class="btn btn-primary flex-fill py-2" @onclick="Submit2FA" disabled="@IsLoggingIn">
                        @if (IsLoggingIn)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Verify
                    </button>
                </div>
                
                @if (!string.IsNullOrEmpty(LoginError))
                {
                    <div class="alert alert-danger mt-2 mb-0 p-3 alert-custom-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @LoginError
                    </div>
                }
            }
            else
            {
                <h4 class="mb-2 @(IsLoggedIn ? "text-accent" : "text-danger")">
                    @(IsLoggedIn ? "Logged In" : "VRChat Login")
                </h4>

                @if (IsLoggedIn && !HasVRCPlus)
                {
                    <div class="alert mb-0 p-3 d-flex align-items-center gap-2 alert-vrcplus">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>You need <strong>VRChat Plus</strong> to use this program.</span>
                    </div>
                }

                <div class="mb-2">
                    <label class="form-label text-muted mb-1">Username</label>
                    <input type="text" class="form-control" @bind="Username" disabled="@IsLoggedIn" @onkeydown="OnUsernameKeyDown" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted mb-1">Password</label>
                    <div class="input-group">
                        <input type="@(ShowPassword ? "text" : "password")" class="form-control password-input" @bind="Password" @bind:event="oninput" disabled="@IsLoggedIn" @onkeydown="OnPasswordKeyDown" />
                        @if (!IsLoggedIn && !string.IsNullOrEmpty(Password))
                        {
                            <button class="btn btn-password-toggle p-2" type="button" @onclick="() => ShowPassword = !ShowPassword" title="@(ShowPassword ? "Hide password" : "Show password")">
                                <img src="/svg/eye-svgrepo-com.svg" class="btn-icon" style="margin-right: 0;" />
                            </button>
                        }
                    </div>
                </div>

                <button class="btn @(IsLoggedIn ? "btn-outline-danger" : "btn-primary") w-100 py-2" @onclick="ToggleLogin" disabled="@IsLoggingIn">
                    @if (IsLoggingIn)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    @(IsLoggedIn ? "Logout" : "Login")
                </button>

                @if (!string.IsNullOrEmpty(LoginError))
                {
                    <div class="alert alert-danger mt-1 mb-0 p-3 alert-custom-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @LoginError
                    </div>
                }
            }
        </div>

        <!-- About Panel -->
        <div class="panel d-flex flex-column gap-3">
            <h4 class="mb-2">About</h4>
                <p class="text-muted mb-0">VRCGalleryManager v2.0</p>
                <button class="btn w-100" @onclick="OpenGitHub">
                    <img src="/svg/info-circle-svgrepo-com.svg" class="btn-icon" />Open GitHub Page
                </button>
                <button class="btn w-100" @onclick="CheckForUpdates">
                    <img src="/svg/rotate-right-svgrepo-com.svg" class="btn-icon" />Check for Updates
                </button>
                @if (!string.IsNullOrEmpty(UpdateMessage))
                {
                    <div class="alert @(HasUpdate ? "alert-info" : "alert-secondary") mb-0 p-2 alert-custom-info">
                        <i class="bi @(HasUpdate ? "bi-arrow-up-circle-fill" : "bi-check-circle-fill") me-2"></i>@UpdateMessage
                    </div>
                }
            </div>
        <!-- System Panel -->
        <div class="panel d-flex flex-column">
            <h4 class="mb-4">System</h4>

                <div class="d-flex flex-column gap-3 mb-4">
                    <button class="btn w-100" @onclick="OpenCacheFolder">
                        <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open Cache Folder
                    </button>

                    @if (OperatingSystem.IsWindows())
                    {
                        <button class="btn w-100" @onclick="OpenVRChatLogs">
                            <img src="/svg/folder-open-svgrepo-com.svg" class="btn-icon" />Open VRChat Logs
                        </button>
                    }

                    <hr class="my-2 hr-custom" />

                    @if (OperatingSystem.IsWindows())
                    {
                        <button class="btn btn-danger w-100" @onclick="ClearVRChatLogs">
                            <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear All VRChat Logs
                        </button>
                    }

                    <button class="btn btn-danger w-100" @onclick="ClearCacheFiles">
                        <img src="/svg/trash-bin-trash-svgrepo-com.svg" class="btn-icon" />Clear All Cache Files
                    </button>
                </div>

                <h5 class="mt-4 mb-3 text-muted fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.8rem;">Application Behavior</h5>
                <div class="d-flex flex-column mb-4 rounded panel border-0" style="background-color: var(--bg-hover); padding: 0;">
                    
                    <!-- Start with Windows -->
                    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color: var(--border-color) !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M22 2L11.2 3.6V11.6H22V2ZM10 3.8L2 5V11.6H10V3.8ZM2 12.4V19L10 20.2V12.4H2ZM11.2 12.4V20.4L22 22V12.4H11.2Z"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-1 text-white fw-bold">Start with Windows</h6>
                                <div class="text-muted" style="font-size: 0.85rem;">Automatically launch the app when your PC boots</div>
                            </div>
                        </div>
                        <div class="form-check form-switch fs-4 m-0">
                            <input class="form-check-input" type="checkbox" id="startWithWindows" @bind="StartWithWindows">
                        </div>
                    </div>
                    
                    <!-- Start in Background -->
                    <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="border-color: var(--border-color) !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-1 text-white fw-bold">Start in Background</h6>
                                <div class="text-muted" style="font-size: 0.85rem;">Launch silently into the system tray without showing the window</div>
                            </div>
                        </div>
                        <div class="form-check form-switch fs-4 m-0">
                            <input class="form-check-input" type="checkbox" id="startInBackground" @bind="StartInBackground" disabled="@(!StartWithWindows)">
                        </div>
                    </div>

                    <!-- Minimize to Tray -->
                    <div class="d-flex align-items-center justify-content-between p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded d-flex align-items-center justify-content-center" style="background-color: var(--bg-active); width: 40px; height: 40px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 3H3v18h18V3zM9 13H5l7-7 7 7h-4v4H9v-4z"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-1 text-white fw-bold">Minimize to Tray</h6>
                                <div class="text-muted" style="font-size: 0.85rem;">Hide to the system tray instead of closing the application</div>
                            </div>
                        </div>
                        <div class="form-check form-switch fs-4 m-0">
                            <input class="form-check-input" type="checkbox" id="minimizeToTray" @bind="MinimizeToTray">
                        </div>
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(SystemMessage))
                {
                    <div class="alert @(SystemMessageIsError ? "alert-danger" : "alert-success") mb-3 p-2 alert-custom-info">
                        <i class="bi @(SystemMessageIsError ? "bi-x-circle-fill" : "bi-check-circle-fill") me-2"></i>@SystemMessage
                    </div>
                }

                <h5 class="mt-4 mb-2 text-muted text-09rem">Cache Information</h5>
                @if (CacheExists)
                {
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-3 rounded cache-info-box h-100 d-flex align-items-center gap-3">
                                <i class="bi bi-files text-primary fs-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Files</span>
                                    <span class="fw-bold fs-5">@CacheFilesCount</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded cache-info-box h-100 d-flex align-items-center gap-3">
                                <i class="bi bi-hdd-fill text-success fs-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="text-muted small text-uppercase fw-bold">Total Size</span>
                                    <span class="fw-bold fs-5">@CacheTotalSize</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-3 rounded cache-info-box text-warning d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Cache folder not found.
                    </div>
                }
            </div>
        </div>
    </div>

@code {
    private string Username = "";
    private string Password = "";
    private string Code2FA = "";
    private string LoginError = "";
    private int CacheFilesCount = 0;
    private string CacheTotalSize = "0 B";
    private bool CacheExists = false;
    private string UpdateMessage = "";
    private string SystemMessage = "";
    private bool SystemMessageIsError = false;
    private bool IsLoggingIn = false;
    private bool HasVRCPlus = false;
    private bool HasUpdate = false;
    private bool ShowPassword = false;
    private bool Show2FA = false;
    private bool IsEmail2FA = false;

    private bool _startWithWindows;
    private bool StartWithWindows
    {
        get => _startWithWindows;
        set { _startWithWindows = value; Config.Set("StartWithWindows", value ? "true" : "false"); WindowsStartupHelper.SetStartup(value); }
    }

    private bool _startInBackground;
    private bool StartInBackground
    {
        get => _startInBackground;
        set { _startInBackground = value; Config.Set("StartInBackground", value ? "true" : "false"); }
    }

    private bool _minimizeToTray;
    private bool MinimizeToTray
    {
        get => _minimizeToTray;
        set { _minimizeToTray = value; Config.Set("MinimizeToTray", value ? "true" : "false"); }
    }

    private bool IsLoggedIn => Auth.LoggedIn || Auth.CookieLoaded;

    protected override async Task OnInitializedAsync()
    {
        _startWithWindows = Config.Get("StartWithWindows", "false") == "true";
        _startInBackground = Config.Get("StartInBackground", "false") == "true";
        _minimizeToTray = Config.Get("MinimizeToTray", "false") == "true";

        UpdateCacheInfo();

        if (Auth.Is2FARequired)
        {
            var creds = Auth.LoadCredentials();
            if (creds != null)
            {
                Username = creds.Value.username;
                Password = creds.Value.password;
            }
            IsEmail2FA = Auth.IsEmail2FA;
            Show2FA = true;
            SystemMessage = "Authentication required. Please enter the new 2FA code.";
            SystemMessageIsError = false;
            return;
        }

        if (IsLoggedIn)
        {
            if (Auth.CurrentUser != null)
            {
                ApplyCurrentUser(Auth.CurrentUser);
            }
            else
            {
                await LoadCurrentUser();
            }
        }
    }

    private void ApplyCurrentUser(CurrentUser user)
    {
        Username = user.DisplayName;
        Password = "password";

        // Check VRChat Plus badge or tag
        HasVRCPlus = false;
        if (user.Badges != null)
        {
            foreach (var badge in user.Badges)
            {
                if (badge.BadgeId == "bdg_754f9935-0f97-49d8-b857-95afb9b673fa")
                {
                    HasVRCPlus = true;
                    break;
                }
            }
        }
        
        if (!HasVRCPlus && user.Tags != null && user.Tags.Contains("system_supporter"))
        {
            HasVRCPlus = true;
        }
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var user = await Auth.AuthApi.GetCurrentUserAsync();
            Auth.CurrentUser = user;
            ApplyCurrentUser(user);
        }
        catch (VRChat.API.Client.ApiException ex) when (ex.ErrorCode == 401)
        {
            var creds = Auth.LoadCredentials();
            if (creds != null)
            {
                Username = creds.Value.username;
                Password = creds.Value.password;
            }
            
            bool success = await Auth.TryAutoReloginAsync();
            if (success)
            {
                var user = await Auth.AuthApi.GetCurrentUserAsync();
                Auth.CurrentUser = user;
                ApplyCurrentUser(user);
                StateHasChanged();
            }
            else if (Auth.Is2FARequired)
            {
                IsEmail2FA = Auth.IsEmail2FA;
                Show2FA = true;
                SystemMessage = "IP changed. Please enter your 2FA code.";
                SystemMessageIsError = false;
                StateHasChanged();
            }
            else
            {
                Auth.Logout(keepCredentials: true);
                SystemMessage = "Session expired and auto-login failed. Please log in again.";
                SystemMessageIsError = true;
                StateHasChanged();
            }
        }
        catch
        {
            Auth.Logout(keepCredentials: true);
            SystemMessage = "Session expired. Please log in again.";
            SystemMessageIsError = true;
            StateHasChanged();
        }
    }

    private async Task ToggleLogin()
    {
        LoginError = "";
        if (IsLoggedIn)
        {
            try { Auth.AuthApi.Logout(); } catch { }
            finally
            {
                Auth.Logout();
                Username = "";
                Password = "";
                HasVRCPlus = false;
                ShowPassword = false;
                Show2FA = false;
                Code2FA = "";
            }
        }
        else
        {
            IsLoggingIn = true;
            StateHasChanged();
            try
            {
                var status = await Auth.LoginAsync(Username, Password);
                if (status == VRCAuthStatus.RequiresEmail2FA)
                {
                    IsEmail2FA = true;
                    Show2FA = true;
                }
                else if (status == VRCAuthStatus.RequiresApp2FA)
                {
                    IsEmail2FA = false;
                    Show2FA = true;
                }
                else if (status == VRCAuthStatus.Success)
                {
                    Auth.SaveCredentials(Username, Password);
                    await LoadCurrentUser();
                }
                else
                {
                    LoginError = "Invalid credentials or connection error.";
                }
            }
            catch (Exception ex)
            {
                LoginError = ex.Message;
            }
            finally
            {
                IsLoggingIn = false;
            }
        }
    }

    private async Task Submit2FA()
    {
        if (string.IsNullOrWhiteSpace(Code2FA)) return;
        
        IsLoggingIn = true;
        LoginError = "";
        StateHasChanged();
        
        try
        {
            var status = await Auth.Verify2FAAsync(Code2FA, IsEmail2FA);
            if (status == VRCAuthStatus.Success)
            {
                Auth.SaveCredentials(Username, Password);
                Show2FA = false;
                Code2FA = "";
                Password = "";
                await LoadCurrentUser();
            }
            else
            {
                LoginError = "Invalid 2FA code.";
            }
        }
        catch (Exception ex)
        {
            LoginError = ex.Message;
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private void Cancel2FA()
    {
        Show2FA = false;
        Code2FA = "";
        LoginError = "";
    }

    private async Task Resend2FA()
    {
        IsLoggingIn = true;
        LoginError = "";
        StateHasChanged();
        
        try
        {
            // Clear temporary headers so VRChat treats this as a fresh login request (and thus sends a new code)
            Auth.Config.ApiKey.Clear();
            Auth.Config.DefaultHeaders.Clear();
            Auth.ApiClient = new VRChat.API.Client.ApiClient(Auth.Config.BasePath);
            Auth.AuthApi = new VRChat.API.Api.AuthenticationApi(Auth.ApiClient, Auth.ApiClient, Auth.Config);

            var status = await Auth.LoginAsync(Username, Password);
            if (status == VRCAuthStatus.RequiresEmail2FA)
            {
                // Just notify that a new code has been sent
                Notifications.Show("New code sent to your email!", "2FA", VRCGalleryManager.Core.NotificationType.Success);
            }
            else if (status == VRCAuthStatus.Success)
            {
                // Somehow they logged in without 2FA (e.g. they turned it off in the meantime)
                Auth.SaveCredentials(Username, Password);
                Show2FA = false;
                Code2FA = "";
                Password = "";
                await LoadCurrentUser();
            }
            else
            {
                LoginError = "Unexpected status when resending code.";
            }
        }
        catch (Exception ex)
        {
            LoginError = ex.Message;
        }
        finally
        {
            IsLoggingIn = false;
        }
    }

    private async Task On2FAKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit2FA();
    }

    private async Task OnUsernameKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (!IsLoggedIn && e.Key == "Enter") await ToggleLogin();
    }

    private async Task OpenGitHub()
    {
        await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri("https://github.com/TheIceDragonz/VRCGalleryManager"));
    }

    private async Task CheckForUpdates()
    {
        UpdateMessage = "Checking for updates...";
        HasUpdate = false;
        StateHasChanged();
        
        try
        {
            await Updater.CheckForUpdatesAsync(Notifications, dialogService, (progressText, isError) => 
            {
                UpdateMessage = progressText;
                HasUpdate = !isError;
                InvokeAsync(StateHasChanged);
            });
            
            // Wait for it to finish or if it didn't update we clear the loading message
            if (UpdateMessage == "Checking for updates...")
            {
                UpdateMessage = "";
            }
        }
        catch (Exception ex)
        {
            UpdateMessage = $"Update check failed: {ex.Message}";
        }
    }

    private void OpenCacheFolder()
    {
        if (!OperatingSystem.IsWindows())
        {
            ShowSystemMessage("Opening folders is only supported on Windows.", true);
            return;
        }

        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (Directory.Exists(cacheFolderPath))
            System.Diagnostics.Process.Start("explorer.exe", cacheFolderPath);
        else
            ShowSystemMessage("Cache folder does not exist.", true);
    }

    private void OpenVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");
        if (Directory.Exists(vrchatLogPath))
            System.Diagnostics.Process.Start("explorer.exe", vrchatLogPath);
        else
            ShowSystemMessage("VRChat logs folder does not exist.", true);
    }

    private async Task ClearVRChatLogs()
    {
        string vrchatLogPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData).Replace("Local", "LocalLow"),
            "VRChat", "VRChat");

        string[] logFiles = Directory.Exists(vrchatLogPath)
            ? Directory.GetFiles(vrchatLogPath, "output_log_*.txt")
            : Array.Empty<string>();

        if (logFiles.Length == 0)
        {
            ShowSystemMessage("No log files found.", true);
            return;
        }

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Do you want to delete {logFiles.Length} VRChat log file(s)?");
        if (confirmed)
        {
            foreach (var file in logFiles)
                try { System.IO.File.Delete(file); } catch { }
            ShowSystemMessage("All VRChat logs have been successfully deleted!", false);
        }
    }

    private async Task ClearCacheFiles()
    {
        string cacheFolderPath = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");

        if (!Directory.Exists(cacheFolderPath))
        {
            ShowSystemMessage("Cache folder does not exist.", true);
            return;
        }

        string[] cacheFiles = Directory.GetFiles(cacheFolderPath);
        if (cacheFiles.Length == 0)
        {
            ShowSystemMessage("No cache files found.", true);
            return;
        }

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Do you want to delete all cache files?");
        if (confirmed)
        {
            foreach (var file in cacheFiles)
                try { System.IO.File.Delete(file); } catch { }
            ShowSystemMessage("All cache files have been successfully deleted!", false);
            UpdateCacheInfo();
        }
    }

    private void ShowSystemMessage(string message, bool isError)
    {
        SystemMessage = message;
        SystemMessageIsError = isError;
        StateHasChanged();
    }

    private void UpdateCacheInfo()
    {
        string cacheFolder = Path.Combine(Path.GetTempPath(), "VRCGalleryManager");
        if (!Directory.Exists(cacheFolder))
        {
            try { Directory.CreateDirectory(cacheFolder); } catch { }
        }
        
        CacheExists = Directory.Exists(cacheFolder);
        if (!CacheExists) return;
        
        CacheExists = true;
        string[] files = Directory.GetFiles(cacheFolder);
        CacheFilesCount = files.Length;
        long totalSize = files.Sum(file => new FileInfo(file).Length);

        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = totalSize;
        int unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }

        CacheTotalSize = $"{size:0.##} {units[unitIndex]}";
    }
}
