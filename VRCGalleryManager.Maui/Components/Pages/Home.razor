@page "/"
@using VRCGalleryManager.Core
@inject VRCAuth Auth
@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        if (Auth.LoggedIn || Auth.CookieLoaded)
        {
            NavigationManager.NavigateTo("/settings");
        }
        else
        {
            NavigationManager.NavigateTo("/settings");
        }
    }
}
