@using VRCGalleryManager.Core
@inject NotificationService NotificationService
@implements IDisposable

@if (NotificationService.Notifications.Count > 0)
{
    <div class="toast-container">
        @foreach (var item in NotificationService.Notifications.ToList())
        {
            <div class="toast-item toast-@item.Type.ToString().ToLower() @(item.IsLeaving ? "toast-leaving" : "toast-entering")"
                 @key="item.Id">
                <div class="toast-header">
                    <span class="toast-icon">
                        @switch (item.Type)
                        {
                            case NotificationType.Success:
                                <i class="bi bi-check-circle-fill"></i>
                                break;
                            case NotificationType.Error:
                                <i class="bi bi-x-circle-fill"></i>
                                break;
                            case NotificationType.Info:
                            default:
                                <i class="bi bi-info-circle-fill"></i>
                                break;
                        }
                    </span>
                    <span class="toast-title">@item.Title</span>
                    <button class="toast-close" @onclick="() => Dismiss(item)">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(item.Message))
                {
                    <div class="toast-message">@item.Message</div>
                }
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        NotificationService.OnChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Dismiss(NotificationItem item)
    {
        _ = NotificationService.BeginDismiss(item);
    }

    public void Dispose()
    {
        NotificationService.OnChanged -= OnNotificationsChanged;
    }
}
